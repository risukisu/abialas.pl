---
export interface Props {
  message: string;
}
const { message } = Astro.props;
---
<div class="ribbon">
  <div class="container ribbon__inner">
    <span class="ribbon__dot" aria-hidden="true"></span>
    <span class="meta">{message}</span>
  </div>
</div>

<style>
  .ribbon {
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
    padding: 16px 0;
  }
  .ribbon__inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ribbon__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cobalt);
    flex-shrink: 0;
  }
</style>
