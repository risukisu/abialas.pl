---
/**
 * PillarSchematic — the signature interaction of the /system product page.
 *
 * "The Drafting Table": a precise engineering diagram of the Marketing
 * Operating System. Three pillars wired to a central core. Ink-on-mist and
 * fully readable at rest; on hover / keyboard-focus / tap a pillar lights and
 * vermilion connector lines *draw in* (SVG stroke-dashoffset) like a draftsman
 * connecting nodes.
 *
 * Ground truth: the three pillars and their lines are drawn from the essay
 * src/content/writing/marketing-operating-system.md — Brand (the fuel),
 * Market Sensing (the radar), Lead Generation (the engine). Not invented.
 *
 * Progressive enhancement:
 *  - Server-rendered HTML stands alone; no content is hidden behind JS.
 *  - The <script> only toggles state classes; all drawing lives in CSS.
 *  - Connectors are positioned in the same 0–100 percentage space as the
 *    pillar plates (preserveAspectRatio="none"), so endpoints can never drift
 *    from the nodes; vector-effect:non-scaling-stroke keeps the hairline crisp
 *    under the non-uniform viewBox scale. No DOM measurement, no layout shift.
 */

interface Pillar {
  key: string;
  index: string; // mono coordinate label, e.g. "P1 / BRAND"
  name: string; // display name (Newsreader)
  role: string; // the essay's one-word role, e.g. "the fuel"
  line: string; // faithful one-line description from the essay
}

const pillars: Pillar[] = [
  {
    key: "brand",
    index: "P1 / BRAND",
    name: "Brand",
    role: "the fuel",
    line: "Everything that makes inbound possible — how you exist in the minds of the 95% of the market that isn't buying yet.",
  },
  {
    key: "sensing",
    index: "P2 / MARKET SENSING",
    name: "Market Sensing",
    role: "the radar",
    line: "Your feedback loop with reality — whether your positioning resonates and whether the market is shifting under your feet.",
  },
  {
    key: "leadgen",
    index: "P3 / LEAD GENERATION",
    name: "Lead Generation",
    role: "the engine",
    line: "Where it all converts — the function aimed at the 5% of the market that is actually in-market right now.",
  },
];
---

<figure class="schematic blueprint" aria-label="Schematic of the Marketing Operating System and its three pillars">
  <figcaption class="legend">
    <span class="measure legend-id">FIG. 01</span>
    <span class="legend-title">The three-pillar operating system</span>
  </figcaption>

  <div class="board">
    {/* Connector layer — decorative; the diagram's meaning is in the HTML below. */}
    <svg
      class="wires"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      {/* Orthogonal leader lines: each runs from the central core out to its
          pillar with a right-angle elbow — drafting leaders, not curves.
          Endpoints are in the same 0–100 percentage space as the grid plates,
          targeting each plate's connection node (top plates sit above the core,
          so leaders rise to ~y38; the bottom plate sits below, leader drops to
          ~y62). Deliberate overlap past the node tick keeps the join clean even
          as content-driven row heights shift the plates a little. */}
      <path class="wire wire-brand"   d="M 50 50 H 17 V 38" />
      <path class="wire wire-sensing" d="M 50 50 H 83 V 38" />
      <path class="wire wire-leadgen" d="M 50 50 V 62" />
    </svg>

    {/* Central core node — the operating system itself. */}
    <div class="core" aria-hidden="true">
      <span class="core-mark measure">SYS</span>
      <span class="core-dot"></span>
    </div>

    {/* Pillars — declarative, keyboard-reachable, readable without JS. */}
    {
      pillars.map((p) => (
        <article
          class:list={["pillar", `pillar-${p.key}`]}
          data-pillar={p.key}
          tabindex="0"
          aria-label={`${p.name} pillar — ${p.role}`}
        >
          <span class="node" aria-hidden="true" />
          <span class="measure idx">{p.index}</span>
          <h3 class="name">
            {p.name}
            <span class="role">— {p.role}</span>
          </h3>
          <p class="line">{p.line}</p>
        </article>
      ))
    }
  </div>
</figure>

<script>
  // Progressive enhancement only: toggle state classes. CSS does the drawing.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const root = document.querySelector<HTMLElement>(".schematic");

  if (root) {
    if (reduce) root.classList.add("no-draw");

    root.querySelectorAll<HTMLElement>("[data-pillar]").forEach((el) => {
      const key = el.dataset.pillar;
      if (!key) return;

      const on = () => root.classList.add("is-active", `active-${key}`);
      const off = () => root.classList.remove("is-active", `active-${key}`);

      // Pointer covers mouse + touch (tap fires pointerenter on touch).
      el.addEventListener("pointerenter", on);
      el.addEventListener("pointerleave", off);
      // Keyboard focus lights the pillar and draws its connector.
      el.addEventListener("focusin", on);
      el.addEventListener("focusout", off);
    });
  }
</script>

<style>
  /* ── Board ────────────────────────────────────────────────────────────────
     Faint blueprint grid (from .blueprint utility) with hairline registration
     marks. Calm ink-on-mist at rest; vermilion appears only on interaction. */

  .schematic {
    margin: 0;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
  }

  .legend {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 14px 22px;
    border-bottom: 1px solid var(--color-line);
  }
  .legend-title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--color-ink);
  }

  /* The board is a 3-column / 2-row grid. Pillars sit top-left, top-right and
     bottom-center; the core sits dead-centre. These track positions line up
     (in percentage terms) with the SVG path endpoints below — no JS geometry. */
  .board {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 28px 36px;
    align-items: start;
    padding: clamp(28px, 5vw, 56px) clamp(22px, 4vw, 44px) clamp(40px, 6vw, 64px);
    /* registration tick-marks in the corners reinforce the drafting feel */
    background-image:
      linear-gradient(var(--color-line-2) 1px, transparent 0),
      linear-gradient(90deg, var(--color-line-2) 1px, transparent 0),
      linear-gradient(var(--color-line-2) 1px, transparent 0),
      linear-gradient(90deg, var(--color-line-2) 1px, transparent 0);
    background-repeat: no-repeat;
    background-size:
      10px 1px, 1px 10px,
      10px 1px, 1px 10px;
    background-position:
      14px 14px, 14px 14px,
      calc(100% - 14px) calc(100% - 14px), calc(100% - 14px) calc(100% - 14px);
  }

  /* ── Connector layer ──────────────────────────────────────────────────────
     viewBox 0 0 100 100 + preserveAspectRatio:none → endpoints expressed as
     percentages that track the grid plates exactly. non-scaling-stroke keeps
     the 2px hairline constant under the non-uniform scale, and the right-angle
     elbows stay crisp. The layer is decorative and sits *behind* the plates. */
  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    z-index: 0;
  }

  .wire {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: square;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
    /* Hidden at rest: fully dashed, offset out of view. Each path gets its own
       length so the draw timing is even per leader. */
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
    opacity: 0;
    /* --draw scales the duration to the leader's length so every line is laid
       down at roughly the same draftsman's pace, long or short. */
    transition:
      stroke-dashoffset var(--draw, 0.5s) cubic-bezier(0.3, 0.8, 0.3, 1),
      opacity 0.18s ease;
  }
  /* Path lengths in the 0–100 user space (sum of |segments|), so the dash
     covers the whole leader exactly: brand/sensing = |50-17| + |50-38| = 45;
     leadgen = |62-50| = 12. dasharray == dashoffset hides it; offset→0 draws. */
  .wire-brand,
  .wire-sensing {
    --len: 45;
    --draw: 0.5s;
  }
  .wire-leadgen {
    --len: 12;
    --draw: 0.22s;
  }

  /* Active pillar → its leader draws in (offset → 0) and becomes visible. */
  .schematic.active-brand .wire-brand,
  .schematic.active-sensing .wire-sensing,
  .schematic.active-leadgen .wire-leadgen {
    opacity: 1;
    stroke-dashoffset: 0;
  }

  /* ── Central core node ─────────────────────────────────────────────────────
     Sits dead-centre of the board (row 2 spans under the top pillars). */
  .core {
    grid-column: 2;
    grid-row: 1 / 3;
    place-self: center;
    position: relative;
    z-index: 1;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--color-bg);
    border: 1px solid var(--color-line-2);
  }
  .core-mark {
    color: var(--color-ink);
  }
  .core-dot {
    width: 7px;
    height: 7px;
    background: var(--color-ink);
    transition: background 0.25s ease;
  }
  /* When any pillar is active, the core's dot warms — the hub is "live". */
  .schematic.is-active .core-dot {
    background: var(--color-accent);
  }

  /* ── Pillar plates ─────────────────────────────────────────────────────────
     Readable, quiet plates. Hover / focus / tap (state class) and :focus-within
     all light the plate. Vermilion is reserved for the node + leader. */
  .pillar {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    outline-offset: 4px; /* lets global :focus-visible ring sit clear */
    transition:
      border-color 0.28s cubic-bezier(0.3, 0.8, 0.3, 1),
      box-shadow 0.28s cubic-bezier(0.3, 0.8, 0.3, 1);
  }
  .pillar-brand {
    grid-column: 1;
    grid-row: 1;
  }
  .pillar-sensing {
    grid-column: 3;
    grid-row: 1;
  }
  .pillar-leadgen {
    grid-column: 2;
    grid-row: 2;
  }

  /* Connection node — the point a leader meets the plate. Square draftsman tick;
     ink at rest, vermilion when the plate is live. */
  .node {
    position: absolute;
    width: 9px;
    height: 9px;
    background: var(--color-bg);
    border: 2px solid var(--color-line-2);
    transition:
      border-color 0.25s ease,
      background 0.25s ease;
  }
  /* Node anchored toward the core for each plate (matches the leader endpoint). */
  .pillar-brand .node {
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%);
  }
  .pillar-sensing .node {
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%);
  }
  .pillar-leadgen .node {
    top: -5px;
    left: 50%;
    transform: translateX(-50%);
  }

  .idx {
    color: var(--color-muted);
  }
  .name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.45rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }
  .role {
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-muted);
  }
  .line {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-body);
    max-width: 34ch;
    margin: 0;
  }

  /* Lit state — driven by hover, :focus-within, and the JS state classes so all
     three input modes (mouse / keyboard / touch) light the plate identically. */
  .pillar:hover,
  .pillar:focus-within,
  .schematic.active-brand .pillar-brand,
  .schematic.active-sensing .pillar-sensing,
  .schematic.active-leadgen .pillar-leadgen {
    border-color: var(--color-line-2);
    box-shadow: inset 0 0 0 1px var(--color-line-2);
  }
  .pillar:hover .node,
  .pillar:focus-within .node,
  .schematic.active-brand .pillar-brand .node,
  .schematic.active-sensing .pillar-sensing .node,
  .schematic.active-leadgen .pillar-leadgen .node {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* ── Responsive ────────────────────────────────────────────────────────────
     Below the fold of a comfortable two-up, collapse to a single column. The
     core and the angled leaders stop earning their keep at narrow widths, so we
     stack the plates with short vertical leaders between them instead. */
  @media (max-width: 720px) {
    .board {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 22px;
    }
    .pillar-brand,
    .pillar-sensing,
    .pillar-leadgen,
    .core {
      grid-column: 1;
      grid-row: auto;
    }
    .core {
      order: -1; /* core reads first, then the three pillars below it */
      place-self: start;
    }
    /* Re-route the leaders as straight vertical drops down the stacked column.
       Endpoints still match the plate nodes (all centred, x≈50). */
    .wire-brand {
      d: path("M 50 16 V 40");
      --len: 24;
    }
    .wire-sensing {
      d: path("M 50 46 V 70");
      --len: 24;
    }
    .wire-leadgen {
      d: path("M 50 76 V 100");
      --len: 24;
    }
    .pillar-brand .node,
    .pillar-sensing .node {
      bottom: -5px;
      top: auto;
    }
    .pillar-leadgen .node {
      top: -5px;
      bottom: auto;
    }
  }

  /* Browsers without CSS `d:` support keep the server-rendered geometry; the
     plates remain readable and the highlight still works, so this is safe. */

  /* ── Reduced motion ────────────────────────────────────────────────────────
     Two belts-and-braces: the global reduce rule clamps transition durations,
     and the script adds .no-draw. Here we make connectors appear *instantly* at
     their final state (no dashoffset draw, no transition) while the highlight
     (color / opacity) still functions. Nothing animates position. */
  .schematic.no-draw .wire {
    transition: none;
    stroke-dasharray: none;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .wire {
      transition: none;
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
    .core-dot,
    .node,
    .pillar {
      transition: none;
    }
  }
</style>
