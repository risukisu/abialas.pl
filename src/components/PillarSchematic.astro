---
/**
 * PillarSchematic — the signature interaction of the /system product page.
 *
 * "The Drafting Table": a precise engineering diagram of the three-pillar
 * marketing model. Three pillars wired to a central core. Ink-on-mist and
 * fully readable at rest; on hover / keyboard-focus / tap a pillar lights and
 * vermilion connector lines *draw in* (SVG stroke-dashoffset) like a draftsman
 * connecting nodes.
 *
 * Ground truth: the three pillars and their lines are drawn from the essay
 * src/content/writing/how-i-run-marketing.md — Brand (the fuel),
 * Market Sensing (the radar), Lead Generation (the engine). Not invented.
 *
 * Progressive enhancement:
 *  - Server-rendered HTML stands alone; no content is hidden behind JS.
 *  - The <script> only toggles state classes; all drawing lives in CSS.
 *  - Connectors are positioned in the same 0–100 percentage space as the
 *    pillar plates (preserveAspectRatio="none"), so endpoints can never drift
 *    from the nodes; vector-effect:non-scaling-stroke keeps the hairline crisp
 *    under the non-uniform viewBox scale. No DOM measurement, no layout shift.
 */

interface Pillar {
  key: string;
  index: string; // mono coordinate label, e.g. "P1 / BRAND"
  name: string; // display name (Newsreader)
  role: string; // the essay's one-word role, e.g. "the fuel"
  line: string; // faithful one-line description from the essay
}

const pillars: Pillar[] = [
  {
    key: "brand",
    index: "P1 / BRAND",
    name: "Brand",
    role: "the fuel",
    line: "Everything that makes inbound possible — how you exist in the minds of the 95% of the market that isn't buying yet.",
  },
  {
    key: "sensing",
    index: "P2 / MARKET SENSING",
    name: "Market Sensing",
    role: "the radar",
    line: "Your feedback loop with reality — whether your positioning resonates and whether the market is shifting under your feet.",
  },
  {
    key: "leadgen",
    index: "P3 / LEAD GENERATION",
    name: "Lead Generation",
    role: "the engine",
    line: "Where it all converts — the function aimed at the 5% of the market that is actually in-market right now.",
  },
];
---

<figure class="schematic blueprint" aria-label="Schematic of the three-pillar marketing model and its connections">
  <figcaption class="legend">
    <span class="measure legend-id">FIG. 01</span>
    <span class="legend-title">The three-pillar model</span>
  </figcaption>

  <div class="board">
    {/* Connector layer — decorative; the diagram's meaning is in the HTML below.
        The viewBox + path `d` are set by the progressive-enhancement script from
        measured node/core positions, so the leaders land on the real plates at
        any width. Without JS the paths have no `d` and simply don't draw — the
        plates stay fully readable. */}
    <svg
      class="wires"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      {/* Orthogonal leader lines: each runs from the central core out to its
          pillar's connection node with right-angle elbows — drafting leaders,
          not curves. The `d` is computed at runtime (see drawWires below). */}
      <path class="wire wire-brand" />
      <path class="wire wire-sensing" />
      <path class="wire wire-leadgen" />
    </svg>

    {/* Central core node — the system itself. */}
    <div class="core" aria-hidden="true">
      <span class="core-mark measure">SYS</span>
      <span class="core-dot"></span>
    </div>

    {/* Pillars — declarative, keyboard-reachable, readable without JS. */}
    {
      pillars.map((p) => (
        <article
          class:list={["pillar", `pillar-${p.key}`]}
          data-pillar={p.key}
          tabindex="0"
          aria-label={`${p.name} pillar — ${p.role}`}
        >
          <span class="node" aria-hidden="true" />
          <span class="measure idx">{p.index}</span>
          <h3 class="name">
            {p.name}
            <span class="role">— {p.role}</span>
          </h3>
          <p class="line">{p.line}</p>
        </article>
      ))
    }
  </div>
</figure>

<script>
  // Progressive enhancement: toggle state classes AND draw the connector
  // geometry from the real layout. The leaders are computed from measured
  // node/core positions (relative to the board) so they land on the plates at
  // any width — then animated purely by CSS via stroke-dashoffset.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const root = document.querySelector<HTMLElement>(".schematic");

  if (root) {
    if (reduce) root.classList.add("no-draw");

    // ── State toggling (mouse / touch / keyboard) ──────────────────────────
    root.querySelectorAll<HTMLElement>("[data-pillar]").forEach((el) => {
      const key = el.dataset.pillar;
      if (!key) return;

      const on = () => root.classList.add("is-active", `active-${key}`);
      const off = () => root.classList.remove("is-active", `active-${key}`);

      // Pointer covers mouse + touch (tap fires pointerenter on touch).
      el.addEventListener("pointerenter", on);
      el.addEventListener("pointerleave", off);
      // Keyboard focus lights the pillar and draws its connector.
      el.addEventListener("focusin", on);
      el.addEventListener("focusout", off);
    });

    // ── Connector geometry ─────────────────────────────────────────────────
    const board = root.querySelector<HTMLElement>(".board");
    const svg = root.querySelector<SVGSVGElement>(".wires");
    const core = root.querySelector<HTMLElement>(".core");

    // Centre of an element's box, in coordinates relative to the board's box.
    const centreRelTo = (el: Element, base: DOMRect) => {
      const r = el.getBoundingClientRect();
      return {
        x: r.left - base.left + r.width / 2,
        y: r.top - base.top + r.height / 2,
      };
    };

    function drawWires() {
      if (!board || !svg || !core) return;

      const boardRect = board.getBoundingClientRect();
      if (boardRect.width === 0 || boardRect.height === 0) return;

      // Match the SVG user space to the board's pixel box so 1 unit = 1px.
      svg.setAttribute("viewBox", `0 0 ${boardRect.width} ${boardRect.height}`);

      const c = centreRelTo(core, boardRect);

      for (const key of ["brand", "sensing", "leadgen"] as const) {
        const pillar = root!.querySelector(`.pillar-${key}`);
        const node = pillar?.querySelector(".node");
        const path = svg.querySelector<SVGPathElement>(`.wire-${key}`);
        if (!pillar || !node || !path) continue;

        const n = centreRelTo(node, boardRect);

        // Orthogonal drafting leader from the core out to the node.
        //  - leadgen sits directly under the core → a clean vertical drop.
        //  - brand / sensing sit off to the side and above → an L-elbow:
        //    run horizontally from the core to the node's x, then vertically
        //    up to the node's y. The right-angle elbow lands square on the tick.
        let d: string;
        if (Math.abs(n.x - c.x) < 1) {
          d = `M ${c.x} ${c.y} V ${n.y}`;
        } else {
          d = `M ${c.x} ${c.y} H ${n.x} V ${n.y}`;
        }
        path.setAttribute("d", d);

        // Length-driven dash: hidden at rest (offset == length). The active
        // state pulls the offset to 0 (CSS) to draw it in.
        const len = path.getTotalLength();
        path.style.strokeDasharray = String(len);
        // .no-draw shows wires instantly; otherwise hide until activated.
        path.style.strokeDashoffset = root!.classList.contains("no-draw")
          ? "0"
          : String(len);
      }
    }

    // Initial draw — after first paint so layout (incl. fonts) has settled.
    requestAnimationFrame(() => requestAnimationFrame(drawWires));
    // Redraw on web-font load (changes plate heights → node positions).
    if ((document as any).fonts?.ready) {
      (document as any).fonts.ready.then(() => drawWires());
    }

    // Keep correct on resize (debounced).
    let t: number | undefined;
    window.addEventListener("resize", () => {
      if (t) window.clearTimeout(t);
      t = window.setTimeout(drawWires, 120);
    });
  }
</script>

<style>
  /* ── Board ────────────────────────────────────────────────────────────────
     Faint blueprint grid (from .blueprint utility) with hairline registration
     marks. Calm ink-on-mist at rest; vermilion appears only on interaction. */

  .schematic {
    margin: 0;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
  }

  .legend {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 14px 22px;
    border-bottom: 1px solid var(--color-line);
  }
  .legend-title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--color-ink);
  }

  /* The board is a 3-column / 3-row grid:
       row 1 — the two top plates (brand left, sensing right)
       row 2 — the central core, alone in its own band (the hub)
       row 3 — the leadgen plate, centred under the core
     The core having its own row keeps it clear of both the top plates and
     leadgen at any content height, so every measured leader has open space to
     run through. The script derives the exact endpoints from the live layout. */
  .board {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-template-rows: auto auto auto;
    gap: 28px 36px;
    align-items: start;
    padding: clamp(28px, 5vw, 56px) clamp(22px, 4vw, 44px) clamp(40px, 6vw, 64px);
    /* registration tick-marks in the corners reinforce the drafting feel */
    background-image:
      linear-gradient(var(--color-line-2) 1px, transparent 0),
      linear-gradient(90deg, var(--color-line-2) 1px, transparent 0),
      linear-gradient(var(--color-line-2) 1px, transparent 0),
      linear-gradient(90deg, var(--color-line-2) 1px, transparent 0);
    background-repeat: no-repeat;
    background-size:
      10px 1px, 1px 10px,
      10px 1px, 1px 10px;
    background-position:
      14px 14px, 14px 14px,
      calc(100% - 14px) calc(100% - 14px), calc(100% - 14px) calc(100% - 14px);
  }

  /* ── Connector layer ──────────────────────────────────────────────────────
     The SVG user space is set at runtime to the board's pixel box (1 unit =
     1px) and each leader's `d` is computed from measured node/core positions,
     so endpoints land on the real plates at any width. non-scaling-stroke keeps
     the 2px hairline constant. The layer is decorative and sits *behind* the
     plates. */
  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    z-index: 0;
  }

  .wire {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: square;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
    /* Hidden at rest. The script sets stroke-dasharray + stroke-dashoffset
       inline (== the measured path length) so the leader is fully retracted;
       the active rule below pulls the offset to 0 to draw it in. */
    opacity: 0;
    /* --draw keeps each leader laid down at roughly the same draftsman's pace,
       long or short. */
    transition:
      stroke-dashoffset var(--draw, 0.5s) cubic-bezier(0.3, 0.8, 0.3, 1),
      opacity 0.18s ease;
  }
  .wire-brand,
  .wire-sensing {
    --draw: 0.5s;
  }
  .wire-leadgen {
    --draw: 0.22s;
  }

  /* Active pillar → its leader draws in (offset → 0) and becomes visible.
     !important beats the inline stroke-dashoffset the script sets at rest. */
  .schematic.active-brand .wire-brand,
  .schematic.active-sensing .wire-sensing,
  .schematic.active-leadgen .wire-leadgen {
    opacity: 1;
    stroke-dashoffset: 0 !important;
  }

  /* ── Central core node ─────────────────────────────────────────────────────
     The hub. Sits alone in the middle row (row 2), centred in column 2 between
     the two top plates and above leadgen — a clean band the leaders fan out of. */
  .core {
    grid-column: 2;
    grid-row: 2;
    place-self: center;
    position: relative;
    z-index: 1;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--color-bg);
    border: 1px solid var(--color-line-2);
  }
  .core-mark {
    color: var(--color-ink);
  }
  .core-dot {
    width: 7px;
    height: 7px;
    background: var(--color-ink);
    transition: background 0.25s ease;
  }
  /* When any pillar is active, the core's dot warms — the hub is "live". */
  .schematic.is-active .core-dot {
    background: var(--color-accent);
  }

  /* ── Pillar plates ─────────────────────────────────────────────────────────
     Readable, quiet plates. Hover / focus / tap (state class) and :focus-within
     all light the plate. Vermilion is reserved for the node + leader. */
  .pillar {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    outline-offset: 4px; /* lets global :focus-visible ring sit clear */
    transition:
      border-color 0.28s cubic-bezier(0.3, 0.8, 0.3, 1),
      box-shadow 0.28s cubic-bezier(0.3, 0.8, 0.3, 1);
  }
  .pillar-brand {
    grid-column: 1;
    grid-row: 1;
  }
  .pillar-sensing {
    grid-column: 3;
    grid-row: 1;
  }
  .pillar-leadgen {
    grid-column: 2;
    grid-row: 3;
  }

  /* Connection node — the point a leader meets the plate. Square draftsman tick;
     ink at rest, vermilion when the plate is live. */
  .node {
    position: absolute;
    width: 9px;
    height: 9px;
    background: var(--color-bg);
    border: 2px solid var(--color-line-2);
    transition:
      border-color 0.25s ease,
      background 0.25s ease;
  }
  /* Node anchored toward the core for each plate (matches the leader endpoint). */
  .pillar-brand .node {
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%);
  }
  .pillar-sensing .node {
    bottom: -5px;
    left: 50%;
    transform: translateX(-50%);
  }
  .pillar-leadgen .node {
    top: -5px;
    left: 50%;
    transform: translateX(-50%);
  }

  .idx {
    color: var(--color-muted);
  }
  .name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.45rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }
  .role {
    font-style: italic;
    font-size: 1.05rem;
    color: var(--color-muted);
  }
  .line {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-body);
    max-width: 34ch;
    margin: 0;
  }

  /* Lit state — driven by hover, :focus-within, and the JS state classes so all
     three input modes (mouse / keyboard / touch) light the plate identically. */
  .pillar:hover,
  .pillar:focus-within,
  .schematic.active-brand .pillar-brand,
  .schematic.active-sensing .pillar-sensing,
  .schematic.active-leadgen .pillar-leadgen {
    border-color: var(--color-line-2);
    box-shadow: inset 0 0 0 1px var(--color-line-2);
  }
  .pillar:hover .node,
  .pillar:focus-within .node,
  .schematic.active-brand .pillar-brand .node,
  .schematic.active-sensing .pillar-sensing .node,
  .schematic.active-leadgen .pillar-leadgen .node {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* ── Responsive ────────────────────────────────────────────────────────────
     Below the fold of a comfortable two-up, collapse to a single column with
     the core reading first. The leaders need no manual re-routing here: the
     script re-measures the stacked layout (core above, plates below, all
     centred) and redraws the geometry to match on resize. */
  @media (max-width: 720px) {
    .board {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 22px;
    }
    .pillar-brand,
    .pillar-sensing,
    .pillar-leadgen,
    .core {
      grid-column: 1;
      grid-row: auto;
    }
    .core {
      order: -1; /* core reads first, then the three pillars below it */
      place-self: start center; /* centred over the stacked column */
    }
    .pillar-brand .node,
    .pillar-sensing .node {
      bottom: -5px;
      top: auto;
    }
    .pillar-leadgen .node {
      top: -5px;
      bottom: auto;
    }
  }

  /* ── Reduced motion ────────────────────────────────────────────────────────
     Two belts-and-braces: the global reduce rule clamps transition durations,
     and the script adds .no-draw. Here we make connectors appear *instantly* at
     their final state (no dashoffset draw, no transition) while the highlight
     (color / opacity) still functions. Nothing animates position. */
  .schematic.no-draw .wire {
    transition: none;
    stroke-dasharray: none;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .wire {
      transition: none;
      stroke-dasharray: none;
      stroke-dashoffset: 0;
    }
    .core-dot,
    .node,
    .pillar {
      transition: none;
    }
  }
</style>
