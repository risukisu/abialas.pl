---
export interface Props {
  gradient?: [string, string];
  intensity?: number; /* 0-1 */
}
const { gradient = ["#1E4DD8", "#22D3EE"], intensity = 0.4 } = Astro.props;
const [c1, c2] = gradient;
---
<div class="halo" style={`--c1: ${c1}; --c2: ${c2}; --opacity: ${intensity};`}>
  <slot />
</div>

<style>
  .halo {
    position: relative;
    isolation: isolate;
  }
  .halo::before {
    content: "";
    position: absolute;
    inset: -8% -12%;
    background: radial-gradient(circle at 30% 50%, var(--c1), var(--c2), transparent 70%);
    opacity: var(--opacity);
    filter: blur(48px);
    z-index: -1;
  }
</style>
