---
import type { Product } from "../data/products";
import SecondaryCta from "./cta/SecondaryCta.astro";

export interface Props { product: Product; count: number; }
const { product, count } = Astro.props;

const index = String(product.order).padStart(2, "0");
const tag = product.tag.toUpperCase();
const countLabel =
  count === 0 ? "In progress" : count === 1 ? "1 piece" : `${count} pieces`;
---

<article class="card" style={`--card-hue: var(--hue-${product.hue}); --card-hue-text: var(--hue-${product.hue}-text);`}>
  <div class="head head--bar">
    <span class="measure idx">{index} / {tag}</span>
  </div>

  <h3 class="name">{product.name}</h3>
  <p class="blurb">{product.blurb}</p>

  <div class="foot">
    <span class="measure count">{countLabel}</span>
    <SecondaryCta href={`/${product.slug}`} label="Enter" class="cta" />
  </div>
</article>

<style>
  /* ── The exhibit plate ───────────────────────────────────────
     Rest: ink-on-mist, hairline frame, generous padding. Quiet,
     no vermilion. Hover / focus-within "lights" the plate: the
     frame sharpens and vermilion connective marks draw in —
     a leader rule off the index label + a registration tick in
     the corner, echoing the SecondaryCta's own corner marks. */

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 34px 32px 26px;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    /* inset hairline stays invisible at rest, sharpens on hover */
    box-shadow: inset 0 0 0 0 transparent;
    transition: transform 0.25s cubic-bezier(0.3, 0.8, 0.3, 1),
      border-color 0.28s cubic-bezier(0.3, 0.8, 0.3, 1),
      box-shadow 0.28s cubic-bezier(0.3, 0.8, 0.3, 1);
  }

  /* Registration tick — top-right corner. Drawn (scaled in) on hover. */
  .card::after {
    content: "";
    position: absolute;
    top: 14px;
    right: 14px;
    width: 12px;
    height: 12px;
    border-top: 2px solid var(--card-hue);
    border-right: 2px solid var(--card-hue);
    opacity: 0;
    transform: scale(0);
    transform-origin: top right;
    transition: transform 0.26s cubic-bezier(0.3, 0.8, 0.3, 1),
      opacity 0.26s ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-line-2);
    box-shadow: inset 0 0 0 1px var(--color-line-2);
    transform: translateY(-3px);
  }

  .card:hover::after,
  .card:focus-within::after {
    opacity: 1;
    transform: scale(1);
  }

  /* ── Index label + its leader rule ──────────────────────────── */
  .head {
    display: flex;
    align-items: center;
  }

  /* Full-bleed hue bar; paper text on the text-variant fill (AA-checked). */
  .head--bar {
    margin: -34px -32px 0;
    padding: 24px 32px 14px;
    background: var(--card-hue-text);
  }
  .head--bar .idx { color: var(--color-paper); }

  .idx {
    position: relative;
    /* room for the leader rule to draw into without shifting text */
    padding-right: 0;
  }

  /* Horizontal callout leader extending from the index label. */
  .idx::after {
    content: "";
    position: absolute;
    top: 50%;
    left: calc(100% + 10px);
    width: 44px;
    height: 2px;
    background: rgb(234 240 246 / 0.85);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s cubic-bezier(0.3, 0.8, 0.3, 1);
  }

  .card:hover .idx::after,
  .card:focus-within .idx::after {
    transform: scaleX(1);
  }

  /* ── Type ────────────────────────────────────────────────────── */
  .name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.6rem;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }

  .blurb {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-body);
    max-width: 42ch;
    margin: 0 0 4px;
  }

  /* ── Foot: count line + Enter affordance ─────────────────────── */
  .foot {
    margin-top: auto;
    padding-top: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--color-line);
  }

  .count {
    color: var(--color-muted);
  }

  /* Pull the CTA's padding tight to the foot baseline; its corner
     marks remain the affordance and turn vermilion on hover/focus. */
  .foot :global(.secondary) {
    padding: 8px 16px;
    margin-right: -4px;
  }

  /* ── Reduced motion: marks still appear, but no draw/scale ─────
     Color/opacity only — no transform-based animation. The global
     reduce rule also clamps transitions; here we make the marks
     legible at rest-of-hover without any positional motion. */
  @media (prefers-reduced-motion: reduce) {
    .card, .card:hover, .card:focus-within { transform: none; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
    .card::after {
      transform: scale(1);
      transition: opacity 0.2s ease;
    }
    .idx::after {
      transform: scaleX(1);
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .card:hover .idx::after,
    .card:focus-within .idx::after {
      transform: scaleX(1);
      opacity: 1;
    }
  }
</style>
