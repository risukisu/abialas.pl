---
import type { Product } from "../data/products";

export interface Props { product: Product; count: number; countLabel?: string; }
const { product, count, countLabel: labelOverride } = Astro.props;

const tag = product.tag.toUpperCase();
const countLabel =
  labelOverride ??
  (count === 0 ? "In progress" : count === 1 ? "1 piece" : `${count} pieces`);

// Title-bar favicon — user-supplied Streamline "Sharp Pop" PNGs at
// public/icons/<slug>.png (48×48, navy outline + hue-family pop).
// A new product needs its icon dropped there under the same name.
const iconSrc = `/icons/${product.slug}.png`;
---

<a href={`/${product.slug}`} class="card" style={`--card-hue: var(--hue-${product.hue}); --card-hue-text: var(--hue-${product.hue}-text);`}>
  <div class="head head--bar">
    <span class="glyph" aria-hidden="true">
      <img src={iconSrc} alt="" width="22" height="22" />
    </span>
    <span class="measure idx">{tag}</span>
  </div>

  <h3 class="name">{product.name}</h3>
  <p class="blurb">{product.blurb}</p>

  <div class="foot">
    <span class="measure count">{countLabel}</span>
    <span class="go" aria-hidden="true">→</span>
  </div>
</a>

<style>
  /* ── The window plate (Happy-Hues look test, 2026-07-21) ─────
     Flat-illustration "browser window": thick ink outline, rounded
     corners, hue title bar with three paper dots, hard offset shadow
     in ink. The whole window is one link; hover nudges it up-left and
     deepens the shadow — like lifting a card off the table.
     EXPERIMENTAL: white panel is variant-only, not a palette token. */

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 30px 32px 24px;
    background: #fff;
    border: 2px solid var(--color-ink);
    /* rectangular — hard corners per the flat-window language */
    box-shadow: 6px 6px 0 var(--color-ink);
    text-decoration: none;
    color: var(--color-ink);
    overflow: hidden; /* keeps the full-bleed title bar inside the frame */
    transition: transform 0.22s cubic-bezier(0.3, 0.8, 0.3, 1),
      box-shadow 0.22s cubic-bezier(0.3, 0.8, 0.3, 1);
  }

  .card:hover,
  .card:focus-visible,
  .card:focus-within {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--color-ink);
  }

  /* Root anchor keyboard focus — visible ring in the card's hue. */
  .card:focus-visible {
    outline: 2px solid var(--card-hue-text);
    outline-offset: 3px;
  }

  /* ── Title bar: three dots + index label ─────────────────────── */
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* Full-bleed hue bar; paper text on the text-variant fill (AA-checked).
     Bottom border draws the window-chrome divider. */
  .head--bar {
    margin: -30px -32px 0;
    padding: 14px 24px;
    background: var(--card-hue-text);
    border-bottom: 2px solid var(--color-ink);
  }
  .head--bar .idx { color: var(--color-paper); }

  /* Title-bar favicon chip — the browser-tab metaphor: a small paper
     plate on the hue bar so the multicolor icon reads cleanly. */
  .glyph {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    background: #fff;
    border: 2px solid var(--color-ink);
  }
  .glyph img {
    display: block;
  }

  /* ── Type ────────────────────────────────────────────────────── */
  .name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.6rem;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }

  .blurb {
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-body);
    max-width: 42ch;
    margin: 0 0 4px;
  }

  /* ── Foot: count line + arrow affordance ─────────────────────── */
  .foot {
    margin-top: auto;
    padding-top: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--color-line);
  }

  .count {
    color: var(--color-muted);
  }

  /* The arrow replaces the old Enter button: quiet at rest, slides
     and takes the card's hue when the plate lights. */
  .go {
    font-size: 1.2rem;
    line-height: 1;
    opacity: 0.45;
    transition: opacity 0.18s ease, transform 0.18s ease, color 0.18s ease;
  }

  .card:hover .go,
  .card:focus-visible .go,
  .card:focus-within .go {
    opacity: 1;
    transform: translateX(4px);
    color: var(--card-hue-text);
  }


  /* ── Reduced motion: no positional animation ─────────────────
     The shadow still deepens (color/size only), the window doesn't
     move, the arrow doesn't slide. */
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover,
    .card:focus-visible,
    .card:focus-within {
      transform: none;
      transition: box-shadow 0.2s ease;
    }
    .go {
      transition: opacity 0.18s ease, color 0.18s ease;
    }
    .card:hover .go,
    .card:focus-visible .go,
    .card:focus-within .go {
      transform: none;
    }
  }
</style>
