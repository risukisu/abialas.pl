---
<footer id="contact" class="footer">
  <!-- 1 · Identity row -->
  <div class="container footer__top">
    <div class="footer__id">
      <p class="footer__name">Andrzej Białaś</p>
      <p class="footer__tagline">Marketing as a System</p>
    </div>
    <ul class="footer__social" aria-label="Profiles elsewhere">
      {socials.map((s) => (
        <li>
          <a href={s.href} rel="me" aria-label={s.label} title={s.label}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d={s.d} /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- 2 · Working row: subscribe + sorted columns -->
  <div class="container footer__grid">
    <div class="footer__subscribe">
      <p class="measure">Newsletter</p>
      <p class="footer__pitch">
        The Grug-Brained Marketer — plain words about marketing, in your inbox.
      </p>
      <iframe
        class="footer__embed"
        src="https://grugbrained.substack.com/embed"
        title="Subscribe to the Grug-Brained Marketer on Substack"
        loading="lazy"
        scrolling="no"
      ></iframe>
    </div>
    <nav aria-label="Explore">
      <p class="measure">Explore</p>
      <ul>
        <li><a href="/system">System</a></li>
        <li><a href="/ai">AI</a></li>
        <li><a href="/work">Work</a></li>
        <li><a href="/writing">Writing</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </nav>
    <div>
      <p class="measure">Contact</p>
      <ul>
        <li><a href="mailto:kontakt@abialas.pl">kontakt@abialas.pl</a></li>
        <li><a href="https://www.linkedin.com/in/andrzejbialas/" rel="me">LinkedIn</a></li>
        <li><a href="https://github.com/risukisu" rel="me">GitHub</a></li>
      </ul>
    </div>
    <div>
      <p class="measure">Elsewhere</p>
      <ul>
        <li><a href="https://risu.pl">risu.pl</a></li>
        <li><a href="https://skillcraft.cloud">SkillCraft</a></li>
        <li><a href="https://grugbrained.substack.com">Grug-Brained Marketer</a></li>
      </ul>
    </div>
  </div>

  <!-- 3 · Strip -->
  <div class="container footer__strip">
    <span>© {year}</span>
    <span>made with 🩵 by risu</span>
    <a href="/resume.pdf" download class="footer__resume">Download resume (PDF)</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding-top: 56px;
    padding-bottom: 32px;
    margin-top: var(--section-padding);
  }

  /* ── 1 · Identity row ─────────────────────────────────────────── */
  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    padding-bottom: 40px;
    margin-bottom: 44px;
    border-bottom: 1px solid var(--color-line);
  }

  .footer__name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-ink);
    font-weight: 500;
    margin: 0 0 4px;
  }

  .footer__tagline {
    color: var(--color-muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .footer__social {
    display: flex;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    transition: color 0.15s, border-color 0.15s;
  }

  .footer__social a:hover {
    color: var(--color-accent);
    border-color: var(--color-line-2);
  }

  /* ── 2 · Working row ──────────────────────────────────────────── */
  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  .footer__grid .measure {
    display: block;
    margin-bottom: 14px;
    color: var(--color-muted);
  }

  .footer__grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__grid li {
    margin-bottom: 8px;
  }

  .footer__grid a {
    color: var(--color-body);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  .footer__grid a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* Subscribe box — our hairline frames Substack's iframe. */
  .footer__pitch {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-body);
    margin: 0 0 16px;
    max-width: 34ch;
  }

  .footer__embed {
    display: block;
    width: 100%;
    max-width: 420px;
    height: 150px;
    border: 1px solid var(--color-line-2);
    background: transparent;
  }

  /* ── 3 · Strip ────────────────────────────────────────────────── */
  .footer__strip {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-muted);
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
  }

  .footer__resume {
    color: var(--color-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line-2);
    transition: color 0.15s, border-color 0.15s;
  }

  .footer__resume:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }

  /* ── Responsive ───────────────────────────────────────────────── */
  @media (max-width: 960px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
    .footer__subscribe {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer__top {
      flex-direction: column;
    }
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer__strip {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }
  }
</style>
