---
<footer id="contact" class="footer">
  <div class="container footer__inner">
    <p class="footer__name">Andrzej Białaś</p>
    <p class="footer__signoff">That's the sheet. Thanks for reading.</p>

    <nav class="footer__nav" aria-label="Footer">
      <a href="/work">Work</a><span aria-hidden="true">·</span>
      <a href="/writing">Writing</a><span aria-hidden="true">·</span>
      <a href="/about">About</a><span aria-hidden="true">·</span>
      <a href="/resume.pdf" download>Résumé (PDF)</a>
    </nav>

    <ul class="footer__tiles" aria-label="Contact and profiles">
      {tiles.map((t) => (
        <li>
          <a href={t.href} rel={t.me ? "me" : undefined} aria-label={t.label} title={t.label}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor"><path d={t.d} /></svg>
          </a>
        </li>
      ))}
    </ul>

    <div class="footer__news">
      <p class="footer__pitch">
        The Grug-Brained Marketer — plain words about marketing, in your inbox.
      </p>
      <!-- Eager on purpose: lazy-loading left a blank box / inert-looking
           button for the beat between scroll-into-view and Substack's JS
           booting, which read as broken. -->
      <iframe
        class="footer__embed"
        src="https://grugbrained.substack.com/embed"
        title="Subscribe to the Grug-Brained Marketer on Substack"
        scrolling="no"
      ></iframe>
    </div>

    <p class="footer__colophon">
      Built with Astro · No cookies, no tracking · © {year} · made with 🩵 by
      <a href="https://risu.pl">risu</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    margin-top: var(--section-padding);
    padding: 56px 0 40px;
    text-align: center;
  }

  .footer__inner {
    max-width: 640px;
  }

  .footer__name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--color-ink);
    margin: 0 0 6px;
  }

  .footer__signoff {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-muted);
    margin: 0 0 26px;
  }

  .footer__nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 20px;
  }

  .footer__nav span {
    color: var(--color-line-2);
  }

  .footer__nav a {
    color: var(--color-body);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }

  .footer__nav a:hover,
  .footer__nav a:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .footer__tiles {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
  }

  .footer__tiles a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
    transition: color 0.15s, border-color 0.15s, transform 0.15s;
  }

  .footer__tiles a:hover,
  .footer__tiles a:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-line-2);
    transform: translateY(-2px);
  }

  .footer__news {
    margin: 0 0 30px;
  }

  .footer__pitch {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    color: var(--color-body);
    margin: 0 0 14px;
  }

  /* Subscribe box — our hairline frames Substack's iframe, centered
     to keep the colophon's axis. */
  .footer__embed {
    display: block;
    width: 100%;
    max-width: 420px;
    height: 150px;
    margin-inline: auto;
    border: 1px solid var(--color-line-2);
    background: transparent;
  }

  .footer__colophon {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-muted);
    border-top: 1px solid var(--color-line);
    padding-top: 20px;
    margin: 0;
    line-height: 1.9;
  }

  .footer__colophon a {
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__tiles a:hover,
    .footer__tiles a:focus-visible {
      transform: none;
    }
  }
</style>
