---
const year = new Date().getFullYear();
---
<footer id="contact" class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__name">Andrzej Białaś</p>
      <p class="footer__tagline">Marketing as a System</p>
    </div>
    <div>
      <p class="measure">Contact</p>
      <ul>
        <li><a href="mailto:kontakt@abialas.pl">kontakt@abialas.pl</a></li>
        <li><a href="https://www.linkedin.com/in/andrzejbialas/" rel="me">LinkedIn</a></li>
        <li><a href="https://github.com/risukisu" rel="me">GitHub</a></li>
      </ul>
    </div>
    <div>
      <p class="measure">Elsewhere</p>
      <ul>
        <li><a href="/writing">Writing</a></li>
        <li><a href="https://risu.pl">risu.pl</a></li>
        <li><a href="https://skillcraft.cloud">SkillCraft</a></li>
        <li><a href="https://grugbrained.substack.com">Grug-Brained Marketer</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer__strip">
    <span>© {year}</span>
    <span>made with 🩵 by risu</span>
    <a href="/resume.pdf" download class="footer__resume">Download resume (PDF)</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding-top: 64px;
    padding-bottom: 32px;
    margin-top: var(--section-padding);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .footer__grid ul { list-style: none; margin: 0; padding: 0; }
  .footer__grid li { margin-bottom: 4px; }
  .footer__grid a {
    color: var(--color-body);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .footer__grid a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  .footer__name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-ink);
    font-weight: 400;
    margin-bottom: 4px;
  }
  .footer__tagline { color: var(--color-muted); margin: 0; }
  .footer__strip {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-muted);
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
  }
  .footer__resume {
    color: var(--color-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line-2);
    transition: color 0.15s, border-color 0.15s;
  }
  .footer__resume:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }
  @media (max-width: 768px) {
    .footer__grid { grid-template-columns: 1fr; gap: 32px; }
    .footer__strip { flex-direction: column; gap: 8px; align-items: flex-start; }
  }
</style>
