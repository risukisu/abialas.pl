---
/**
 * LAB SHELL — shared wrapper for the nexus prototypes: noindex layout,
 * compact real-copy hero, and a fixed A/B/C switcher for flipping.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";

export interface Props {
  variant: "A" | "B" | "C" | "D" | "D2";
  title: string;
}
const { variant, title } = Astro.props;
const variants = ["A", "B", "C", "D", "D2"] as const;
---
<BaseLayout title={`Lab ${variant} — ${title}`} noindex={true}>
  <div class="lab-switch" aria-label="Prototype switcher">
    <span class="measure">LAB</span>
    {variants.map((v) => (
      <a href={`/lab/${v.toLowerCase()}`} class:list={["lab-switch__link", v === variant && "is-active"]}>{v}</a>
    ))}
    <a href="/" class="lab-switch__link">real home</a>
  </div>

  <header class="lab-hero">
    <div class="container">
      <span class="measure lab-hero__coord">index · lab {variant} — {title}</span>
      <h1 class="lab-hero__name">Hi, I'm Andrzej. I do marketing.</h1>
      <p class="lab-hero__sub">
        I run marketing as a system instead of a string of campaigns. This is
        where I write down how that actually works — what compounds, what
        breaks, and the parts that don't make it into the case studies.
      </p>
    </div>
  </header>

  <slot />
</BaseLayout>

<style>
  .lab-switch {
    position: fixed;
    bottom: 18px;
    right: 18px;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: #fff;
    border: 2px solid var(--color-ink);
    box-shadow: 4px 4px 0 var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
  }

  .lab-switch__link {
    color: var(--color-muted);
    text-decoration: none;
    text-transform: uppercase;
  }

  .lab-switch__link.is-active {
    color: var(--color-accent);
    font-weight: 700;
  }

  .lab-switch__link:hover {
    color: var(--color-ink);
  }

  .lab-hero {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(24px, 3vw, 40px);
  }

  .lab-hero__coord {
    display: block;
    margin-bottom: 18px;
    color: var(--color-muted);
  }

  .lab-hero__name {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 18ch;
    margin: 0 0 22px;
  }

  .lab-hero__name::after {
    content: "";
    display: block;
    width: 130px;
    height: 6px;
    margin-top: 20px;
    background: var(--gradient-spectrum);
  }

  .lab-hero__sub {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.5;
    color: var(--color-body);
    max-width: 54ch;
    margin: 0;
  }

  /* Shared lab section idioms — :global so slotted pages can use them. */
  :global(.lab-sec) {
    padding-top: clamp(36px, 5vw, 60px);
  }

  :global(.lab-sec__head) {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 22px;
  }

  :global(.lab-sec__rule) {
    flex: 1;
    height: 3px;
    background: var(--gradient-spectrum);
  }

  :global(.lab-grid) {
    display: grid;
    gap: 18px;
    padding-right: 6px; /* hover-shadow room */
  }

  :global(.lab-grid--2) { grid-template-columns: repeat(2, 1fr); }
  :global(.lab-grid--3) { grid-template-columns: repeat(3, 1fr); }
  :global(.lab-grid--4) { grid-template-columns: repeat(4, 1fr); }

  @media (max-width: 900px) {
    :global(.lab-grid--3),
    :global(.lab-grid--4) { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 540px) {
    :global(.lab-grid--2),
    :global(.lab-grid--3),
    :global(.lab-grid--4) { grid-template-columns: 1fr; }
  }
</style>
