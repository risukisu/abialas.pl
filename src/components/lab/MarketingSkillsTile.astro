---
/**
 * LAB — the marketing-skills tile, designed as if the repo is already
 * public. No stats: the value proposition IS the picture — a skills
 * library as an Obsidian-style graph view, disciplines as colored
 * clusters, everything wired to everything.
 *
 * The constellation is generated at build time with a SEEDED PRNG so
 * it renders identically on every build (no layout lottery), sized by
 * a 720×200 viewBox that slices to fill the banner.
 */
function mulberry32(seed: number) {
  let t = seed;
  return () => {
    t |= 0;
    t = (t + 0x6d2b79f5) | 0;
    let r = Math.imul(t ^ (t >>> 15), 1 | t);
    r = (r + Math.imul(r ^ (r >>> 7), 61 | r)) ^ r;
    return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20260724);

// Discipline clusters — palette echoing the reference graph.
const CLUSTERS = [
  { x: 430, y: 95, spread: 52, n: 26, c: "#E8833A" }, // the orange heart
  { x: 560, y: 60, spread: 38, n: 16, c: "#C34D4D" }, // rust
  { x: 640, y: 140, spread: 34, n: 14, c: "#7FD6A4" }, // mint
  { x: 510, y: 165, spread: 30, n: 12, c: "#8FA6E8" }, // periwinkle
  { x: 350, y: 160, spread: 30, n: 11, c: "#E88BB1" }, // pink
  { x: 300, y: 55, spread: 34, n: 12, c: "#9B7FE8" }, // purple
  { x: 210, y: 120, spread: 28, n: 9, c: "#EDE7DA" }, // bone-white
];

type Node = { x: number; y: number; r: number; c: string };
const nodes: Node[] = [];
const edges: { x1: number; y1: number; x2: number; y2: number; c: string }[] = [];

for (const cl of CLUSTERS) {
  const members: Node[] = [];
  for (let i = 0; i < cl.n; i++) {
    // sum of two rands ≈ triangular — denser toward the cluster core
    const a = rand() * Math.PI * 2;
    const d = (rand() + rand()) * 0.5 * cl.spread;
    const node = {
      x: cl.x + Math.cos(a) * d,
      y: cl.y + Math.sin(a) * d * 0.72, // squash to the banner's aspect
      r: rand() < 0.12 ? 3.6 : 1.3 + rand() * 1.8,
      c: cl.c,
    };
    members.push(node);
    nodes.push(node);
    // wire each node to an earlier member — a connected cluster
    if (i > 0) {
      const to = members[Math.floor(rand() * i)];
      edges.push({ x1: node.x, y1: node.y, x2: to.x, y2: to.y, c: cl.c });
    }
  }
}

// A few cross-cluster trunks — the "everything connects" lines.
for (let i = 0; i < 10; i++) {
  const a = CLUSTERS[Math.floor(rand() * CLUSTERS.length)];
  const b = CLUSTERS[Math.floor(rand() * CLUSTERS.length)];
  if (a === b) continue;
  edges.push({
    x1: a.x + (rand() - 0.5) * a.spread,
    y1: a.y + (rand() - 0.5) * a.spread * 0.7,
    x2: b.x + (rand() - 0.5) * b.spread,
    y2: b.y + (rand() - 0.5) * b.spread * 0.7,
    c: "#C34D4D",
  });
}

// Lone thoughts drifting at the rim.
const scatter: Node[] = [];
for (let i = 0; i < 70; i++) {
  scatter.push({
    x: rand() * 720,
    y: rand() * 200,
    r: 0.6 + rand() * 0.9,
    c: rand() < 0.7 ? "#EDE7DA" : CLUSTERS[Math.floor(rand() * CLUSTERS.length)].c,
  });
}
---
<a href="https://github.com/risukisu/marketing-skills" class="msk" rel="me">
  <svg class="msk__graph" viewBox="0 0 720 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    {edges.map((e) => (
      <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke={e.c} stroke-width="0.5" opacity="0.28" />
    ))}
    {scatter.map((n) => (
      <circle cx={n.x} cy={n.y} r={n.r} fill={n.c} opacity="0.35" />
    ))}
    {nodes.map((n) => (
      <circle cx={n.x} cy={n.y} r={n.r} fill={n.c} opacity="0.9" />
    ))}
  </svg>
  <span class="msk__scrim" aria-hidden="true"></span>
  <span class="msk__body">
    <span class="msk__row">
      <span class="msk__name">marketing-skills</span>
      <span class="msk__out" aria-hidden="true">↗</span>
    </span>
    <span class="msk__desc">
      Everything I know how to do in marketing — written as skills,
      wired together, ready to run in Claude Code.
    </span>
    <span class="msk__where">github · open source</span>
  </span>
</a>

<style>
  .msk {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 176px;
    padding: 24px 26px;
    background: #0d1016; /* the graph-view dark */
    border: 2px solid var(--color-ink);
    box-shadow: 6px 6px 0 var(--color-ink);
    color: #ede7da;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.18s cubic-bezier(0.3, 0.8, 0.3, 1),
      box-shadow 0.18s cubic-bezier(0.3, 0.8, 0.3, 1);
  }

  .msk:hover,
  .msk:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--color-ink);
  }

  .msk:focus-visible {
    outline: 2px solid #e8833a;
    outline-offset: 3px;
  }

  .msk__graph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: filter 0.25s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  /* Hover: the network lights up and leans in. */
  .msk:hover .msk__graph,
  .msk:focus-visible .msk__graph {
    filter: brightness(1.25) saturate(1.15);
    transform: scale(1.02);
  }

  /* Left scrim keeps the words readable over the constellation. */
  .msk__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(13 16 22 / 0.94) 0%,
      rgb(13 16 22 / 0.72) 34%,
      rgb(13 16 22 / 0.25) 58%,
      transparent 78%
    );
  }

  .msk__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 7px;
    max-width: 46ch;
  }

  .msk__row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  /* Repo-style name — it IS a repo, let it read like one. */
  .msk__name {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.25rem;
    color: #fff;
  }

  .msk__out {
    color: #e8833a;
    opacity: 0.85;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .msk:hover .msk__out,
  .msk:focus-visible .msk__out {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .msk__desc {
    font-size: 1rem;
    line-height: 1.5;
    color: #d8d2c4;
  }

  .msk__where {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: #e8833a;
  }

  @media (prefers-reduced-motion: reduce) {
    .msk,
    .msk:hover,
    .msk:focus-visible {
      transform: none;
      transition: box-shadow 0.2s ease;
    }
    .msk__graph,
    .msk:hover .msk__graph,
    .msk:focus-visible .msk__graph {
      transform: none;
      transition: filter 0.25s ease;
    }
    .msk:hover .msk__out,
    .msk:focus-visible .msk__out {
      transform: none;
    }
  }
</style>
