---
const currentPath = Astro.url.pathname;
---
<nav class="nav container">
  <a href="/" class="nav__brand">Andrzej Białas</a>
  <ul class="nav__links">
    <li><a href="/writing" aria-current={currentPath.startsWith('/writing') ? 'page' : undefined}>Writing</a></li>
    <li><a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>About</a></li>
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    padding-bottom: 24px;
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid transparent;
    transition: border-color 150ms ease;
  }
  .nav__brand {
    font-weight: 500;
    color: var(--color-ink);
    border: none;
  }
  .nav__links {
    display: flex;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__links a {
    color: var(--color-ink);
    border: none;
  }
  .nav__links a[aria-current="page"] { color: var(--color-cobalt); }
</style>
