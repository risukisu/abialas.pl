---
const path = Astro.url.pathname;
const is = (p: string) => path === p || path.startsWith(p + "/");
---
<nav class="nav container">
  <a href="/" class="nav__brand">
    <img src="/squirrel.png" alt="" class="nav__squirrel" width="20" height="20" />
    Andrzej Białaś
  </a>
  <ul class="nav__links">
    <li><a href="/work" aria-current={is("/work") ? "page" : undefined}>Work</a></li>
    <li><a href="/writing" aria-current={is("/writing") ? "page" : undefined}>Writing</a></li>
    <li><a href="/about" aria-current={is("/about") ? "page" : undefined}>About</a></li>
  </ul>
</nav>
<style>
  /* 22px + one brand line + 22px = --nav-height in global.css, which
     html's scroll-padding reads so #anchors land below this bar. */
  .nav { display:flex; justify-content:space-between; align-items:center;
         padding:22px 24px; position:sticky; inset-block-start:0; z-index:10;
         background:var(--color-bg); border-block-end:1px solid transparent; }
  .nav__brand { display:flex; align-items:center; gap:10px; font-family:var(--font-serif); font-size:1.15rem; color:var(--color-ink); border:none; text-decoration:none; }
  .nav__squirrel { flex:none; image-rendering:pixelated; }
  .nav__links { display:flex; gap:34px; list-style:none; margin:0; padding:0; }
  /* bumped from 15px — sections should be easy to find (owner call, lab D round) */
  .nav__links a { position:relative; font:500 17px var(--font-sans); color:var(--color-ink); text-decoration:none; border:none; }
  /* 44px-tall tap target around a 20px-tall word. */
  .nav__links a::after { content:""; position:absolute; inset:min(0px, (100% - 44px) / 2); }
  .nav__links a[aria-current="page"], .nav__links a:active { color:var(--color-accent); }
</style>
