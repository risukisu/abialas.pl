---
/**
 * Cookie consent — set up exactly like risu.pl, dressed as abialas.pl.
 *
 * Same behaviour as the blog: a full-width banner on the first visit
 * only, a persistent cookie button (bottom-left) on every page that opens
 * a preferences panel showing the current status, accept / decline in
 * both places, the choice in localStorage `cookie-consent`, and
 * gtag('consent', 'update') flipping analytics_storage. Analytics.astro
 * holds the Consent Mode defaults.
 *
 * Look: the site's plates — white, 2px ink frame, hard offset shadow (the
 * work hue's gold: cookie-coloured), mono measure labels, the spectrum rule
 * across the top of the banner, ink primary / hairline secondary buttons.
 * Everything starts hidden and the script reveals it, so no-JS visitors
 * never see controls that can't work. Renders nothing while GA_ID is empty.
 */
import { GA_ID } from "../data/analytics";

const id = import.meta.env.PUBLIC_GA_ID || GA_ID;
---
{id && (
  <div class="cc" data-cc>
    <button class="cc-icon" type="button" data-cc-icon aria-label="Cookie preferences" title="Cookie preferences" aria-expanded="false" aria-controls="cc-panel" hidden>
      <svg viewBox="0 0 16 16" width="20" height="20" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.3" />
        <circle cx="5" cy="5" r="1.2" fill="currentColor" />
        <circle cx="10" cy="4" r="0.8" fill="currentColor" />
        <circle cx="7" cy="9" r="1" fill="currentColor" />
        <circle cx="11" cy="8" r="0.7" fill="currentColor" />
        <circle cx="4" cy="11" r="0.9" fill="currentColor" />
        <circle cx="9" cy="12" r="1.1" fill="currentColor" />
      </svg>
    </button>

    <div class="cc-panel" id="cc-panel" role="dialog" aria-label="Cookie preferences" data-cc-panel>
      <p class="measure cc-panel__head">Cookie preferences</p>
      <p class="cc-panel__text">This site uses cookies for analytics (Google Analytics).</p>
      <p class="cc-panel__status">Status: <span data-cc-status>not set</span></p>
      <div class="cc-buttons">
        <button class="cc-btn cc-btn--accept" type="button" data-cc-action="accept">Accept</button>
        <button class="cc-btn cc-btn--decline" type="button" data-cc-action="decline">Decline</button>
      </div>
    </div>

    <div class="cc-banner" role="region" aria-label="Cookie consent" data-cc-banner hidden>
      <div class="container cc-banner__inner">
        <p class="cc-banner__msg"><span class="measure cc-banner__tag">Cookies</span> This site uses cookies for analytics.</p>
        <div class="cc-buttons">
          <button class="cc-btn cc-btn--accept" type="button" data-cc-action="accept">Accept</button>
          <button class="cc-btn cc-btn--decline" type="button" data-cc-action="decline">Decline</button>
        </div>
      </div>
    </div>
  </div>
)}

<script>
  import { CONSENT_KEY } from "../data/analytics";

  const root = document.querySelector<HTMLElement>("[data-cc]");
  if (root) {
    const icon = root.querySelector<HTMLButtonElement>("[data-cc-icon]")!;
    const panel = root.querySelector<HTMLElement>("[data-cc-panel]")!;
    const banner = root.querySelector<HTMLElement>("[data-cc-banner]")!;
    const status = root.querySelector<HTMLElement>("[data-cc-status]")!;

    let consent: string | null = null;
    try {
      consent = localStorage.getItem(CONSENT_KEY);
    } catch {}
    status.textContent = consent === "accepted" ? "accepted" : consent === "declined" ? "declined" : "not set";

    icon.hidden = false;

    // While the banner shows, pad the page by its height so the footer can
    // still scroll clear of it (risu.pl lets the banner cover the end).
    const pad = new ResizeObserver(() => {
      document.body.style.paddingBottom = banner.hidden ? "" : `${banner.offsetHeight}px`;
    });
    if (!consent) {
      banner.hidden = false; // first visit only
      pad.observe(banner);
    }
    const hideBanner = () => {
      banner.hidden = true;
      pad.disconnect();
      document.body.style.paddingBottom = "";
    };

    const setOpen = (open: boolean) => {
      root.toggleAttribute("data-open", open);
      icon.setAttribute("aria-expanded", String(open));
    };
    icon.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(!root.hasAttribute("data-open"));
    });
    document.addEventListener("click", (e) => {
      const t = e.target as Node;
      if (root.hasAttribute("data-open") && !panel.contains(t) && !icon.contains(t)) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && root.hasAttribute("data-open")) {
        setOpen(false);
        icon.focus();
      }
    });

    root.querySelectorAll<HTMLButtonElement>("[data-cc-action]").forEach((b) =>
      b.addEventListener("click", () => {
        const accept = b.dataset.ccAction === "accept";
        const val = accept ? "accepted" : "declined";
        try {
          localStorage.setItem(CONSENT_KEY, val);
        } catch {}
        status.textContent = val;
        (window as any).gtag?.("consent", "update", { analytics_storage: accept ? "granted" : "denied" });
        hideBanner();
      }),
    );
  }
</script>

<style>
  .cc {
    --cc-shadow: #a5700c; /* work gold — cookie-coloured */
  }

  /* ── The persistent cookie button ─────────────────────────────── */
  .cc-icon {
    position: fixed;
    bottom: 16px;
    left: 16px;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    background: #fff;
    color: var(--color-ink);
    border: 2px solid var(--color-ink);
    box-shadow: 3px 3px 0 var(--cc-shadow);
    cursor: pointer;
    transition: transform 0.18s cubic-bezier(0.3, 0.8, 0.3, 1),
      box-shadow 0.18s cubic-bezier(0.3, 0.8, 0.3, 1), color 0.15s, background 0.15s;
  }
  .cc-icon[hidden] {
    display: none;
  }
  .cc-icon:hover,
  .cc-icon:focus-visible {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--cc-shadow);
    color: var(--color-accent);
  }
  .cc[data-open] .cc-icon {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* ── Preferences panel ────────────────────────────────────────── */
  .cc-panel {
    position: fixed;
    bottom: 68px;
    left: 16px;
    z-index: 61;
    width: min(320px, calc(100vw - 32px));
    padding: 16px 18px 18px;
    background: #fff;
    border: 2px solid var(--color-ink);
    box-shadow: 4px 4px 0 var(--cc-shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s, transform 0.2s, visibility 0s linear 0.2s;
  }
  .cc[data-open] .cc-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.2s, transform 0.2s, visibility 0s;
  }
  .cc-panel__head {
    margin: 0 0 8px;
    color: var(--color-ink);
  }
  .cc-panel__text {
    margin: 0 0 10px;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-body);
  }
  .cc-panel__status {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-muted);
  }
  .cc-panel__status span {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* ── First-visit banner ───────────────────────────────────────── */
  .cc-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 62;
    padding: 14px 0;
    background: #fff;
    border-top: 1px solid var(--color-ink);
  }
  .cc-banner[hidden] {
    display: none;
  }
  .cc-banner::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -4px;
    height: 3px;
    background: var(--gradient-spectrum);
  }
  .cc-banner__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .cc-banner__msg {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-body);
  }
  .cc-banner__tag {
    margin-right: 10px;
    color: var(--color-ink);
  }

  /* ── Buttons: ink primary, hairline secondary ─────────────────── */
  .cc-buttons {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }
  .cc-btn {
    min-height: 44px;
    padding: 0 18px;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 2px solid var(--color-ink);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .cc-btn--accept {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .cc-btn--accept:hover,
  .cc-btn--accept:focus-visible {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .cc-btn--decline {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-line-2);
  }
  .cc-btn--decline:hover,
  .cc-btn--decline:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .cc-icon,
    .cc-icon:hover,
    .cc-icon:focus-visible,
    .cc-panel,
    .cc[data-open] .cc-panel {
      transform: none;
    }
  }
</style>
