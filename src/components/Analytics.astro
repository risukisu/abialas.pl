---
/**
 * GA4 in Advanced Consent Mode — the same setup as risu.pl (BaseHead.astro
 * there): consent defaults to denied, gtag loads right away and sends only
 * cookieless pings until the visitor accepts in CookieConsent.astro. A
 * stored "accepted" is re-granted on every page load. Renders nothing
 * while GA_ID is empty.
 */
import { GA_ID, CONSENT_KEY } from "../data/analytics";

const id = import.meta.env.PUBLIC_GA_ID || GA_ID;
---
{id && (
  <script is:inline define:vars={{ GA_ID: id, KEY: CONSENT_KEY }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = gtag;

    // Denied until the visitor accepts.
    gtag("consent", "default", {
      analytics_storage: "denied",
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
    });

    // Load gtag immediately (cookieless pings while denied).
    var s = document.createElement("script");
    s.async = true;
    s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
    document.head.appendChild(s);

    gtag("js", new Date());
    gtag("config", GA_ID);

    try {
      if (localStorage.getItem(KEY) === "accepted") {
        gtag("consent", "update", { analytics_storage: "granted" });
      }
    } catch (e) {}
  </script>
)}
