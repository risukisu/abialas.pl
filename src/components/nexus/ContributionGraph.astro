---
/**
 * The GitHub tile — a scoreboard on the GitHub canvas (redesigned
 * 2026-09-27; the squirrel backdrop came off on the owner's call).
 *
 * Type follows the sibling tiles: serif name and hero figure, sans for
 * words and axis ticks, mono only for the where-line. Colour (2026-09-28,
 * owner: "a bit bland"): a dark ink-navy canvas with a faint drafting
 * grid and one green glow, the green ramp for the data (validated: every
 * adjacent level ≥ 15 ΔE, CVD ≥ 12), and the site's ochre as the single
 * warm accent for "now" — this month's bar and today's ring.
 *
 * Left: the year's contribution total as the one hero number, with a
 * twelve-month strip under it: past months in a quiet green, this month
 * in the accent, months still to come as bare stubs. Right: the last six
 * months as the familiar heatmap (1st of the month five back → build
 * date), solid cells on a stepped green ramp, today ringed. Foot: the
 * profile and its live public-repo count. Every figure is read off the
 * API at build time (daily rebuild); nothing is typed in.
 *
 * Data: the public jogruber contributions API, one call per calendar year
 * the view touches (two when the six months cross a new year); a graceful
 * note on failure so a dead API can never break the build. The repo count
 * (GitHub API) drops silently if unavailable.
 *
 * Fetched via a bare `node:https` GET, not the global `fetch` — Node's
 * bundled undici keeps its socket in a keep-alive pool that, on Windows,
 * can still be half-open when the build process tries to exit, tripping
 * a libuv assertion ("Assertion failed: !(handle->flags &
 * UV_HANDLE_CLOSING)", src\win\async.c:76) once this component became
 * the last page astro builds (so the socket's teardown races the
 * process's own). `agent: false` forces a one-off socket that's closed
 * at response end, instead of being handed back to a keep-alive pool —
 * deterministic teardown before the build process tries to exit.
 */
import https from "node:https";
import { fetchJson } from "../../lib/fetchJson";

const USER = "risukisu";

type Day = { date: string; count: number; level: 0 | 1 | 2 | 3 | 4 };

function getJson(url: string, timeoutMs: number): Promise<any> {
  return new Promise((resolve, reject) => {
    const req = https.get(url, { agent: false, headers: { accept: "application/json" } }, (res) => {
      const status = res.statusCode ?? 0;
      if (status < 200 || status >= 300) {
        res.resume(); // drain so the socket closes instead of dangling
        reject(new Error(String(status)));
        return;
      }
      const chunks: Buffer[] = [];
      res.on("data", (chunk) => chunks.push(chunk));
      res.on("end", () => {
        try {
          resolve(JSON.parse(Buffer.concat(chunks).toString("utf-8")));
        } catch (err) {
          reject(err);
        }
      });
      res.on("error", reject);
    });
    req.setTimeout(timeoutMs, () => req.destroy(new Error("timeout")));
    req.on("error", reject);
  });
}

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const now = new Date();
const today = now.toISOString().slice(0, 10);
const YEAR = today.slice(0, 4);
const thisMonth = now.getUTCMonth();
// Six whole months ending in this one: the 1st of the month five back.
const since = new Date(Date.UTC(now.getUTCFullYear(), thisMonth - 5, 1)).toISOString().slice(0, 10);

let failed = false;
let yearTotal = 0;
let windowTotal = 0;
let windowDays: Day[] = [];
const monthTotals: (number | null)[] = MONTHS.map((_, m) => (m <= thisMonth ? 0 : null));

try {
  const years = [...new Set([since.slice(0, 4), YEAR])];
  const all: Day[] = [];
  for (const y of years) {
    const data = await getJson(`https://github-contributions-api.jogruber.de/v4/${USER}?y=${y}`, 8000);
    all.push(...data.contributions);
    if (y === YEAR && typeof data.total?.[YEAR] === "number") yearTotal = data.total[YEAR];
  }
  const past = all.filter((d) => d.date <= today);
  for (const d of past) {
    if (d.date.startsWith(YEAR)) monthTotals[Number(d.date.slice(5, 7)) - 1]! += d.count;
  }
  if (!yearTotal) yearTotal = monthTotals.reduce<number>((s, v) => s + (v ?? 0), 0);
  windowDays = past.filter((d) => d.date >= since).sort((a, b) => a.date.localeCompare(b.date));
  windowTotal = windowDays.reduce((s, d) => s + d.count, 0);
  if (!windowDays.length) failed = true;
} catch {
  failed = true;
}

// GITHUB_TOKEN (set in the deploy workflow) lifts the API from 60 to 1000 req/h.
const token = process.env.GITHUB_TOKEN;
let publicRepos: number | null = null;
try {
  const profile = await fetchJson<{ public_repos: number }>(
    `https://api.github.com/users/${USER}`,
    8000,
    token ? { authorization: `Bearer ${token}` } : {},
  );
  publicRepos = typeof profile.public_repos === "number" ? profile.public_repos : null;
} catch {
  publicRepos = null;
}

// Week columns (Sunday-first), padding the first partial week so the
// weekday rows line up.
type Week = (Day | null)[];
const weeks: Week[] = [];
if (!failed) {
  let week: Week = new Array(new Date(windowDays[0].date).getUTCDay()).fill(null);
  for (const d of windowDays) {
    week.push(d);
    if (week.length === 7) {
      weeks.push(week);
      week = [];
    }
  }
  if (week.length) weeks.push([...week, ...new Array(7 - week.length).fill(null)]);
}

// Month label per week column — where the month changes.
const monthLabels: (string | null)[] = weeks.map((w, i) => {
  const first = w.find(Boolean) as Day | undefined;
  if (!first) return null;
  const m = Number(first.date.slice(5, 7)) - 1;
  if (i === 0) return MONTHS[m];
  const prev = weeks[i - 1].find(Boolean) as Day | undefined;
  return prev && Number(prev.date.slice(5, 7)) - 1 !== m ? MONTHS[m] : null;
});

const maxMonth = Math.max(1, ...monthTotals.map((v) => v ?? 0));
const fmt = (n: number) => n.toLocaleString("en-US");
const monthsLabel = monthTotals
  .map((v, m) => (v === null ? null : `${MONTHS[m]} ${v}`))
  .filter(Boolean)
  .join(", ");
const dayLabel = (d: Day) => {
  const [, mm, dd] = d.date.split("-");
  return `${Number(dd)} ${MONTHS[Number(mm) - 1]}: ${fmt(d.count)} contribution${d.count === 1 ? "" : "s"}`;
};

const GH_MARK =
  "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
---
<a class="graph" href={`https://github.com/${USER}`} rel="me">
  <div class="graph__head">
    <span class="graph__name">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d={GH_MARK} /></svg>
      GitHub
    </span>
    <span class="graph__out" aria-hidden="true">↗</span>
  </div>

  {failed ? (
    <p class="graph__fail measure">contribution graph unavailable right now — see github.com/{USER}</p>
  ) : (
    <div class="graph__body">
      <div class="graph__year">
        <p class="graph__hero">
          <span class="graph__total">{fmt(yearTotal)}</span>
          <span class="graph__label">contributions in&nbsp;{YEAR}</span>
        </p>
        <div class="graph__trend">
          <div class="graph__bars" role="img" aria-label={`Contributions per month in ${YEAR}: ${monthsLabel}`}>
            {monthTotals.map((v, m) => (
              <span
                class:list={["graph__bar", { "is-now": m === thisMonth, "is-future": v === null }]}
                style={v === null ? undefined : `--h:${Math.max(v / maxMonth, v > 0 ? 0.05 : 0)}`}
                title={v === null ? undefined : `${MONTHS[m]} ${YEAR}: ${fmt(v)} contributions`}
              ></span>
            ))}
          </div>
          <div class="graph__initials" aria-hidden="true">
            {MONTHS.map((name, m) => (
              <span class:list={{ "is-now": m === thisMonth, "is-future": m > thisMonth }}>{name[0]}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="graph__recent">
        <div class="graph__caption">
          <p class="graph__caption-t">Last 6 months <span class="graph__caption-n">{fmt(windowTotal)}</span></p>
          <div class="graph__legend" aria-hidden="true">
            Less
            <span class="graph__cell"></span>
            <span class="graph__cell l1"></span>
            <span class="graph__cell l2"></span>
            <span class="graph__cell l3"></span>
            <span class="graph__cell l4"></span>
            More
          </div>
        </div>
        <div class="graph__scroll">
          <div class="graph__months" aria-hidden="true">
            {monthLabels.map((m) => <span class="graph__month">{m ?? ""}</span>)}
          </div>
          <div class="graph__grid" role="img" aria-label={`GitHub contribution heatmap: ${windowTotal} contributions in the last 6 months`}>
            {weeks.map((w) => (
              <div class="graph__week">
                {w.map((d) => (
                  <span
                    class:list={["graph__cell", d && `l${d.level}`, { "is-today": d?.date === today }]}
                    title={d ? dayLabel(d) : undefined}
                  ></span>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  <p class="graph__foot">
    github.com/{USER}{publicRepos !== null && <span class="graph__count"> · {publicRepos} public repos</span>}
  </p>
</a>

<script>
  // Narrow screens scroll the weeks sideways: open on the latest ones.
  document.querySelectorAll<HTMLElement>(".graph__scroll").forEach((el) => {
    el.scrollLeft = el.scrollWidth;
  });
</script>

<style>
  /* Whole plate is one link to the GitHub profile. A size container, so
     the two columns stack by the tile's own width, not the viewport's. */
  .graph {
    --canvas: #0c1a29; /* the site's ink, taken down to night */
    --line: #22364a;
    --fg: #eef3f8;
    --muted: #8fa3b6;
    --faint: #4a5f73;
    --green: #7ee787;
    --now: var(--link-on-ink); /* ochre: the one warm accent, for "now" */
    --shadow: #2ea043; /* GitHub's success green */
    /* heatmap ramp: one green, warming to lime at the top so every adjacent
       level clears 15 ΔE (dataviz validator, dark, on --canvas) */
    --l0: #1a2c3e;
    --l1: #145c3b;
    --l2: #1f9152;
    --l3: #4fd17a;
    --l4: #c2f5a0;
    --bar: #1f7a4d; /* past months: the quiet green */

    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    min-width: 0;
    padding: 18px 22px 16px;
    /* one green glow behind the figure + a faint drafting grid */
    background:
      radial-gradient(110% 95% at 0% 0%, rgb(79 209 122 / 0.12), transparent 55%),
      linear-gradient(rgb(143 163 182 / 0.055) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, rgb(143 163 182 / 0.055) 1px, transparent 1px) 0 0 / 24px 24px,
      var(--canvas);
    border: 2px solid var(--color-ink);
    box-shadow: 6px 6px 0 var(--shadow);
    color: var(--fg);
    text-decoration: none;
    transition: transform 0.18s cubic-bezier(0.3, 0.8, 0.3, 1),
      box-shadow 0.18s cubic-bezier(0.3, 0.8, 0.3, 1);
  }

  .graph:hover,
  .graph:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--shadow);
  }

  .graph:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }

  /* ── Head ─────────────────────────────────────────────────────── */
  .graph__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .graph__name {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.3rem;
    color: var(--fg);
  }
  .graph__name svg {
    position: relative;
    top: -2px; /* sit on the serif's x-height, not its descenders */
  }
  .graph__out {
    color: var(--fg);
    opacity: 0.6;
    transition: opacity 0.18s ease, transform 0.18s ease, color 0.18s ease;
  }
  .graph:hover .graph__out,
  .graph:focus-visible .graph__out {
    opacity: 1;
    color: var(--green);
    transform: translate(2px, -2px);
  }

  /* ── Body: the year | the last six months ─────────────────────── */
  /* The heatmap column is exactly as wide as its weeks (min-content),
     the caption wraps inside it; the year takes the rest. Cell + gap
     step down with the tile's width so six months always fit — set here,
     not on .graph, because a container query can't restyle the container. */
  .graph__body {
    --cell: 13px;
    --gap: 4px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) min-content;
    gap: 22px;
    align-items: stretch;
  }

  .graph__year {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    min-width: 0;
  }

  .graph__hero {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    max-width: none;
  }
  /* The one hero figure, in the site's display serif (the masthead and
     every tile name speak Newsreader here, so sans read off-brand):
     lining, proportional figures. */
  .graph__total {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.9rem, 8cqi, 3.9rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums proportional-nums;
    color: var(--fg);
  }
  .graph__label {
    font-size: 0.95rem;
    color: var(--muted);
  }

  /* Twelve-month strip: bars anchored to one baseline, a 3px surface gap
     between them. Future months are bare stubs on the line. */
  .graph__trend {
    max-width: 220px;
  }
  .graph__bars {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 3px;
    align-items: end;
    height: 46px;
    border-bottom: 1px solid var(--line);
  }
  .graph__bar {
    height: calc(var(--h, 0) * 100%);
    min-height: 0;
    background: var(--bar);
  }
  .graph__bar.is-now {
    background: var(--now);
  }
  .graph__bar.is-future {
    height: 2px;
    background: var(--line);
  }
  .graph__initials {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 3px;
    margin-top: 5px;
    font-family: var(--font-sans);
    font-size: 11px;
    text-align: center;
    color: var(--muted);
  }
  .graph__initials .is-now {
    color: var(--fg);
  }
  .graph__initials .is-future {
    color: var(--faint);
  }

  .graph__recent {
    min-width: 0;
    padding-left: 22px;
    border-left: 1px solid var(--line);
  }
  .graph__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-bottom: 10px;
  }
  .graph__caption-t {
    margin: 0;
    max-width: none;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .graph__caption-n {
    margin-left: 6px;
    font-weight: 600;
    color: var(--fg);
  }

  /* 3px of room for today's ring, taken back by the margin, so the
     weeks fit exactly and nothing scrolls or clips at full size. */
  .graph__scroll {
    overflow-x: auto;
    padding: 3px;
    margin: -3px;
  }

  .graph__months {
    display: flex;
    gap: var(--gap);
    margin-bottom: 4px;
  }
  .graph__month {
    width: var(--cell);
    flex-shrink: 0;
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--muted);
    overflow: visible;
    white-space: nowrap;
  }

  .graph__grid {
    display: flex;
    gap: var(--gap);
  }
  .graph__week {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  .graph__cell {
    width: var(--cell);
    height: var(--cell);
    flex-shrink: 0;
    background: var(--l0);
    box-shadow: inset 0 0 0 1px rgb(240 246 252 / 0.05);
  }
  .graph__cell.l1 { background: var(--l1); box-shadow: none; }
  .graph__cell.l2 { background: var(--l2); box-shadow: none; }
  .graph__cell.l3 { background: var(--l3); box-shadow: none; }
  .graph__cell.l4 { background: var(--l4); box-shadow: none; }

  /* Today, ringed — the build's "you are here". */
  .graph__cell.is-today {
    outline: 2px solid var(--now);
    outline-offset: 1px;
    animation: graph-today 2.4s ease-in-out infinite;
  }
  @keyframes graph-today {
    50% { outline-color: rgb(232 161 60 / 0.35); }
  }

  .graph__legend {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--muted);
  }
  .graph__legend .graph__cell {
    width: 10px;
    height: 10px;
  }

  /* ── Foot ─────────────────────────────────────────────────────── */
  .graph__foot {
    margin: 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--green);
    max-width: none;
  }
  .graph__count {
    color: var(--muted);
  }

  .graph__fail {
    margin: 0;
    color: var(--muted);
  }

  /* Mid tiles (a laptop beside SkillCraft): smaller cells, still side by
     side. Container widths are the plate's content box: full desktop is
     ~723px, and 13px cells need ~700 beside the year column. */
  @container (max-width: 699px) {
    .graph__body {
      --cell: 10px;
      --gap: 3px;
      gap: 18px;
    }
    .graph__recent {
      padding-left: 18px;
    }
  }

  /* Narrow tiles: the year sits on top, the six months below it. */
  @container (max-width: 540px) {
    .graph__body {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
    .graph__year {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
    }
    .graph__trend {
      flex: 1 1 180px;
    }
    .graph__recent {
      padding-left: 0;
      padding-top: 18px;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }

  /* Phones: the smallest step, so all six months show without scrolling. */
  @container (max-width: 400px) {
    .graph__body {
      --cell: 8px;
      --gap: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .graph,
    .graph:hover,
    .graph:focus-visible {
      transform: none;
      transition: box-shadow 0.2s ease;
    }
    .graph:hover .graph__out,
    .graph:focus-visible .graph__out {
      transform: none;
    }
    /* explicit: the global 0.01ms clamp would turn the loop into flicker */
    .graph__cell.is-today {
      animation: none;
    }
  }
</style>
