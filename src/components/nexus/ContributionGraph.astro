---
/**
 * The GitHub tile — the year sheet (owner's pick 2026-09-28, out of four
 * options compared side by side on a local page).
 *
 * The whole calendar year as one heatmap, Jan → Dec, on the white
 * drafting-paper plate. Days already lived are inked on a stepped green
 * ramp (validated on white: every adjacent level ≥ 15 ΔE, CVD ≥ 13); the
 * days still to come are empty pencil squares. Today is ringed in the
 * site's work gold. The year's total is a sentence in the head row, not a
 * hero figure (owner: "too flashy"). Two half-year strips sit edge to
 * edge and stack on phones. Every figure is read off the API at build
 * time (daily rebuild); nothing is typed in.
 *
 * Data: the public jogruber contributions API, one call for the calendar
 * year; a graceful note on failure so a dead API can never break the build.
 *
 * Fetched via a bare `node:https` GET, not the global `fetch` — Node's
 * bundled undici keeps its socket in a keep-alive pool that, on Windows,
 * can still be half-open when the build process tries to exit, tripping
 * a libuv assertion ("Assertion failed: !(handle->flags &
 * UV_HANDLE_CLOSING)", src\win\async.c:76) once this component became
 * the last page astro builds (so the socket's teardown races the
 * process's own). `agent: false` forces a one-off socket that's closed
 * at response end, instead of being handed back to a keep-alive pool —
 * deterministic teardown before the build process tries to exit.
 */
import https from "node:https";

const USER = "risukisu";

type Day = { date: string; count: number; level: 0 | 1 | 2 | 3 | 4; future?: boolean };

function getJson(url: string, timeoutMs: number): Promise<any> {
  return new Promise((resolve, reject) => {
    const req = https.get(url, { agent: false, headers: { accept: "application/json" } }, (res) => {
      const status = res.statusCode ?? 0;
      if (status < 200 || status >= 300) {
        res.resume(); // drain so the socket closes instead of dangling
        reject(new Error(String(status)));
        return;
      }
      const chunks: Buffer[] = [];
      res.on("data", (chunk) => chunks.push(chunk));
      res.on("end", () => {
        try {
          resolve(JSON.parse(Buffer.concat(chunks).toString("utf-8")));
        } catch (err) {
          reject(err);
        }
      });
      res.on("error", reject);
    });
    req.setTimeout(timeoutMs, () => req.destroy(new Error("timeout")));
    req.on("error", reject);
  });
}

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const iso = (t: number) => new Date(t).toISOString().slice(0, 10);
const today = iso(Date.now());
const YEAR = today.slice(0, 4);

let failed = false;
let yearTotal = 0;
const byDate = new Map<string, Day>();
try {
  const data = await getJson(`https://github-contributions-api.jogruber.de/v4/${USER}?y=${YEAR}`, 8000);
  for (const d of data.contributions as Day[]) byDate.set(d.date, d);
  if (typeof data.total?.[YEAR] === "number") yearTotal = data.total[YEAR];
} catch {
  failed = true;
}
if (!byDate.size) failed = true;

// The whole calendar year, Jan 1 → Dec 31; days after today are "future".
const days: Day[] = [];
for (let t = Date.UTC(Number(YEAR), 0, 1); iso(t).startsWith(YEAR); t += 86_400_000) {
  const date = iso(t);
  days.push(date > today ? { date, count: 0, level: 0, future: true } : byDate.get(date) ?? { date, count: 0, level: 0 });
}
if (!yearTotal) yearTotal = days.reduce((s, d) => s + d.count, 0);

// Week columns (Sunday-first), padding the first and last partial weeks
// so the weekday rows line up.
type Week = (Day | null)[];
const weeks: Week[] = [];
let week: Week = new Array(new Date(days[0].date).getUTCDay()).fill(null);
for (const d of days) {
  week.push(d);
  if (week.length === 7) {
    weeks.push(week);
    week = [];
  }
}
if (week.length) weeks.push([...week, ...new Array(7 - week.length).fill(null)]);

// Month label per week column — where the month changes.
const monthLabels: (string | null)[] = weeks.map((w, i) => {
  const first = w.find(Boolean) as Day | undefined;
  if (!first) return null;
  const m = Number(first.date.slice(5, 7)) - 1;
  if (i === 0) return MONTHS[m];
  const prev = weeks[i - 1].find(Boolean) as Day | undefined;
  return prev && Number(prev.date.slice(5, 7)) - 1 !== m ? MONTHS[m] : null;
});

// Two half-year strips, split where July's label starts.
const split = Math.max(1, monthLabels.indexOf(MONTHS[6]));
const halves = [
  { weeks: weeks.slice(0, split), labels: monthLabels.slice(0, split) },
  { weeks: weeks.slice(split), labels: monthLabels.slice(split) },
];

const fmt = (n: number) => n.toLocaleString("en-US");
const dayLabel = (d: Day) => {
  const [, mm, dd] = d.date.split("-");
  return `${Number(dd)} ${MONTHS[Number(mm) - 1]}: ${fmt(d.count)} contribution${d.count === 1 ? "" : "s"}`;
};

const GH_MARK =
  "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
---
<a class="graph" href={`https://github.com/${USER}`} rel="me">
  <div class="graph__head">
    <span class="graph__name">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d={GH_MARK} /></svg>
      GitHub
    </span>
    {!failed && <p class="graph__sum"><span class="graph__total">{fmt(yearTotal)}</span> contributions so far in {YEAR}</p>}
    <span class="graph__out" aria-hidden="true">↗</span>
  </div>

  {failed ? (
    <p class="graph__fail measure">contribution graph unavailable right now — see github.com/{USER}</p>
  ) : (
    <div class="graph__sheet" role="img" aria-label={`GitHub contributions in ${YEAR}: ${fmt(yearTotal)} so far`}>
      {halves.map((h) => (
        <div class="graph__half" style={`--cols:${h.weeks.length}`}>
          <div class="graph__months" aria-hidden="true">
            {h.labels.map((m, i) => m && <span style={`grid-column:${i + 1} / span 4`}>{m}</span>)}
          </div>
          <div class="graph__grid">
            {h.weeks.flatMap((w) =>
              w.map((d) => (
                <span
                  class:list={[
                    "graph__cell",
                    d ? (d.future ? "is-future" : `l${d.level}`) : "is-pad",
                    { "is-today": d?.date === today },
                  ]}
                  title={d && !d.future ? dayLabel(d) : undefined}
                ></span>
              )),
            )}
          </div>
        </div>
      ))}
    </div>
  )}

  <div class="graph__foot">
    {!failed && (
      <span class="graph__legend" aria-hidden="true">
        Less
        <span class="graph__key"></span>
        <span class="graph__key l1"></span>
        <span class="graph__key l2"></span>
        <span class="graph__key l3"></span>
        <span class="graph__key l4"></span>
        More
      </span>
    )}
    <span class="graph__where">github.com/{USER}</span>
  </div>
</a>

<style>
  /* Whole plate is one link to the GitHub profile. A size container, so
     the strips stack by the tile's own width, not the viewport's. */
  .graph {
    --canvas: #ffffff;
    --line: #d6dde5;
    --fg: var(--color-ink);
    --muted: var(--color-muted);
    --green: #297147; /* writing text hue */
    --now: #a5700c; /* work gold */
    --now-dim: rgb(165 112 12 / 0.3);
    --shadow: #2e7d4f; /* moss */
    --l0: #eaeef3;
    --l1: #b5d892;
    --l2: #76aa70;
    --l3: #377d51;
    --l4: #004f38;
    --pencil: rgb(21 50 78 / 0.2); /* days still to come */

    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    min-width: 0;
    padding: 14px 20px;
    background: var(--canvas);
    border: 2px solid var(--color-ink);
    box-shadow: 6px 6px 0 var(--shadow);
    color: var(--fg);
    text-decoration: none;
    transition: transform 0.18s cubic-bezier(0.3, 0.8, 0.3, 1),
      box-shadow 0.18s cubic-bezier(0.3, 0.8, 0.3, 1);
  }
  .graph:hover,
  .graph:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--shadow);
  }
  .graph:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }

  /* ── Head: name | the year in one sentence | ↗ ──────────────────── */
  .graph__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .graph__name {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.2rem;
  }
  .graph__name svg {
    position: relative;
    top: -1px; /* sit on the serif's x-height, not its descenders */
  }
  .graph__sum {
    margin: 0;
    max-width: none;
    padding-left: 14px;
    border-left: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--muted);
  }
  /* The total in the site's display serif, lining figures, at sentence
     size — it reads, it doesn't shout. */
  .graph__total {
    margin-right: 2px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    font-variant-numeric: lining-nums proportional-nums;
    color: var(--fg);
  }
  .graph__out {
    margin-left: auto;
    color: var(--fg);
    opacity: 0.6;
    transition: opacity 0.18s ease, transform 0.18s ease, color 0.18s ease;
  }
  .graph:hover .graph__out,
  .graph:focus-visible .graph__out {
    opacity: 1;
    color: var(--green);
    transform: translate(2px, -2px);
  }

  /* ── The sheet: two half-year strips, flexed by their week count so
     every cell comes out the same size, edge to edge. Set on the sheet,
     not on .graph, because a container query can't restyle the
     container itself. ─────────────────────────────────────────────── */
  .graph__sheet {
    --gap: 3px;
    display: flex;
    gap: var(--gap);
  }
  .graph__half {
    flex: var(--cols) 1 0;
    min-width: 0;
  }
  .graph__months,
  .graph__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gap);
  }
  .graph__months {
    margin-bottom: 4px;
    font-family: var(--font-sans);
    font-size: 10px;
    line-height: 1.2;
    color: var(--muted);
  }
  .graph__months span {
    grid-row: 1;
    white-space: nowrap;
  }
  .graph__grid {
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    row-gap: var(--gap);
  }

  .graph__cell,
  .graph__key {
    background: var(--l0);
  }
  .graph__cell {
    aspect-ratio: 1;
  }
  .l1 { background: var(--l1); }
  .l2 { background: var(--l2); }
  .l3 { background: var(--l3); }
  .l4 { background: var(--l4); }
  .is-future {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--pencil);
  }
  .is-pad {
    visibility: hidden;
  }

  /* Today, ringed — the build's "you are here". */
  .graph__cell.is-today {
    position: relative;
    z-index: 1;
    outline: 2px solid var(--now);
    outline-offset: 1px;
    animation: graph-today 2.4s ease-in-out infinite;
  }
  @keyframes graph-today {
    50% { outline-color: var(--now-dim); }
  }

  /* ── Foot: legend | where ───────────────────────────────────────── */
  .graph__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 16px;
  }
  .graph__legend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--muted);
  }
  .graph__key {
    width: 9px;
    height: 9px;
  }
  .graph__where {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--green);
    white-space: nowrap;
  }

  .graph__fail {
    margin: 0;
    color: var(--muted);
  }

  @container (max-width: 599px) {
    .graph__sheet {
      --gap: 2px;
    }
  }
  /* Phones: the two halves stack, so each strip gets the full width; the
     sentence takes its own row under the name. */
  @container (max-width: 480px) {
    .graph__sheet {
      flex-direction: column;
      gap: 10px;
    }
    .graph__sum {
      flex: 1 1 100%;
      order: 3;
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .graph,
    .graph:hover,
    .graph:focus-visible {
      transform: none;
      transition: box-shadow 0.2s ease;
    }
    .graph:hover .graph__out,
    .graph:focus-visible .graph__out {
      transform: none;
    }
    /* explicit: the global 0.01ms clamp would turn the loop into flicker */
    .graph__cell.is-today {
      animation: none;
    }
  }
</style>
