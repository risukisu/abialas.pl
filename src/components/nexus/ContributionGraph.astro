---
/**
 * GitHub contribution heatmap on the GitHub canvas (dark since
 * 2026-09-27, when it absorbed the retired GitHubTile): the GitHub
 * avatar — the steampunk squirrel, public/gh-avatar.webp — holds the
 * right of the plate, his black ground masked into it. The grid shows
 * the last six months (owner call 2026-09-27: a full year buried him),
 * sits left on a frosted-glass panel with solid cells and a stepped
 * green ramp, and its foot line (repos · legend) ends where it ends, so
 * nothing crosses him.
 *
 * Data: fetched at render time (build = "updates every deploy") from
 * the public jogruber contributions API; graceful note on failure so a
 * dead API can never break the build. The public-repo count (GitHub
 * API, the only other live fact) drops silently if unavailable.
 *
 * Fetched via a bare `node:https` GET, not the global `fetch` — Node's
 * bundled undici keeps its socket in a keep-alive pool that, on Windows,
 * can still be half-open when the build process tries to exit, tripping
 * a libuv assertion ("Assertion failed: !(handle->flags &
 * UV_HANDLE_CLOSING)", src\win\async.c:76) once this component became
 * the last page astro builds (so the socket's teardown races the
 * process's own). `agent: false` forces a one-off socket that's closed
 * at response end, instead of being handed back to a keep-alive pool —
 * deterministic teardown before the build process tries to exit.
 */
import https from "node:https";
import { fetchJson } from "../../lib/fetchJson";

const USER = "risukisu";

type Day = { date: string; count: number; level: 0 | 1 | 2 | 3 | 4 };

function getJson(url: string, timeoutMs: number): Promise<any> {
  return new Promise((resolve, reject) => {
    const req = https.get(url, { agent: false, headers: { accept: "application/json" } }, (res) => {
      const status = res.statusCode ?? 0;
      if (status < 200 || status >= 300) {
        res.resume(); // drain so the socket closes instead of dangling
        reject(new Error(String(status)));
        return;
      }
      const chunks: Buffer[] = [];
      res.on("data", (chunk) => chunks.push(chunk));
      res.on("end", () => {
        try {
          resolve(JSON.parse(Buffer.concat(chunks).toString("utf-8")));
        } catch (err) {
          reject(err);
        }
      });
      res.on("error", reject);
    });
    req.setTimeout(timeoutMs, () => req.destroy(new Error("timeout")));
    req.on("error", reject);
  });
}

let days: Day[] = [];
let total = 0;
let failed = false;

// Last six months (owner call 2026-09-27): the 1st of the month five
// months back → today (build time), so the labels read as six whole
// months ending in this one. `y=last` is the API's rolling 365 days, so
// the window can cross a new year.
const now = new Date();
const today = now.toISOString().slice(0, 10);
const since = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 5, 1)).toISOString().slice(0, 10);
try {
  const data = await getJson(`https://github-contributions-api.jogruber.de/v4/${USER}?y=last`, 8000);
  days = data.contributions.filter((d: Day) => d.date >= since && d.date <= today);
  total = days.reduce((s: number, d: Day) => s + d.count, 0);
  if (!days.length) failed = true;
} catch {
  failed = true;
}

// GITHUB_TOKEN (set in the deploy workflow) lifts the API from 60 to 1000 req/h.
const token = process.env.GITHUB_TOKEN;
let publicRepos: number | null = null;
try {
  const profile = await fetchJson<{ public_repos: number }>(
    `https://api.github.com/users/${USER}`,
    8000,
    token ? { authorization: `Bearer ${token}` } : {},
  );
  publicRepos = typeof profile.public_repos === "number" ? profile.public_repos : null;
} catch {
  publicRepos = null;
}

// Group into GitHub-style week columns (Sunday-first), padding the
// first partial week so weekday rows line up.
type Week = (Day | null)[];
const weeks: Week[] = [];
if (!failed && days.length) {
  let week: Week = new Array(new Date(days[0].date).getDay()).fill(null);
  for (const d of days) {
    week.push(d);
    if (week.length === 7) {
      weeks.push(week);
      week = [];
    }
  }
  if (week.length) weeks.push([...week, ...new Array(7 - week.length).fill(null)]);
}

// Month label per week column — labelled where the month changes.
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const monthLabels: (string | null)[] = weeks.map((w, i) => {
  const first = w.find(Boolean) as Day | undefined;
  if (!first) return null;
  const m = new Date(first.date).getMonth();
  if (i === 0) return MONTHS[m];
  const prev = weeks[i - 1].find(Boolean) as Day | undefined;
  return prev && new Date(prev.date).getMonth() !== m ? MONTHS[m] : null;
});
---
<a class="graph" href={`https://github.com/${USER}`} rel="me">
  <img class="graph__risu" src="/gh-avatar.webp" alt="" width="460" height="460" aria-hidden="true" decoding="async" />
  <span class="graph__scrim" aria-hidden="true"></span>
  {failed ? (
    <p class="graph__fail measure">contribution graph unavailable right now — see github.com/{USER}</p>
  ) : (
    <>
      <div class="graph__head">
        <span class="graph__total">{total.toLocaleString("en-US")} contributions in the last 6 months</span>
        <span class="graph__out" aria-hidden="true">↗</span>
      </div>
      <div class="graph__col">
      <div class="graph__scroll">
        <div class="graph__months" aria-hidden="true">
          {monthLabels.map((m) => <span class="graph__month">{m ?? ""}</span>)}
        </div>
        <div class="graph__grid" role="img" aria-label={`GitHub contribution heatmap: ${total} contributions in the last 6 months`}>
          {weeks.map((w) => (
            <div class="graph__week">
              {w.map((d) => (
                <span
                  class:list={["graph__cell", d && `l${d.level}`]}
                  title={d ? `${d.date}: ${d.count}` : undefined}
                ></span>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="graph__foot">
        <span class="graph__where">
          github.com/{USER}{publicRepos !== null && <span class="graph__count"> · {publicRepos} public repos</span>}
        </span>
        <span class="graph__legend measure" aria-hidden="true">
          Less
          <span class="graph__cell"></span>
          <span class="graph__cell l1"></span>
          <span class="graph__cell l2"></span>
          <span class="graph__cell l3"></span>
          <span class="graph__cell l4"></span>
          More
        </span>
      </div>
      </div>
    </>
  )}
</a>

<script>
  // Narrow screens scroll the weeks sideways: open on the latest ones.
  document.querySelectorAll<HTMLElement>(".graph__scroll").forEach((el) => {
    el.scrollLeft = el.scrollWidth;
  });
</script>

<style>
  /* Whole plate is one link to the GitHub profile. */
  .graph {
    --canvas: #0d1117; /* GitHub canvas */
    --fg: #f0f6fc;
    --muted: #8b949e;
    --green: #7ee787;
    --shadow: #2ea043; /* GitHub's success green — carried over from the retired GitHubTile */
    position: relative;
    display: block;
    width: fit-content;
    max-width: 100%;
    min-width: min(560px, 100%);
    background: var(--canvas);
    border: 2px solid var(--color-ink);
    box-shadow: 6px 6px 0 var(--shadow);
    padding: 20px 22px;
    text-decoration: none;
    color: var(--fg);
    overflow: hidden;
    transition: transform 0.18s cubic-bezier(0.3, 0.8, 0.3, 1),
      box-shadow 0.18s cubic-bezier(0.3, 0.8, 0.3, 1);
  }

  .graph:hover,
  .graph:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--shadow);
  }

  .graph:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .graph,
    .graph:hover,
    .graph:focus-visible {
      transform: none;
      transition: box-shadow 0.2s ease;
    }
    .graph:hover .graph__out,
    .graph:focus-visible .graph__out {
      transform: none;
    }
  }

  /* The squirrel — full plate height, anchored right, behind the most
     recent weeks. His near-black ground melts into the canvas; the mask
     feathers his left edge so the frame never shows. Hover lifts him a
     step: feedback, not a bounce. */
  .graph__risu {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: auto;
    aspect-ratio: 1;
    object-fit: cover;
    opacity: 0.9;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 30%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 30%, #000 100%);
    pointer-events: none;
    user-select: none;
    transition: opacity 0.25s ease;
  }
  .graph:hover .graph__risu,
  .graph:focus-visible .graph__risu {
    opacity: 1;
  }

  /* Scrim: clean canvas under the older months, thinning toward him. */
  .graph__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(13 17 23 / 0.9) 0%,
      rgb(13 17 23 / 0.75) 40%,
      transparent 68%
    );
    pointer-events: none;
  }

  .graph__head,
  .graph__col,
  .graph__fail {
    position: relative; /* above the squirrel */
  }

  .graph__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }

  .graph__total {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.15rem;
    color: var(--fg);
  }

  .graph__out {
    color: var(--fg);
    opacity: 0.6;
    text-shadow: 0 0 6px var(--canvas);
    transition: opacity 0.18s ease, transform 0.18s ease, color 0.18s ease;
  }
  .graph:hover .graph__out,
  .graph:focus-visible .graph__out {
    opacity: 1;
    color: var(--green);
    transform: translate(2px, -2px);
  }

  /* The grid's column: as wide as six months of weeks, so the foot line
     (repos · legend) ends where the grid ends and he keeps the right. */
  .graph__col {
    width: fit-content;
    max-width: 100%;
  }

  /* The glass: blur + a dark tint between him and the data. */
  .graph__scroll {
    overflow-x: auto;
    padding: 10px 0 12px 12px; /* right edge lives on the rows, see below */
    background: rgb(13 17 23 / 0.82);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgb(240 246 252 / 0.12);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .graph__scroll {
      background: rgb(13 17 23 / 0.94);
    }
  }

  /* max-content + right padding on the rows themselves: a scroll
     container drops its own end padding, so this keeps the last week
     off the glass edge when scrolled all the way right. */
  .graph__months,
  .graph__grid {
    width: max-content;
    padding-right: 12px;
  }

  .graph__months {
    display: flex;
    gap: 4px;
    margin-bottom: 4px;
  }

  .graph__month {
    width: 13px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    color: #9da7b3;
    overflow: visible;
    white-space: nowrap;
  }

  .graph__grid {
    display: flex;
    gap: 4px;
  }

  .graph__week {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Solid cells. GitHub's dark ramp, lifted so each level is a clear
     step (its first two sit too close to the canvas); empty cells a
     visible slate with a hairline edge. */
  .graph__cell {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    background: #232a33;
    box-shadow: inset 0 0 0 1px rgb(240 246 252 / 0.05);
  }

  .graph__cell.l1 { background: #1a6334; box-shadow: none; }
  .graph__cell.l2 { background: #23974a; box-shadow: none; }
  .graph__cell.l3 { background: #36c95c; box-shadow: none; }
  .graph__cell.l4 { background: #7ef29a; box-shadow: none; }

  .graph__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 10px;
  }

  .graph__where {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--green);
  }
  .graph__count {
    color: var(--muted);
  }

  .graph__legend {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    color: var(--muted);
    text-shadow: 0 0 4px var(--canvas), 0 0 2px var(--canvas);
  }

  .graph__fail {
    margin: 0;
    color: var(--muted);
  }

  /* Phones: the grid scrolls sideways, so he steps back into the corner. */
  @media (max-width: 720px) {
    .graph__risu {
      top: auto;
      bottom: 0;
      height: 80%;
      opacity: 0.45;
    }
  }
</style>
