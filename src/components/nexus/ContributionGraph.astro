---
import https from "node:https";

/**
 * LAB — GitHub contribution heatmap, light-themed to the site.
 *
 * Data: fetched at render time (build = "updates every deploy") from
 * the public jogruber contributions API; graceful note on failure so a
 * dead API can never break the build. Level ramp ends at the site's
 * moss (#2E7D4F) — GitHub-recognizable, palette-native.
 *
 * Fetched via a bare `node:https` GET, not the global `fetch` — Node's
 * bundled undici keeps its socket in a keep-alive pool that, on Windows,
 * can still be half-open when the build process tries to exit, tripping
 * a libuv assertion ("Assertion failed: !(handle->flags &
 * UV_HANDLE_CLOSING)", src\win\async.c:76) once this component became
 * the last page astro builds (so the socket's teardown races the
 * process's own). `https.get` + explicit `req.destroy()`/response `end`
 * leaves no lingering async handle at exit.
 */
type Day = { date: string; count: number; level: 0 | 1 | 2 | 3 | 4 };

function getJson(url: string, timeoutMs: number): Promise<any> {
  return new Promise((resolve, reject) => {
    const req = https.get(url, { headers: { accept: "application/json" } }, (res) => {
      const status = res.statusCode ?? 0;
      if (status < 200 || status >= 300) {
        res.resume(); // drain so the socket closes instead of dangling
        reject(new Error(String(status)));
        return;
      }
      const chunks: Buffer[] = [];
      res.on("data", (chunk) => chunks.push(chunk));
      res.on("end", () => {
        try {
          resolve(JSON.parse(Buffer.concat(chunks).toString("utf-8")));
        } catch (err) {
          reject(err);
        }
      });
      res.on("error", reject);
    });
    req.setTimeout(timeoutMs, () => req.destroy(new Error("timeout")));
    req.on("error", reject);
  });
}

let days: Day[] = [];
let total = 0;
let failed = false;

// Calendar-year view (owner call): Jan 2026 → today, not a rolling
// 12 months. The API returns the full year with zero-count future
// days — trim to today so the graph ends at "now" (build time).
const YEAR = "2026";
try {
  const data = await getJson(`https://github-contributions-api.jogruber.de/v4/risukisu?y=${YEAR}`, 8000);
  const today = new Date().toISOString().slice(0, 10);
  days = data.contributions.filter((d: Day) => d.date <= today);
  total = data.total?.[YEAR] ?? days.reduce((s: number, d: Day) => s + d.count, 0);
} catch {
  failed = true;
}

// Group into GitHub-style week columns (Sunday-first), padding the
// first partial week so weekday rows line up.
type Week = (Day | null)[];
const weeks: Week[] = [];
if (!failed && days.length) {
  let week: Week = new Array(new Date(days[0].date).getDay()).fill(null);
  for (const d of days) {
    week.push(d);
    if (week.length === 7) {
      weeks.push(week);
      week = [];
    }
  }
  if (week.length) weeks.push([...week, ...new Array(7 - week.length).fill(null)]);
}

// Month label per week column — labelled where the month changes.
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const monthLabels: (string | null)[] = weeks.map((w, i) => {
  const first = w.find(Boolean) as Day | undefined;
  if (!first) return null;
  const m = new Date(first.date).getMonth();
  if (i === 0) return MONTHS[m];
  const prev = weeks[i - 1].find(Boolean) as Day | undefined;
  return prev && new Date(prev.date).getMonth() !== m ? MONTHS[m] : null;
});
---
<a class="graph" href="https://github.com/risukisu" rel="me">
  {failed ? (
    <p class="graph__fail measure">contribution graph unavailable right now — see github.com/risukisu</p>
  ) : (
    <>
      <div class="graph__head">
        <span class="graph__total">{total.toLocaleString("en-US")} contributions in {YEAR}</span>
        <span class="measure graph__gh">github ↗</span>
      </div>
      <div class="graph__scroll">
        <div class="graph__months" aria-hidden="true">
          {monthLabels.map((m) => <span class="graph__month">{m ?? ""}</span>)}
        </div>
        <div class="graph__grid" role="img" aria-label={`GitHub contribution heatmap: ${total} contributions in the last year`}>
          {weeks.map((w) => (
            <div class="graph__week">
              {w.map((d) => (
                <span
                  class:list={["graph__cell", d && `l${d.level}`]}
                  title={d ? `${d.date}: ${d.count}` : undefined}
                ></span>
              ))}
            </div>
          ))}
        </div>
        <div class="graph__legend measure" aria-hidden="true">
          Less
          <span class="graph__cell"></span>
          <span class="graph__cell l1"></span>
          <span class="graph__cell l2"></span>
          <span class="graph__cell l3"></span>
          <span class="graph__cell l4"></span>
          More
        </div>
      </div>
    </>
  )}
</a>

<style>
  /* Whole plate is one link to the GitHub profile. fit-content: a
     calendar-year view is part-empty until December — hug the weeks
     instead of dragging a half-blank plate across the container. */
  .graph {
    display: block;
    width: fit-content;
    max-width: 100%;
    min-width: min(560px, 100%);
    background: #fff;
    border: 2px solid var(--color-ink);
    box-shadow: 6px 6px 0 var(--color-ink);
    padding: 20px 22px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s cubic-bezier(0.3, 0.8, 0.3, 1),
      box-shadow 0.18s cubic-bezier(0.3, 0.8, 0.3, 1);
  }

  .graph:hover,
  .graph:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--color-ink);
  }

  .graph:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .graph,
    .graph:hover,
    .graph:focus-visible {
      transform: none;
      transition: box-shadow 0.2s ease;
    }
  }

  .graph__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .graph__total {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.15rem;
    color: var(--color-ink);
  }

  .graph__gh {
    color: var(--color-muted);
  }
  .graph:hover .graph__gh,
  .graph:focus-visible .graph__gh {
    color: var(--color-accent);
  }

  .graph__scroll {
    overflow-x: auto;
  }

  .graph__months {
    display: flex;
    gap: 4px;
    margin-bottom: 4px;
  }

  .graph__month {
    width: 13px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
    overflow: visible;
    white-space: nowrap;
  }

  .graph__grid {
    display: flex;
    gap: 4px;
  }

  .graph__week {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .graph__cell {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    background: rgb(21 50 78 / 0.07);
  }

  .graph__cell.l1 { background: #bfdccb; }
  .graph__cell.l2 { background: #8cc3a4; }
  .graph__cell.l3 { background: #55a47b; }
  .graph__cell.l4 { background: #2e7d4f; }

  .graph__legend {
    display: flex;
    align-items: center;
    gap: 4px;
    justify-content: flex-end;
    margin-top: 10px;
    color: var(--color-muted);
  }

  .graph__fail {
    margin: 0;
    color: var(--color-muted);
  }
</style>
