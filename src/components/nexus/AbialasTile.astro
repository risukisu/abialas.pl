---
/**
 * AbialasTile — abialas.pl, this site (MOCKUP for /projects, owner
 * 2026-09-29). Still on purpose (owner: a mix of moving and still tiles).
 *
 * Kit: the Drafting Table itself: mist paper with the blueprint grid, ink
 * lines, Newsreader for the name, mono measures, the vermilion accent.
 *
 * How it stands out without moving:
 * - the spectrum gradient as its shadow, the only tile that wears it,
 *   because it is the site's own
 * - the home page in miniature, laid on the paper like a print (-1.5°):
 *   the masthead and every home tile in its own ground and shadow hue, today
 *   ringed on the GitHub year
 * - drafting marks: a vermilion dimension line over the sheet, 1200 (the
 *   site's container width, .container in global.css), and a "you are here"
 *   pin, because you are
 */
const HREF = "https://abialas.pl";

type Mark = [number, number, number, number, string];
type Mini = { x: number; y: number; w: number; h: number; ground: string; shadow: string; dashed?: boolean; year?: boolean; marks?: Mark[] };
// the home tiles: grounds and shadows are each component's own
const TILES: Mini[] = [
  { x: 10, y: 64, w: 126, h: 16, ground: "#0c2a20", shadow: "#b85a1f", marks: [[4, 4, 8, 8, "#e8763a"], [16, 5, 40, 2, "#f4efe3"], [16, 9, 60, 2, "#6fbf8f"]] },
  { x: 140, y: 64, w: 92, h: 16, ground: "#0b0e0c", shadow: "#23915a", marks: [[4, 5, 4, 4, "#c2652b"], [11, 5, 18, 2, "#e9ebe3"], [4, 11, 26, 2, "#3fd68c"]] },
  { x: 236, y: 64, w: 76, h: 7, ground: "#0a66c2", shadow: "#a5700c", marks: [[3, 2, 22, 2, "#ffffff"]] },
  { x: 236, y: 73, w: 76, h: 7, ground: "#000000", shadow: "#2a52b3", marks: [[3, 2, 6, 2, "#ffffff"]] },
  { x: 10, y: 84, w: 212, h: 20, ground: "#ffffff", shadow: "#2e7d4f", year: true },
  { x: 226, y: 84, w: 86, h: 20, ground: "#fbfaf6", shadow: "#c2652b", marks: [[4, 4, 30, 4, "#1a1a1a"], [4, 10, 22, 4, "#1a1a1a"], [64, 9, 8, 6, "#c2652b"]] },
  { x: 10, y: 108, w: 186, h: 14, ground: "#0e100d", shadow: "#2b9d68", marks: [[4, 4, 3, 3, "#3fd68c"], [10, 4, 36, 2, "#e9ebe3"], [120, 3, 56, 8, "#1f241c"]] },
  { x: 200, y: 108, w: 112, h: 14, ground: "#151813", shadow: "#0e8fa6", marks: [[4, 4, 3, 3, "#e8a13d"], [10, 4, 26, 2, "#e9ebe3"], [4, 9, 60, 2, "#7c8cf0"]] },
  { x: 10, y: 126, w: 149, h: 14, ground: "#ffffff", shadow: "#c22d18", marks: [[4, 2, 10, 10, "#dfe5ec"], [18, 4, 40, 2, "#15324e"], [18, 8, 60, 2, "#9aa7b4"]] },
  { x: 163, y: 126, w: 149, h: 14, ground: "#f4f8fd", shadow: "#2257d6", dashed: true, marks: [[100, 3, 30, 8, "#c9d7f2"]] },
];

// the GitHub year: 52 weeks x 3 rows, the past in the moss ramp (a fixed
// pattern), the rest as empty pencil squares; today (week 39) ringed in gold
const RAMP = ["#eaeef3", "#c6e7c8", "#8bcf93", "#3f9d5f", "#004f38"];
const TODAY = { w: 39, r: 1 };
const year = Array.from({ length: 52 * 3 }, (_, i) => {
  const w = i % 52, r = Math.floor(i / 52);
  const past = w < TODAY.w || (w === TODAY.w && r <= TODAY.r);
  const lvl = w === TODAY.w && r === TODAY.r ? 3 : past ? [0, 1, 1, 2, 3, 1, 2, 4, 0, 2][(w * 7 + r * 3) % 10] : -1;
  return { x: 13 + w * 4, y: 88 + r * 4, lvl };
});
const today = { x: 13 + TODAY.w * 4, y: 88 + TODAY.r * 4 };
---
<a href={HREF} class="ab" rel="me">
  <span class="ab__shadow" aria-hidden="true"></span>
  <span class="ab__plate">
    <span class="ab__head">
      <span class="ab__wm">abialas.pl</span>
      <span class="ab__ver">v0.2.0 · Astro</span>
      <span class="ab__out" aria-hidden="true">↗</span>
    </span>

    <svg class="ab__art" viewBox="0 0 322 172" aria-hidden="true">
      <defs>
        <linearGradient id="ab-spectrum" x1="0" x2="1">
          <stop offset="0" stop-color="#de3c26" />
          <stop offset="0.33" stop-color="#a5700c" />
          <stop offset="0.66" stop-color="#2e7d4f" />
          <stop offset="1" stop-color="#2257d6" />
        </linearGradient>
        <marker id="ab-tick" viewBox="0 0 6 6" refX="3" refY="3" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M3 0v6" stroke="#c22d18" stroke-width="1.2" />
        </marker>
      </defs>

      <!-- the dimension line: the sheet is the site's 1200px container -->
      <line x1="4" y1="9" x2="318" y2="9" stroke="#c22d18" stroke-width="0.8" marker-start="url(#ab-tick)" marker-end="url(#ab-tick)" />
      <rect x="141" y="3" width="40" height="11" fill="#f4f7fa" />
      <text class="ab__dim" x="161" y="11.5" text-anchor="middle">1200</text>
      <line x1="4" y1="12" x2="4" y2="20" stroke="#c22d18" stroke-width="0.6" stroke-dasharray="1.5 1.5" />
      <line x1="318" y1="12" x2="318" y2="20" stroke="#c22d18" stroke-width="0.6" stroke-dasharray="1.5 1.5" />

      <!-- the print, laid on the paper -->
      <g transform="translate(0 22) rotate(-1.5 161 73)">
        <rect x="3" y="3" width="321" height="145" fill="rgb(21 50 78 / 0.12)" />
        <rect x="0.5" y="0.5" width="321" height="145" fill="#fff" stroke="#15324e" />
        <rect x="1" y="1" width="320" height="11" fill="#e9edf2" />
        <rect x="1" y="12" width="320" height="2" fill="url(#ab-spectrum)" />
        <circle cx="7" cy="6.5" r="2" fill="#2e7d4f" />
        <text class="ab__url" x="13" y="9">abialas.pl</text>
        <text class="ab__time" x="314" y="9" text-anchor="end">rebuilt 05:00 UTC</text>
        <rect x="10" y="18" width="5" height="5" fill="#c2652b" />
        <rect x="18" y="19.5" width="38" height="2" fill="#26384a" />
        {[262, 280, 298].map((x) => <rect x={x} y="19.5" width="13" height="2" fill="#26384a" />)}

        <text class="ab__h1" x="12" y="41">Hi, I'm Andrzej. I do marketing.</text>
        <rect x="12" y="45" width="34" height="3" fill="url(#ab-spectrum)" />
        <rect x="12" y="51" width="150" height="2" fill="#9aa7b4" />
        <rect x="12" y="55" width="112" height="2" fill="#9aa7b4" />
        <g transform="rotate(2 296 39)">
          <rect x="287" y="30" width="24" height="24" fill="#7a4a9e" />
          <rect x="285" y="28" width="24" height="24" fill="#dfe5ec" stroke="#15324e" />
          <circle cx="297" cy="37" r="4.5" fill="#9aa7b4" />
          <rect x="290" y="43" width="14" height="9" fill="#9aa7b4" />
          <rect x="302" y="33" width="4" height="4" fill="#c2652b" />
        </g>

        {TILES.map((t) => (
          <g>
            <rect x={t.x + 2} y={t.y + 2} width={t.w} height={t.h} fill={t.shadow} />
            <rect x={t.x + 0.5} y={t.y + 0.5} width={t.w - 1} height={t.h - 1} fill={t.ground} stroke={t.dashed ? t.shadow : "#15324e"} stroke-dasharray={t.dashed ? "2 1.5" : undefined} />
            {(t.marks ?? []).map(([x, y, w, h, c]) => <rect x={t.x + x} y={t.y + y} width={w} height={h} fill={c} />)}
            {t.year && year.map((c) => (
              c.lvl < 0
                ? <rect x={c.x + 0.25} y={c.y + 0.25} width="2.5" height="2.5" fill="none" stroke="#cfd8e3" stroke-width="0.5" />
                : <rect x={c.x} y={c.y} width="3" height="3" fill={RAMP[c.lvl]} />
            ))}
          </g>
        ))}
        <rect x={today.x - 1} y={today.y - 1} width="5" height="5" fill="none" stroke="#a5700c" stroke-width="1" />

        <!-- you are here -->
        <g transform="translate(200 30)">
          <path d="M0 22 L-6 10 A7 7 0 1 1 6 10 Z" fill="#c22d18" stroke="#15324e" stroke-width="1" />
          <circle cx="0" cy="5" r="2.6" fill="#fff" />
          <rect x="10" y="-1" width="58" height="12" fill="#c22d18" />
          <text class="ab__here" x="39" y="7.5" text-anchor="middle">YOU ARE HERE</text>
        </g>
      </g>
    </svg>
  </span>
</a>

<style>
  /* the plate sits on a spectrum "shadow": a gradient block offset behind it
     (box-shadow can't take a gradient) */
  .ab {
    position: relative;
    display: grid;
    min-width: 0;
    text-decoration: none;
    color: var(--color-body);
    transition: transform 0.18s cubic-bezier(0.3, 0.8, 0.3, 1);
  }
  .ab__shadow {
    position: absolute;
    inset: 0;
    background: var(--gradient-spectrum);
    transform: translate(6px, 6px);
    transition: transform 0.18s cubic-bezier(0.3, 0.8, 0.3, 1);
  }
  .ab__plate {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: 20px 22px;
    background-color: #f4f7fa;
    background-image:
      linear-gradient(rgb(21 50 78 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(21 50 78 / 0.07) 1px, transparent 1px);
    background-size: 28px 28px;
    border: 2px solid var(--color-ink);
  }
  .ab:hover,
  .ab:focus-visible {
    transform: translate(-2px, -2px);
  }
  .ab:hover .ab__shadow,
  .ab:focus-visible .ab__shadow {
    transform: translate(8px, 8px);
  }
  .ab:focus-visible {
    outline: none;
  }
  .ab:focus-visible .ab__plate {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .ab__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .ab__wm {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--color-ink);
  }
  .ab__ver {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .ab__out {
    margin-left: auto;
    color: var(--color-muted);
    transition: color 0.18s ease, transform 0.18s ease;
  }
  .ab:hover .ab__out,
  .ab:focus-visible .ab__out {
    color: var(--color-accent);
    transform: translate(2px, -2px);
  }

  .ab__art {
    display: block;
    width: 100%;
    height: auto;
    margin-top: auto;
  }
  .ab__dim,
  .ab__url,
  .ab__time,
  .ab__here {
    font-family: var(--font-mono);
    font-size: 6.5px;
  }
  .ab__dim { fill: #c22d18; font-size: 7.5px; font-weight: 600; }
  .ab__url { fill: #15324e; }
  .ab__time { fill: #5f7384; }
  .ab__here { fill: #fff; font-weight: 700; font-size: 6px; letter-spacing: 0.06em; }
  .ab__h1 {
    font-family: var(--font-serif);
    font-size: 10.5px;
    fill: #15324e;
  }

  @media (prefers-reduced-motion: reduce) {
    .ab,
    .ab__shadow,
    .ab__out {
      transition: none;
    }
    .ab:hover,
    .ab:focus-visible {
      transform: none;
    }
    .ab:hover .ab__shadow,
    .ab:focus-visible .ab__shadow {
      transform: translate(6px, 6px);
    }
    .ab:hover .ab__out {
      transform: none;
    }
  }
</style>
