---
/**
 * MarketingSkillsRepoTile — the small companion to MarketingSkillsTile,
 * straight to the repository. Same os-schematic world, on the kit's
 * Panel surface (#151813, "the few filled areas: terminal blocks").
 *
 * The content IS the install: the two lines the README ships (verbatim,
 * README.md "Install" — clone + install.ps1), plus the kit's own licence
 * line ("MIT · no API keys needed to start", brand/source/hero.html).
 * The head wears the GitHub mark in the kit amber (owner call 2026-09-28;
 * it replaced the amber category square), so the door reads as GitHub.
 * Nothing animates here; the big tile owns the motion.
 */
const GH_MARK =
  "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
---
<a href="https://github.com/risukisu/marketing-skills" class="mskr" rel="me">
  <span class="mskr__head">
    <svg class="mskr__gh" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d={GH_MARK} /></svg>
    <span class="mskr__name">the repo</span>
    <span class="mskr__out" aria-hidden="true">↗</span>
  </span>

  <span class="mskr__term" aria-label="Install: git clone the repository, then run install.ps1">
    <span class="mskr__ln"><span class="mskr__p">$</span> git clone …/marketing-skills</span>
    <span class="mskr__ln"><span class="mskr__p">$</span> .\install.ps1</span>
  </span>

  <span class="mskr__lic">MIT · no API keys needed to start</span>
  <span class="mskr__where">github.com/risukisu/marketing-skills</span>
</a>

<style>
  .mskr {
    --panel: #151813;
    --line: #262b23;
    --ink: #e9ebe3;
    --muted: #b4bab0;
    --dim-text: #7d8478;
    --green: #3fd68c;
    --amber: #e8a13d;
    --blue: #7c8cf0;

    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px;
    --shadow: #0e8fa6; /* the statusline tile's toned cyan (owner, 2026-09-28; was kit amber #b37b26) */
    background: var(--panel);
    border: 2px solid var(--color-ink);
    box-shadow: 4px 4px 0 var(--shadow);
    color: var(--muted);
    text-decoration: none;
    transition: transform 0.18s cubic-bezier(0.3, 0.8, 0.3, 1),
      box-shadow 0.18s cubic-bezier(0.3, 0.8, 0.3, 1);
  }

  .mskr:hover,
  .mskr:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--shadow);
  }

  .mskr:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }

  .mskr__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mskr__gh {
    width: 16px;
    height: 16px;
    flex: none;
    fill: var(--amber); /* category 02 hue — marks this as the other door */
  }

  .mskr__name {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .mskr__out {
    margin-left: auto;
    color: var(--dim-text);
    transition: color 0.18s ease, transform 0.18s ease;
  }
  .mskr:hover .mskr__out,
  .mskr:focus-visible .mskr__out {
    color: var(--amber);
    transform: translate(2px, -2px);
  }

  /* the terminal block — hairline-ruled, not a card */
  .mskr__term {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .mskr__ln {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mskr__p {
    color: var(--blue); /* kit: shell prompts are blue */
    margin-right: 2px;
  }

  .mskr__lic {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
  }

  .mskr__where {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--dim-text);
    transition: color 0.18s ease;
  }
  .mskr:hover .mskr__where,
  .mskr:focus-visible .mskr__where {
    color: var(--amber);
  }

  @media (prefers-reduced-motion: reduce) {
    .mskr,
    .mskr:hover,
    .mskr:focus-visible {
      transform: none;
      transition: box-shadow 0.2s ease;
    }
    .mskr:hover .mskr__out,
    .mskr:focus-visible .mskr__out {
      transform: none;
    }
  }
</style>
