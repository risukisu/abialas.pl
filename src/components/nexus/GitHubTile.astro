---
/**
 * GitHubTile — the dark GitHub sticker with a point of view instead of a
 * repo list (owner feedback 2026-09-21: "a list of projects is not
 * helpful"). The GitHub avatar itself — the steampunk squirrel from
 * github.com/risukisu (public/gh-avatar.webp, 460px) — fills the right
 * half; its near-black ground is masked off into the plate so only the
 * squirrel and his glow remain, and a scrim keeps the text readable.
 *
 * Copy: the lead line is the library README's own
 * ("every marketer has a GitHub in 2026", README.md, /beautify-github-readme
 * row); the rest is this site's voice, no numbers invented. The only live
 * fact is the public-repo count, fetched at build time (daily rebuild),
 * dropped silently if the API is unavailable.
 */
import { fetchJson } from "../../lib/fetchJson";

const USER = "risukisu";
const token = process.env.GITHUB_TOKEN;
const auth = token ? { authorization: `Bearer ${token}` } : {};

let publicRepos: number | null = null;
try {
  const profile = await fetchJson<{ public_repos: number }>(`https://api.github.com/users/${USER}`, 8000, auth);
  publicRepos = typeof profile.public_repos === "number" ? profile.public_repos : null;
} catch {
  publicRepos = null;
}
---
<a href={`https://github.com/${USER}`} class="gh" rel="me">
  <img class="gh__risu" src="/gh-avatar.webp" alt="" width="460" height="460" aria-hidden="true" decoding="async" />
  <span class="gh__scrim" aria-hidden="true"></span>

  <span class="gh__row">
    <span class="gh__name">GitHub</span>
    <span class="gh__out" aria-hidden="true">↗</span>
  </span>

  <span class="gh__lead">Every marketer has a GitHub in 2026.</span>
  <span class="gh__desc">
    Mine is where the marketing gets built — the skills, the sites, the
    small tools, this page itself. Public by default, sawdust left in.
  </span>

  <span class="gh__where">
    github.com/{USER}{publicRepos !== null && <span class="gh__count"> · {publicRepos} public repos</span>}
  </span>
</a>

<style>
  .gh {
    --shadow: #2ea043; /* GitHub's own success green — owner's shadow-hue pass 2026-09-21 */
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    background: #0d1117; /* GitHub canvas */
    border: 2px solid var(--color-ink);
    box-shadow: 4px 4px 0 var(--shadow);
    color: #f0f6fc;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.18s cubic-bezier(0.3, 0.8, 0.3, 1),
      box-shadow 0.18s cubic-bezier(0.3, 0.8, 0.3, 1);
  }

  .gh:hover,
  .gh:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--shadow);
  }

  .gh:focus-visible {
    outline: 2px solid #7ee787;
    outline-offset: 3px;
  }

  /* The avatar — full plate height, anchored right. The picture's own
     near-black ground disappears into the canvas; the mask only feathers
     its left/top/bottom edges so the frame never shows. Hover lifts the
     opacity a step: feedback, not a bounce. */
  .gh__risu {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: auto;
    aspect-ratio: 1;
    object-fit: cover;
    opacity: 0.72;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 34%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 34%, #000 100%);
    pointer-events: none;
    user-select: none;
    transition: opacity 0.25s ease;
  }
  .gh:hover .gh__risu,
  .gh:focus-visible .gh__risu {
    opacity: 0.9;
  }

  /* Left-to-right scrim under the words — same idiom the old
     constellation tile used. */
  .gh__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(13 17 23 / 0.92) 0%,
      rgb(13 17 23 / 0.8) 42%,
      rgb(13 17 23 / 0.35) 62%,
      transparent 80%
    );
    pointer-events: none;
  }

  .gh__row,
  .gh__lead,
  .gh__desc,
  .gh__where {
    position: relative; /* above the squirrel */
  }

  .gh__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .gh__name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.3rem;
  }

  .gh__out {
    color: #f0f6fc;
    opacity: 0.6;
    transition: opacity 0.18s ease, transform 0.18s ease, color 0.18s ease;
  }
  .gh:hover .gh__out,
  .gh:focus-visible .gh__out {
    opacity: 1;
    color: #7ee787;
    transform: translate(2px, -2px);
  }

  .gh__lead {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.35;
    color: #7ee787;
    max-width: 26ch;
  }

  .gh__desc {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #c9d1d9;
    max-width: 40ch;
  }

  .gh__where {
    margin-top: auto;
    padding-top: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: #7ee787;
  }
  .gh__count {
    color: #8b949e;
  }

  /* Phones: the words span the whole plate, so the squirrel steps back
     into the lower-right corner and the scrim runs edge to edge. */
  @media (max-width: 720px) {
    .gh__risu {
      top: auto;
      bottom: 0;
      height: 72%;
      opacity: 0.5;
    }
    .gh:hover .gh__risu,
    .gh:focus-visible .gh__risu {
      opacity: 0.62;
    }
    .gh__scrim {
      background: linear-gradient(
        90deg,
        rgb(13 17 23 / 0.94) 0%,
        rgb(13 17 23 / 0.82) 55%,
        rgb(13 17 23 / 0.45) 100%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gh,
    .gh:hover,
    .gh:focus-visible {
      transform: none;
      transition: box-shadow 0.2s ease;
    }
    .gh:hover .gh__out,
    .gh:focus-visible .gh__out {
      transform: none;
    }
  }
</style>
