  /* ── the art panel ──────────────────────────────────────────────── */
  .art {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 150px;
    border-left: 1px solid var(--line);
    padding-left: 14px;
    box-sizing: border-box;
  }

  /* whole-group window: a skill's piece shows only while its pair is on */
  .art__on {
    opacity: 0;
    animation: mska-on var(--loop) ease-out infinite backwards;
    animation-delay: calc(var(--i) * var(--hold));
  }
  @keyframes mska-on {
    0% { opacity: 0; }
    2% { opacity: 1; }
    18.6% { opacity: 1; }
    20% { opacity: 0; }
    100% { opacity: 0; }
  }
  /* build steps inside a window: each piece arrives --d after the pair */
  .b {
    opacity: 0;
    animation: mska-in var(--loop) ease-out infinite;
    animation-delay: calc(var(--i) * var(--hold) + var(--d, 0s));
  }
  @keyframes mska-in {
    0% { opacity: 0; }
    1.2% { opacity: 1; }
    19% { opacity: 1; }
    20% { opacity: 0; }
    100% { opacity: 0; }
