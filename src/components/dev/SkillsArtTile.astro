    .msk__line[style^="--i:0"],
    .art__on[style^="--i:0"],
    .art__on[style^="--i:0"] .b {
      opacity: 1;
      clip-path: none;
    }
    .art__on[style^="--i:0"] .w__erase,
    .art__on[style^="--i:0"] .w__ripple {
      opacity: 0;
    }
  }
