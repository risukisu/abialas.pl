  }

  /* work */
  .w__frame {
    fill: none;
    stroke: #4a5146;
    stroke-width: 0.9;
  }
  .w__bg {
    fill: var(--ground);
  }
  .w__panel {
    fill: var(--panel);
  }
  .w__dim {
    fill: #4a5146;
  }
  .w__ink2 {
    fill: #454b41;
  }
  .w__txt {
    fill: #343a31;
  }
  .w__block {
    fill: #1e221b;
    stroke: #353b32;
    stroke-width: 0.8;
  }
  .w__card {
    fill: #181b15;
    stroke: #353b32;
    stroke-width: 0.8;
  }
  .w__hue {
    fill: var(--c);
  }
  .w__ink {
    fill: #9aa194;
  }
  .w__ring {
    fill: none;
    stroke: var(--c);
    stroke-width: 0.8;
  }
  .w__lead {
    fill: none;
    stroke: var(--c);
    stroke-width: 0.8;
    stroke-dasharray: 2 3;
  }
  .w__spoke {
    fill: none;
    stroke: #353b32;
    stroke-width: 0.9;
  }
  .w__flow {
    fill: none;
    stroke: var(--c);
    stroke-width: 1.2;
    stroke-dasharray: 7 12;
    animation-name: mska-in, mska-flow;
    animation-duration: var(--loop), 1.6s;
    animation-timing-function: ease-out, linear;
    animation-iteration-count: infinite;
    animation-delay: calc(var(--i) * var(--hold) + var(--d, 0s)), 0s;
  }
  @keyframes mska-flow {
    to { stroke-dashoffset: -19; }
  }
  .w__dot {
    fill: #454c42;
  }
  .w__erase {
    fill: var(--ground);
  }
  .w__new {
    fill: #9aa194;
  }
  .w__cta {
    fill: var(--ground);
  }
  .w__ripple {
    fill: none;
    stroke: var(--c);
    stroke-width: 0.9;
    transform-box: fill-box;
    transform-origin: center;
    animation-name: mska-ripple;
  }
  @keyframes mska-ripple {
    0% { opacity: 0.9; transform: scale(1); }
    4% { opacity: 0; transform: scale(1.5); }
    100% { opacity: 0; transform: scale(1.5); }
  }
  .w__scan {
    fill: var(--c);
    opacity: 0;
    animation: mska-scan var(--loop) linear infinite;
    animation-delay: calc(var(--i) * var(--hold) + var(--d, 0s));
  }
  @keyframes mska-scan {
    0% { opacity: 1; transform: translateY(0); }
