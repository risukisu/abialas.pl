---
/**
 * Product alley — the shared landing-page template for every product.
 *
 * "The Drafting Table": a topic landing page. The header is the focal
 * moment — index coordinate, the product name in Newsreader, the blurb as a
 * standfirst. /system additionally renders the pillar schematic (its signature
 * interaction). Below that, the alley lists the essays tagged to this product,
 * newest-first.
 *
 * The flexibility guarantee: adding a product = one entry in data/products.ts.
 * Its /slug page auto-generates from this template; nothing product-specific is
 * hardcoded here except the `hasSchematic` branch.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import EssayCard from "../components/EssayCard.astro";
import PillarSchematic from "../components/PillarSchematic.astro";
import JsonLd from "../components/JsonLd.astro";
import { getCollection } from "astro:content";
import { products } from "../data/products";
import { byTopic } from "../lib/pieces";
import { collectionPageSchema, breadcrumbListSchema } from "../lib/jsonld";

export async function getStaticPaths() {
  return products.map((p) => ({ params: { product: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const all = await getCollection("writing");
const pieces = byTopic(all, product.tag);

const index = String(product.order).padStart(2, "0");
const coord = `${index} / ${product.tag.toUpperCase()}`;

// Trailing slash to match the canonical (astro build.format: 'directory').
const productUrl = `https://abialas.pl/${product.slug}/`;
const collectionLd = collectionPageSchema({
  name: product.name,
  url: productUrl,
  description: product.blurb,
});
const breadcrumbLd = breadcrumbListSchema([
  { name: "Home", url: "https://abialas.pl/" },
  { name: product.name, url: productUrl },
]);
---
<BaseLayout title={product.name} description={product.blurb} room={product.hue}>
  <JsonLd slot="head" data={collectionLd} />
  <JsonLd slot="head" data={breadcrumbLd} />
  <!-- ── Alley header ─────────────────────────────────────────────
       The focal moment. A faint blueprint sheet sits behind this zone
       only — lighter than the homepage masthead so the alley reads as
       the quieter, downstream room. Index coordinate → name (Newsreader,
       large) → blurb as a standfirst sentence. No breadcrumb element;
       the nav already carries the way back. -->
  <header class="alley-head">
    <div class="alley-head__grid blueprint" aria-hidden="true"></div>
    <div class="container alley-head__inner">
      <span class="measure alley-head__coord">{coord}</span>
      <h1 class="alley-head__name room-title">{product.name}</h1>
      <p class="alley-head__standfirst">{product.blurb}</p>
    </div>
  </header>

  <!-- ── Schematic ────────────────────────────────────────────────
       Only /system carries hasSchematic. The signature interaction
       sits between the header and the pieces. -->
  {product.hasSchematic && (
    <section class="schematic-zone">
      <div class="container">
        <PillarSchematic />
      </div>
    </section>
  )}

  <!-- ── Pieces ───────────────────────────────────────────────────
       A measure section label + trailing hairline (echoing the
       storefront's section heads), then the tagged essays as a
       single-column list. With one published piece the list frames a
       single deliberate row; with none, a quiet, intentional empty
       line — not an error state. -->
  <section class="pieces">
    <div class="container">
      <div class="section-head">
        <span class="measure">Writing in this alley</span>
        <span class="section-head__rule" aria-hidden="true"></span>
      </div>

      {pieces.length > 0 ? (
        <div class="pieces__list">
          {pieces.map((piece) => <EssayCard piece={piece} />)}
        </div>
      ) : (
        <p class="pieces__empty">Nothing published here yet — pieces in progress.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ════════════════════════════════════════════════════════════════
     PRODUCT ALLEY · shared template (/system, /ai, future products)
     Header is the focal moment; the schematic (where present) is the
     interaction; the pieces are the quieter list below. Hairlines and
     measure marks carry the drafting-table feel. Of-a-piece with the
     storefront homepage.
     ════════════════════════════════════════════════════════════════ */

  /* ── Alley header ─────────────────────────────────────────────── */
  .alley-head {
    position: relative;
    padding-top: clamp(48px, 7vw, 88px);
    padding-bottom: var(--section-padding);
    overflow: hidden;
  }

  /* Blueprint sheet behind the header only, masked to fade at the
     edges. Kept lighter than the homepage masthead (opacity .4 vs .55)
     so the alley reads as the calmer, downstream room. */
  .alley-head__grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.4;
    -webkit-mask-image: radial-gradient(
      110% 85% at 22% 30%,
      #000 0%,
      rgba(0, 0, 0, 0.5) 44%,
      transparent 76%
    );
    mask-image: radial-gradient(
      110% 85% at 22% 30%,
      #000 0%,
      rgba(0, 0, 0, 0.5) 44%,
      transparent 76%
    );
  }

  .alley-head__inner {
    position: relative;
    z-index: 1;
  }

  .alley-head__coord {
    display: block;
    margin-bottom: 22px;
  }

  .alley-head__name {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 18ch;
    margin: 0 0 26px;
  }

  .alley-head__standfirst {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.1vw, 1.4rem);
    line-height: 1.5;
    color: var(--color-body);
    max-width: 52ch;
    margin: 0;
    font-weight: 400;
    letter-spacing: -0.005em;
  }

  /* ── Schematic zone ───────────────────────────────────────────── */
  .schematic-zone {
    padding-top: var(--section-padding);
  }

  /* ── Pieces ───────────────────────────────────────────────────── */
  .pieces {
    padding-top: var(--section-padding);
    padding-bottom: var(--section-padding);
  }

  /* The list's first essay-card draws its own top hairline; with the
     section-head rule above and this bottom hairline, a single published
     piece frames as a deliberate row rather than a broken grid. */
  .pieces__list {
    border-bottom: 1px solid var(--color-line);
  }

  /* Deliberate empty state — a quiet, plain line. Reads as intentional:
     muted serif, sat under the same framed rule as a populated list,
     given room rather than crammed. No "coming soon", no marketing. */
  .pieces__empty {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    line-height: 1.5;
    color: var(--color-muted);
    margin: 4px 0 0;
    padding-bottom: 6px;
    max-width: 46ch;
    font-weight: 400;
    letter-spacing: -0.005em;
  }

  /* ── Section head ─────────────────────────────────────────────────
     Measure label trailed by a hairline rule — the same schematic
     callout used on the storefront, kept identical for coherence. */
  .section-head {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 34px;
  }

  .section-head__rule {
    flex: 1;
    height: 3px;
    background: var(--gradient-spectrum);
  }

  /* ── Responsive ───────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .section-head {
      gap: 14px;
    }
  }
</style>
