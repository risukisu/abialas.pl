---
/**
 * Writing archive — "The Drafting Table"
 *
 * The complete archive of essays, grouped by product/topic. Reachable from
 * the storefront ("All writing") and the footer. Designed to scale: add a
 * product, its group appears automatically; remove all pieces from a product
 * and its group disappears. With one published piece the page reads as a
 * deliberate entry, not a broken grid.
 *
 * Section heads match the storefront and alley pages exactly — same
 * `.section-head` + `.section-head__rule` idiom for coherence across the site.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import EssayCard from "../../components/EssayCard.astro";
import InkedLink from "../../components/cta/InkedLink.astro";
import { getCollection } from "astro:content";
import { byTopic, featuredPieces, latest } from "../../lib/pieces";
import { products } from "../../data/products";
import { topicHue } from "../../data/hues";

const all = await getCollection("writing");
const sortedProducts = [...products].sort((a, b) => a.order - b.order);

// Each group = a product and its published essays (newest-first). Omit empty groups.
const groups = sortedProducts
  .map((p) => ({ product: p, pieces: byTopic(all, p.tag) }))
  .filter((g) => g.pieces.length > 0);

// The ink plate: first `featured: true` essay, else the newest published one.
// The plate highlights; the groups below stay the complete catalog (the
// featured essay is deliberately NOT removed from its group).
const featured = featuredPieces(all, 1)[0] ?? latest(all, 1)[0];
const featuredHue = featured ? topicHue(featured.data.topics[0]) : null;
const featuredDate = featured?.data.date.toLocaleString("en-US", { month: "short", year: "numeric" });
const featuredTopic = featured?.data.topics[0];
---
<BaseLayout
  title="Writing — Andrzej Białaś"
  description="Essays on marketing systems, plainly."
  room="writing"
>
  <!-- ── Archive header ────────────────────────────────────────────
       Index coordinate (measure mono), H1 in Newsreader, one honest
       standfirst. No blueprint grid here — this is a downstream room,
       quieter than the storefront masthead. -->
  <header class="archive-head">
    <div class="container">
      <span class="measure archive-head__coord">Archive / Writing</span>
      <h1 class="archive-head__title room-title">Writing</h1>
      <p class="archive-head__standfirst">
        Essays on the systems behind the work — plus shorter notes when
        there's something worth saying.
      </p>
    </div>
  </header>

  <!-- ── Featured plate ────────────────────────────────────────────
       The ink plate: one essay in full inversion — ink ground, paper
       text, ochre read-link (the About-band vocabulary). Topic hue
       appears only as the paper-outlined tick; hues read muddy on ink.
       Whole plate is clickable via the stretched title link. -->
  {featured && (
    <section class="featured">
      <div class="container">
        <article class="featured__plate" style={`--tick: var(--hue-${featuredHue});`}>
          <span class="measure featured__meta">
            Featured{featuredTopic && ` · ${featuredTopic}`} · {featuredDate}
          </span>
          <h2 class="featured__title">
            <a href={`/writing/${featured.slug}`}>{featured.data.title}</a>
          </h2>
          {featured.data.summary && (
            <p class="featured__standfirst">{featured.data.summary}</p>
          )}
          <span class="featured__read" aria-hidden="true">Read the essay</span>
        </article>
      </div>
    </section>
  )}

  <!-- ── Grouped archive ───────────────────────────────────────────
       One section per product that has published pieces. Section head:
       measure label (links to the product alley) + trailing hairline rule.
       Essays in a single-column list. Omits empty groups entirely. -->
  {groups.length > 0 ? (
    groups.map(({ product, pieces }) => (
      <section class="archive-group">
        <div class="container">
          <div class="section-head" style={`--room-text: var(--hue-${product.hue}-text);`}>
            <span class="measure">
              <InkedLink href={`/${product.slug}`}>{product.name}</InkedLink>
            </span>
            <span class="section-head__rule" aria-hidden="true"></span>
          </div>
          <div class="archive-group__list">
            {pieces.map((piece) => <EssayCard piece={piece} />)}
          </div>
        </div>
      </section>
    ))
  ) : (
    <section class="archive-empty">
      <div class="container">
        <p class="archive-empty__line">Nothing published yet — pieces in progress.</p>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ════════════════════════════════════════════════════════════════
     WRITING ARCHIVE · The Drafting Table
     Matte, precise, editorial. Grouped by product so the structure
     scales gracefully. One published piece renders a single deliberate
     row — not a broken grid, not an error state.
     Of-a-piece with the storefront and the product alleys.
     ════════════════════════════════════════════════════════════════ */

  /* ── Archive header ───────────────────────────────────────────── */
  .archive-head {
    padding-top: clamp(48px, 7vw, 88px);
    padding-bottom: var(--section-padding);
  }

  .archive-head__coord {
    display: block;
    margin-bottom: 22px;
  }

  .archive-head__title {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 18ch;
    margin: 0 0 26px;
  }

  .archive-head__standfirst {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.1vw, 1.4rem);
    line-height: 1.5;
    color: var(--color-body);
    max-width: 52ch;
    margin: 0;
    font-weight: 400;
    letter-spacing: -0.005em;
  }

  /* ── Featured plate ───────────────────────────────────────────────
     Full inversion — the About band's vocabulary applied to one essay.
     Paper on ink; the read-link wears --link-on-ink ochre (the gated
     on-ink pair); the topic hue appears only as a paper-outlined tick. */
  /* No own padding — the head's bottom padding spaces it above, the
     first group's top padding below. Keeps the page's single-SP rhythm. */
  .featured {
    padding: 0;
  }

  .featured__plate {
    position: relative;
    background: var(--color-ink);
    padding: clamp(36px, 5.5vw, 64px) clamp(28px, 5vw, 64px);
    transition: transform 0.18s ease;
  }

  .featured__plate:hover,
  .featured__plate:focus-within {
    transform: translateY(-3px);
  }

  .featured__meta {
    display: block;
    color: var(--color-paper);
    opacity: 0.72;
    margin-bottom: 20px;
  }

  /* Topic tick — raw hue with a paper outline so any hue reads on ink. */
  .featured__meta::before {
    content: "";
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 9px;
    background: var(--tick);
    outline: 1px solid var(--color-paper);
  }

  .featured__title {
    margin: 0 0 18px;
    font-size: clamp(1.9rem, 4.5vw, 3.1rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  /* Stretched link — the whole plate is the click target. */
  .featured__title a {
    color: var(--color-paper);
    text-decoration: none;
    border: none;
    transition: color 0.15s;
  }
  .featured__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .featured__plate:hover .featured__title a,
  .featured__title a:focus-visible {
    color: var(--link-on-ink);
  }

  .featured__standfirst {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.5;
    color: var(--color-paper);
    opacity: 0.85;
    max-width: 54ch;
    margin: 0 0 28px;
    font-weight: 400;
  }

  .featured__read {
    font: 500 15px var(--font-sans);
    color: var(--link-on-ink);
    border-bottom: 1px solid var(--link-on-ink);
    padding-bottom: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .featured__plate {
      transition: none;
    }
    .featured__plate:hover,
    .featured__plate:focus-within {
      transform: none;
    }
  }

  /* ── Grouped sections ─────────────────────────────────────────── */
  .archive-group {
    padding-top: var(--section-padding);
    padding-bottom: var(--section-padding);
  }

  /* The list's first essay-card draws its own top hairline via
     .essay-card { border-top }; combined with the section-head rule
     above and this bottom hairline, a single card frames as a
     deliberate entry rather than a broken list. */
  .archive-group__list {
    border-bottom: 1px solid var(--color-line);
  }

  /* ── Section head ─────────────────────────────────────────────────
     Measure label + trailing hairline rule — the same schematic
     callout used on the storefront and product alleys, kept identical
     for coherence. The label links to the product alley. */
  .section-head {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 34px;
  }

  /* The label links to another room, so it wears that room's hue —
     .inked's own ink color would otherwise defeat the measure tint. */
  .section-head .measure :global(.inked) {
    color: var(--room-text);
  }

  .section-head__rule {
    flex: 1;
    height: 3px;
    background: var(--gradient-spectrum);
  }

  /* ── Empty state ──────────────────────────────────────────────── */
  .archive-empty {
    padding-top: var(--section-padding);
    padding-bottom: var(--section-padding);
  }

  .archive-empty__line {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    line-height: 1.5;
    color: var(--color-muted);
    margin: 0;
    max-width: 46ch;
    font-weight: 400;
    letter-spacing: -0.005em;
  }

  /* ── Responsive ───────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .section-head {
      gap: 14px;
    }
  }
</style>
