---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BentoGrid from "../../components/BentoGrid.astro";
import BentoTile from "../../components/BentoTile.astro";
import { getCollection } from "astro:content";
import { sortByOrder } from "../../lib/pieces";

const all = await getCollection("writing");
const pieces = sortByOrder(all);

/* Connective-tissue tiles — drop into the grid after fixed positions
   to keep the rhythm interesting even when most pieces are drafts. */
const connective = [
  {
    variant: "stat" as const,
    tileSize: "square" as const,
    body: "4 → 12",
    caption: "Team scaled",
  },
  {
    variant: "concept" as const,
    tileSize: "wide" as const,
    body: "Marketing is engineering. The system is the artifact.",
  },
  {
    variant: "excerpt" as const,
    tileSize: "std" as const,
    body: "A marketing team without a system is a freelance collective.",
    caption: "From: Marketing Operating System",
  },
];
---
<BaseLayout title="Writing — Andrzej Białas" description="Long-form essays on systems I've built. Shorter notes when there's something worth saying.">
  <section class="container writing-head">
    <h2>Writing</h2>
    <p>Long-form essays on systems I've built. Shorter notes on marketing, AI, and leadership when there's something worth saying.</p>
  </section>

  <section class="container">
    <BentoGrid>
      {pieces.slice(0, 3).map((p) => <BentoTile piece={p} />)}
      <BentoTile content={connective[0]} />
      {pieces.slice(3, 6).map((p) => <BentoTile piece={p} />)}
      <BentoTile content={connective[1]} />
      {pieces.slice(6).map((p) => <BentoTile piece={p} />)}
      <BentoTile content={connective[2]} />
    </BentoGrid>
  </section>
</BaseLayout>

<style>
  .writing-head { padding-top: 48px; }
  .writing-head h2 { margin-bottom: 16px; }
  .writing-head p { color: var(--color-muted); }
</style>
