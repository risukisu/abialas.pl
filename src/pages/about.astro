---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";

const narrative = await getEntry("about", "narrative");
const { Content } = await narrative.render();
---
<BaseLayout title="About — Andrzej Białas" description="Marketing systems for technical companies.">
  <section class="container about">
    <div class="about__layout">
      <aside class="about__aside">
        <!-- Photo slot — add src/images/portrait.jpg later -->
        <div class="about__photo-placeholder"></div>
        <p class="meta">Based in Warsaw</p>
      </aside>
      <div class="about__narrative prose">
        <h1>About</h1>
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about { padding-top: 48px; padding-bottom: var(--section-padding); }
  .about__layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
  }
  .about__photo-placeholder {
    aspect-ratio: 1;
    border: 1px solid var(--color-hairline);
    background: var(--color-bg);
    margin-bottom: 16px;
  }
  .about__narrative h1 { margin-bottom: 32px; }
  .about__narrative :global(p) { margin-bottom: 24px; font-size: 1.125rem; }

  @media (max-width: 768px) {
    .about__layout { grid-template-columns: 1fr; }
    .about__photo-placeholder { max-width: 240px; }
  }
</style>
