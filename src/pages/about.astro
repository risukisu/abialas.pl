---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import { getEntry } from "astro:content";
import { personSchema } from "../lib/jsonld";

const narrative = await getEntry("about", "narrative");
const { Content } = await narrative.render();

const person = personSchema({
  name: "Andrzej Białas",
  url: "https://abialas.pl",
  jobTitle: "Marketing Director",
  sameAs: [
    "https://www.linkedin.com/in/andrzejbialas/",
    "https://github.com/risukisu",
  ],
});
---
<BaseLayout title="About — Andrzej Białas" description="Marketing systems for technical companies.">
  <JsonLd slot="head" data={person} />
  <section class="container about">
    <div class="about__layout">
      <aside class="about__aside">
        <!-- Photo slot — add src/images/portrait.jpg later -->
        <div class="about__photo-placeholder"></div>
        <p class="measure about__caption">Based in Warsaw</p>
      </aside>
      <div class="about__narrative">
        <h1>About</h1>
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-top: 48px;
    padding-bottom: var(--section-padding);
  }

  .about__layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
    align-items: start;
  }

  /* Photo plate — hairline-framed on mist ground */
  .about__photo-placeholder {
    aspect-ratio: 1;
    border: 1px solid var(--color-line-2);
    background: var(--color-bg);
    margin-bottom: 12px;
  }

  .about__caption {
    margin: 0;
  }

  /* Narrative prose */
  .about__narrative h1 {
    margin-bottom: 40px;
  }

  .about__narrative :global(p) {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-body);
    max-width: 65ch;
    margin-bottom: 1.5rem;
  }

  .about__narrative :global(a) {
    position: relative;
    display: inline;
    font-family: var(--font-serif);
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1.5px solid var(--color-line-2);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }

  .about__narrative :global(a:hover),
  .about__narrative :global(a:focus-visible) {
    border-color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .about__layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .about__photo-placeholder {
      max-width: 240px;
    }
  }
</style>
