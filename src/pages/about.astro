---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import { getEntry } from "astro:content";
import { personSchema } from "../lib/jsonld";

const narrative = await getEntry("about", "narrative");
const { Content } = await narrative.render();

const person = personSchema({
  name: "Andrzej Białaś",
  url: "https://abialas.pl",
  jobTitle: "Marketing Director",
  sameAs: [
    "https://www.linkedin.com/in/andrzej-bialas/",
    "https://github.com/risukisu",
  ],
});
---
<BaseLayout title="About — Andrzej Białaś" description="Marketing systems for technical companies." room="about">
  <JsonLd slot="head" data={person} />
  <section class="container about">
    <div class="about__layout">
      <aside class="about__aside">
        <img
          class="about__photo"
          src="/portrait.webp"
          alt="Andrzej Białaś in glasses and a red polo, with risu — an illustrated squirrel holding coffee and a laptop — on his shoulder"
          width="800"
          height="952"
        />
      </aside>
      <div class="about__narrative">
        <h1 class="room-title">About</h1>
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-top: 48px;
    /* Compact close — the narrative's last line shouldn't float far
       above the footer (owner call 2026-08-20). */
    padding-bottom: clamp(40px, 5vw, 72px);
  }

  .about__layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
    align-items: start;
  }

  /* Photo plate — the window language: rectangular, ink frame,
     hard offset shadow. */
  .about__photo {
    display: block;
    width: 100%;
    height: auto;
    border: 2px solid var(--color-ink);
    box-shadow: 6px 6px 0 var(--color-ink);
  }

  /* Narrative prose */
  .about__narrative h1 {
    margin-bottom: 40px;
  }

  .about__narrative :global(p) {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-body);
    max-width: 65ch;
    margin-bottom: 1.5rem;
  }

  .about__narrative :global(a) {
    position: relative;
    display: inline;
    font-family: var(--font-serif);
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1.5px solid var(--color-line-2);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }

  .about__narrative :global(a:hover),
  .about__narrative :global(a:focus-visible) {
    border-color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .about__layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .about__photo {
      max-width: 260px;
    }
  }
</style>
