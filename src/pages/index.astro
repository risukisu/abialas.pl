---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import EssayCard from "../components/EssayCard.astro";
import PrimaryCta from "../components/cta/PrimaryCta.astro";
import SecondaryCta from "../components/cta/SecondaryCta.astro";
import InkedLink from "../components/cta/InkedLink.astro";
import { getCollection } from "astro:content";
import { byTopic, latest } from "../lib/pieces";
import { products } from "../data/products";

const all = await getCollection("writing");
const sortedProducts = [...products].sort((a, b) => a.order - b.order);
const recent = latest(all, 3);
const countFor = (tag: string) => byTopic(all, tag).length;

// The legend: every room on one sheet — products first (their own blurbs),
// then the three fixed rooms. Ticks + hover tints follow the wayfinding rules.
const rooms = [
  ...sortedProducts.map((p) => ({ href: `/${p.slug}`, name: p.name, line: p.blurb, hue: p.hue })),
  { href: "/work", name: "Work", line: "What I built, the résumé, and what people say.", hue: "work" },
  { href: "/writing", name: "Writing", line: "Every essay, grouped by topic.", hue: "writing" },
  { href: "/about", name: "About", line: "Who I am and how I got here.", hue: "about" },
];
---
<BaseLayout
  title="Andrzej Białaś"
  description="Marketing run as a system instead of a string of campaigns — what compounds, what breaks, the parts that don't make it into case studies."
>
  <!-- ── 1 · Business-card header ─────────────────────────────────
       The drafting sheet. Name dominant in Newsreader; the blueprint
       grid sits behind THIS zone only, fading at the edges so it reads
       as a sheet on a table, not a full-bleed background. One restrained
       page-load reveal, staggered, reduced-motion honored. -->
  <header class="masthead">
    <div class="masthead__grid blueprint" aria-hidden="true"></div>
    <div class="container masthead__inner">
      <span class="measure masthead__coord reveal" style="--i:0">index</span>
      <h1 class="masthead__name reveal" style="--i:1">Marketing as a System</h1>
      <p class="masthead__sub reveal" style="--i:2">
        I'm Andrzej Białaś. I run marketing as a system instead of a string of
        campaigns. This is where I write down how that actually works — what
        compounds, what breaks, and the parts that don't make it into the case
        studies.
      </p>
      <div class="masthead__ctas reveal" style="--i:3">
        <PrimaryCta href="/system" label="Read the model" />
        <SecondaryCta href="/work" label="See the work" />
      </div>
    </div>
  </header>

  <!-- ── 2 · Products on display ──────────────────────────────────
       The storefront's heart. Exhibit plates on a gridded surface:
       2-up on desktop, 1-up on mobile. -->
  <section class="display">
    <div class="container">
      <div class="section-head">
        <span class="measure measure--system">On display</span>
        <span class="measure section-head__rule" aria-hidden="true"></span>
      </div>
      <div class="display__grid">
        {sortedProducts.map((p) => (
          <ProductCard product={p} count={countFor(p.tag)} />
        ))}
      </div>
    </div>
  </section>

  <!-- ── 3 · Latest ───────────────────────────────────────────────
       A quieter strip. One published essay today → one row, which must
       read as intentional. Section omitted entirely if nothing is live. -->
  {recent.length > 0 && (
    <section class="latest">
      <div class="container">
        <div class="section-head section-head--split">
          <span class="measure measure--writing">Latest</span>
          <InkedLink href="/writing">All writing</InkedLink>
        </div>
        <div class="latest__list">
          {recent.map((piece) => (
            <EssayCard piece={piece} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── 4 · About teaser ─────────────────────────────────────────
       One honest paragraph, first person. Plain. -->
  <section class="about">
    <div class="container about__inner">
      <span class="measure measure--about">About</span>
      <p class="about__body">
        I spent a decade in environmental NGOs before I ended up running
        marketing for a tech company. Most of what I know I learned by doing
        it badly first. <InkedLink href="/about">More</InkedLink>
      </p>
    </div>
  </section>

  <!-- ── 5 · The rooms ─────────────────────────────────────────────
       The sheet's key, closing the page: every room as a tile on the
       gridded surface (echoes the exhibit grid). Hue tick + name +
       one line + arrow; the complete index of where everything lives. -->
  <section class="nav-grid">
    <div class="container">
      <div class="section-head">
        <span class="measure">The rooms</span>
        <span class="measure section-head__rule" aria-hidden="true"></span>
      </div>
      <nav aria-label="Rooms">
        <div class="nav-grid__list">
          {rooms.map((r) => (
            <a href={r.href} class="nav-grid__item" style={`--tick: var(--hue-${r.hue}); --tint: var(--hue-${r.hue}-text);`}>
              <span class="nav-grid__text">
                <span class="nav-grid__label">{r.name}</span>
                <span class="nav-grid__line">{r.line}</span>
              </span>
              <span class="nav-grid__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  /* ════════════════════════════════════════════════════════════════
     HOME · The Digital Storefront
     Business card → products on display → latest → about teaser →
     the rooms (closing directory).
     Catalog macrostructure, not hero→features→CTA. Restraint over
     density; hairlines and measure marks carry the schematic feel.
     ════════════════════════════════════════════════════════════════ */

  /* ── 1 · Masthead ─────────────────────────────────────────────── */
  .masthead {
    position: relative;
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: var(--section-padding);
    overflow: hidden;
  }

  /* Blueprint sheet behind the header only. Masked so the grid fades
     out toward the edges — a sheet laid on the table, not wallpaper. */
  .masthead__grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.55;
    -webkit-mask-image: radial-gradient(
      120% 90% at 24% 32%,
      #000 0%,
      rgba(0, 0, 0, 0.55) 46%,
      transparent 78%
    );
    mask-image: radial-gradient(
      120% 90% at 24% 32%,
      #000 0%,
      rgba(0, 0, 0, 0.55) 46%,
      transparent 78%
    );
  }

  /* Soft hue wash under the blueprint sheet — light on the drafting table. */
  .masthead::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(60% 55% at 12% 18%, rgb(222 60 38 / 0.16), transparent 60%),
      radial-gradient(55% 50% at 88% 10%, rgb(34 87 214 / 0.14), transparent 60%),
      radial-gradient(60% 55% at 78% 85%, rgb(46 125 79 / 0.13), transparent 60%);
  }

  .masthead__inner {
    position: relative;
    z-index: 1;
  }

  .masthead__coord {
    display: block;
    margin-bottom: 22px;
    color: var(--color-muted);
  }

  .masthead__name {
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 16ch;
    margin: 0 0 28px;
  }

  .masthead__name::after {
    content: "";
    display: block;
    width: 130px;
    height: 6px;
    margin-top: 22px;
    background: var(--gradient-spectrum);
  }

  .masthead__sub {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.1vw, 1.4rem);
    line-height: 1.5;
    color: var(--color-body);
    max-width: 54ch;
    margin: 0 0 40px;
    font-weight: 400;
    /* normalise the .measure mono styling we don't want here */
    letter-spacing: -0.005em;
    text-transform: none;
  }

  .masthead__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  /* ── 2 · Products on display ──────────────────────────────────── */
  .display {
    padding-top: var(--section-padding);
  }

  .display__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px; /* hairline gutter — cards meet on the gridded surface */
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  /* Each card already paints --color-bg; the 1px gap + frame let the
     grid read as a ruled modular surface the exhibits sit within. */
  .display__grid > :global(.card) {
    border: none;
  }
  .display__grid > :global(.card:hover),
  .display__grid > :global(.card:focus-within) {
    /* keep the lit inset hairline from the card's own hover state */
    box-shadow: inset 0 0 0 1px var(--color-line-2);
  }

  /* ── 3 · Latest ───────────────────────────────────────────────── */
  .latest {
    padding-top: var(--section-padding);
  }

  /* The list's first essay-card draws its own top hairline; combined
     with the section head's rule it frames a single row cleanly, so one
     published piece reads as a deliberate entry, not a broken grid. */
  .latest__list {
    border-bottom: 1px solid var(--color-line);
  }

  /* ── 4 · About teaser ─────────────────────────────────────────── */
  .about {
    margin-top: var(--section-padding);
    padding-top: 64px;
    padding-bottom: 96px;
    background: var(--color-ink);
  }
  .about .measure--about { color: var(--color-paper); opacity: 0.75; }

  .about__inner {
    max-width: 60ch;
  }

  .about__body {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    line-height: 1.55;
    color: var(--color-paper);
    margin: 18px 0 0;
    max-width: 46ch;
    font-weight: 400;
  }

  .about__body :global(a) { color: var(--link-on-ink); }

  /* ── Shared section heads ─────────────────────────────────────── */
  .section-head {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 34px;
  }

  /* A measure rule trailing the label — schematic callout. */
  .section-head__rule {
    flex: 1;
    height: 3px;
    background: var(--gradient-spectrum);
  }

  .section-head--split {
    justify-content: space-between;
  }

  .measure--system { color: var(--hue-system-text); }
  .measure--writing { color: var(--hue-writing-text); }
  .measure--about { color: var(--hue-about-text); }

  /* ── 5 · The rooms ────────────────────────────────────────────────
     Tiles on the gridded surface — same hairline construction as the
     exhibit grid. Each tile carries its room's tick; the name tints to
     the room's text hue on hover (the essay-row idiom). ─────────────── */
  .nav-grid {
    padding-top: var(--section-padding);
    padding-bottom: var(--section-padding);
  }

  .nav-grid__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .nav-grid__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 32px;
    background: var(--color-bg);
    text-decoration: none;
    border: none;
    color: var(--color-ink);
    transition: background-color 0.18s ease;
  }

  /* Five rooms, two columns — the odd tile closes the sheet full-width. */
  .nav-grid__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .nav-grid__item:hover,
  .nav-grid__item:focus-visible {
    background-color: var(--color-bg-hover, rgba(0, 0, 0, 0.02));
    outline: none;
  }

  .nav-grid__text {
    display: block;
  }

  .nav-grid__label {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.4;
    transition: color 0.15s;
  }

  /* Room tick before the name — the wayfinding mark. */
  .nav-grid__label::before {
    content: "";
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 10px;
    background: var(--tick);
  }

  .nav-grid__item:hover .nav-grid__label,
  .nav-grid__item:focus-visible .nav-grid__label {
    color: var(--tint);
  }

  .nav-grid__line {
    display: block;
    margin-top: 4px;
    padding-left: 19px; /* aligns under the name, past the tick */
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .nav-grid__arrow {
    font-size: 1.2rem;
    margin-left: 16px;
    opacity: 0.5;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .nav-grid__item:hover .nav-grid__arrow,
  .nav-grid__item:focus-visible .nav-grid__arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-grid__arrow {
      transition: opacity 0.18s ease;
    }
    .nav-grid__item:hover .nav-grid__arrow,
    .nav-grid__item:focus-visible .nav-grid__arrow {
      transform: none;
    }
  }

  /* ── Page-load reveal ─────────────────────────────────────────────
     One orchestrated, staggered fade-rise in the masthead only.
     Fully disabled under prefers-reduced-motion. ──────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(10px);
    animation: reveal 0.62s cubic-bezier(0.22, 0.7, 0.25, 1) forwards;
    animation-delay: calc(var(--i) * 0.09s + 0.05s);
  }

  @keyframes reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  /* ── Responsive ───────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .display__grid {
      grid-template-columns: 1fr;
    }
    .section-head {
      gap: 14px;
    }
    .nav-grid__list {
      grid-template-columns: 1fr;
    }
    .nav-grid__item {
      padding: 24px 28px;
    }
    .nav-grid__label {
      font-size: 1.05rem;
    }
  }
</style>
