---
import BaseLayout from "../layouts/BaseLayout.astro";
import NexusBox from "../components/nexus/NexusBox.astro";
import GrugTile from "../components/nexus/GrugTile.astro";
import SkillCraftTile from "../components/nexus/SkillCraftTile.astro";
import MarketingSkillsTile from "../components/nexus/MarketingSkillsTile.astro";
import MarketingSkillsRepoTile from "../components/nexus/MarketingSkillsRepoTile.astro";
import ResumeTile from "../components/nexus/ResumeTile.astro";
import GitHubTile from "../components/nexus/GitHubTile.astro";
import ContributionGraph from "../components/nexus/ContributionGraph.astro";
import { follow, followStack } from "../data/nexus";
---
<BaseLayout
  title="Andrzej Białaś"
  description="Marketing run as a system instead of a string of campaigns — what compounds, what breaks, the parts that don't make it into case studies."
>
  <!-- ── 1 · Business-card header ─────────────────────────────────
       The drafting sheet. Name dominant in Newsreader; the blueprint
       grid sits behind THIS zone only, fading at the edges so it reads
       as a sheet on a table, not a full-bleed background. One restrained
       page-load reveal, staggered, reduced-motion honored. -->
  <header class="masthead">
    <div class="masthead__grid blueprint" aria-hidden="true"></div>
    <div class="container masthead__inner">
      <div class="masthead__text">
        <h1 class="masthead__name reveal" style="--i:0">Hi, I'm Andrzej. I do marketing.</h1>
        <p class="masthead__sub reveal" style="--i:1">
          I run marketing as a system instead of a string of campaigns. This is
          where I write down how that actually works — what compounds, what
          breaks, and the parts that don't make it into the case studies.
        </p>
      </div>
      <!-- The photo, laid on the sheet like a print: ink frame, toned
           shadow, a 2° tilt against the -3° the paper stickers wear. -->
      <figure class="masthead__photo reveal" style="--i:2">
        <img
          src="/portrait-risu.webp"
          srcset="/portrait-risu.webp 720w, /portrait-risu@2x.webp 1280w"
          sizes="(max-width: 720px) 180px, (max-width: 1100px) 26vw, 320px"
          width="720"
          height="720"
          alt="Andrzej Białaś, with risu the squirrel on his shoulder"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
  </header>

  <!-- ── Follow ─────────────────────────────────────────────────────
       Newsletter hero tile + Blog + a narrow stack (LinkedIn over X).
       Guest-sticker rule: each tile wears its OWN brand kit, hexes
       scoped per component. -->
  <section class="nexus-sec">
    <div class="container">
      <div class="nexus-sec__head">
        <span class="measure">Follow</span>
        <span class="nexus-sec__rule" aria-hidden="true"></span>
      </div>
      <div class="follow-row">
        <GrugTile />
        {follow.map((b) => <NexusBox {...b} size="md" />)}
        <div class="follow-stack">
          {followStack.map((b) => <NexusBox {...b} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Building ───────────────────────────────────────────────────
       Proof-of-work: live contribution graph + SkillCraft, then the
       marketing-skills pair — the site (big, animated) and the repo. -->
  <section class="nexus-sec">
    <div class="container">
      <div class="nexus-sec__head">
        <span class="measure">Building</span>
        <span class="nexus-sec__rule" aria-hidden="true"></span>
        <a class="measure nexus-all" href="https://github.com/risukisu">all projects ↗</a>
      </div>
      <div class="build-row">
        <ContributionGraph />
        <SkillCraftTile />
      </div>
      <div class="msk-row">
        <MarketingSkillsTile />
        <MarketingSkillsRepoTile />
      </div>
    </div>
  </section>

  <!-- ── More ───────────────────────────────────────────────────────
       Résumé (the sheet) + GitHub (last-push readout). -->
  <section class="nexus-sec nexus-sec--last">
    <div class="container">
      <div class="nexus-grid">
        <ResumeTile />
        <GitHubTile />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ════════════════════════════════════════════════════════════════
     HOME · The Nexus
     masthead → Follow → Building → More; guest-sticker tiles carry
     their own kits.
     ════════════════════════════════════════════════════════════════ */

  /* ── Masthead ──────────────────────────────────────────────────── */
  .masthead {
    position: relative;
    padding-top: clamp(48px, 7vw, 88px);
    /* tight — no CTAs anymore; the Follow row is the hero's counterpart */
    padding-bottom: clamp(28px, 3.5vw, 48px);
    overflow: hidden;
  }

  /* Blueprint sheet behind the header only. Masked so the grid fades
     out toward the edges — a sheet laid on the table, not wallpaper. */
  .masthead__grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.55;
    -webkit-mask-image: radial-gradient(
      120% 90% at 24% 32%,
      #000 0%,
      rgba(0, 0, 0, 0.55) 46%,
      transparent 78%
    );
    mask-image: radial-gradient(
      120% 90% at 24% 32%,
      #000 0%,
      rgba(0, 0, 0, 0.55) 46%,
      transparent 78%
    );
  }

  /* Soft hue wash under the blueprint sheet — light on the drafting table. */
  .masthead::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(60% 55% at 12% 18%, rgb(222 60 38 / 0.16), transparent 60%),
      radial-gradient(55% 50% at 88% 10%, rgb(34 87 214 / 0.14), transparent 60%),
      radial-gradient(60% 55% at 78% 85%, rgb(46 125 79 / 0.13), transparent 60%);
  }

  .masthead__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(200px, 26vw, 320px);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  .masthead__text {
    min-width: 0;
  }

  .masthead__photo {
    margin: 0;
    justify-self: end;
    width: 100%;
    transform: rotate(2deg);
  }
  .masthead__photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 2px solid var(--color-ink);
    box-shadow: 6px 6px 0 #7a4a9e; /* about violet — the photo's own sky */
    background: var(--color-ink);
  }

  @media (max-width: 720px) {
    .masthead__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .masthead__photo {
      order: -1; /* the print first, then the name */
      justify-self: start;
      width: 180px;
    }
  }

  .masthead__name {
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 16ch;
    margin: 0 0 28px;
  }

  .masthead__name::after {
    content: "";
    display: block;
    width: 130px;
    height: 6px;
    margin-top: 22px;
    background: var(--gradient-spectrum);
  }

  .masthead__sub {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.1vw, 1.4rem);
    line-height: 1.5;
    color: var(--color-body);
    max-width: 54ch;
    margin: 0; /* last masthead element — the section padding is the gap */
    font-weight: 400;
    /* normalise the .measure mono styling we don't want here */
    letter-spacing: -0.005em;
    text-transform: none;
  }

  /* ── Page-load reveal ─────────────────────────────────────────────
     One orchestrated, staggered fade-rise in the masthead only.
     Fully disabled under prefers-reduced-motion. ──────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(10px);
    animation: reveal 0.62s cubic-bezier(0.22, 0.7, 0.25, 1) forwards;
    animation-delay: calc(var(--i) * 0.09s + 0.05s);
  }

  @keyframes reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  /* ── Nexus sections — graduated from LabShell's lab-sec idioms. ── */
  .nexus-sec {
    padding-top: clamp(36px, 5vw, 60px);
  }
  .nexus-sec--last {
    padding-bottom: var(--section-padding);
  }
  .nexus-sec__head {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 22px;
  }
  .nexus-sec__rule {
    flex: 1;
    height: 3px;
    background: var(--gradient-spectrum);
  }
  .nexus-all {
    color: var(--color-muted);
    text-decoration: none;
  }
  .nexus-all:hover {
    color: var(--color-accent);
  }

  /* Newsletter (hero) | Blog | narrow stack. The stack column is
     deliberately under the old LinkedIn width — two small stickers,
     LinkedIn over X, share one slot. */
  .follow-row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 0.8fr);
    gap: 18px;
    padding-right: 6px; /* hover-shadow room */
    align-items: stretch;
  }
  .follow-stack {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 18px;
    min-width: 0;
  }
  .follow-stack > :global(.box) {
    justify-content: center;
  }

  /* GitHub graph is the wide one (owner call); SkillCraft hugs right. */
  .build-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px;
    align-items: stretch;
    margin-bottom: 18px;
    padding-right: 6px;
  }
  .build-row > :global(.graph) {
    width: 100%;
  }
  /* Skills pair — uneven on purpose: the site tile leads, the repo
     tile is the side door. */
  .msk-row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 18px;
    align-items: stretch;
    padding-right: 6px;
  }

  /* Résumé | GitHub. minmax(0, …) so the GitHub readout's nowrap lines
     can't inflate the track past the viewport — they ellipsize instead. */
  .nexus-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 18px;
    padding-right: 6px;
    align-items: stretch;
  }

  @media (max-width: 960px) {
    .follow-row,
    .build-row {
      grid-template-columns: minmax(0, 1fr);
    }
    /* the stack lies flat: LinkedIn | X side by side */
    .follow-stack {
      grid-template-rows: none;
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 820px) {
    .msk-row {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .nexus-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 540px) {
    .follow-stack {
      grid-template-columns: 1fr;
    }
  }
</style>
