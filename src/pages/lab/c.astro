---
/**
 * LAB C — "Proof-of-work first". The Louise thesis leading: Built as a
 * 2×2 of md boxes with descriptions, then Follow, then Read + More
 * merged into one closing strip. The portfolio-of-artifacts site.
 */
import LabShell from "../../components/lab/LabShell.astro";
import NexusBox from "../../components/lab/NexusBox.astro";
import { follow, built, read, more } from "../../data/lab-nexus";
---
<LabShell variant="C" title="Proof-of-work first">
  <section class="lab-sec">
    <div class="container">
      <div class="lab-sec__head">
        <span class="measure">Built</span>
        <span class="lab-sec__rule" aria-hidden="true"></span>
        <a class="measure lab-all" href="https://github.com/risukisu">all projects ↗</a>
      </div>
      <div class="lab-grid lab-grid--2">
        {built.map((b) => <NexusBox {...b} size="md" />)}
      </div>
    </div>
  </section>

  <section class="lab-sec">
    <div class="container">
      <div class="lab-sec__head">
        <span class="measure">Follow</span>
        <span class="lab-sec__rule" aria-hidden="true"></span>
      </div>
      <div class="lab-grid lab-grid--2">
        {follow.map((b) => <NexusBox {...b} size="md" />)}
      </div>
    </div>
  </section>

  <section class="lab-sec">
    <div class="container">
      <div class="lab-sec__head">
        <span class="measure">Read · More</span>
        <span class="lab-sec__rule" aria-hidden="true"></span>
      </div>
      <div class="lab-grid lab-grid--3">
        {[...read, ...more].map((b) => <NexusBox {...b} />)}
      </div>
    </div>
  </section>
</LabShell>

<style>
  .lab-all {
    color: var(--color-muted);
    text-decoration: none;
  }
  .lab-all:hover {
    color: var(--color-accent);
  }
</style>
