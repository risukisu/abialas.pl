---
/**
 * LAB D — iteration on B (the verdict). Top row: Grug newsletter hero
 * tile + LinkedIn (logo) + Blog (squirrel). Then Built · Building —
 * live contribution heatmap (light) + project tiles incl. the
 * marketing-skills mock (open-sourcing soon). Essays tile removed —
 * nav + footer carry /writing now.
 */
import LabShell from "../../components/lab/LabShell.astro";
import NexusBox from "../../components/lab/NexusBox.astro";
import GrugTile from "../../components/lab/GrugTile.astro";
import ContributionGraph from "../../components/lab/ContributionGraph.astro";
import { followD, builtD, more } from "../../data/lab-nexus";
---
<LabShell variant="D" title="Follow-first, iterated">
  <section class="lab-sec">
    <div class="container">
      <div class="lab-sec__head">
        <span class="measure">Follow</span>
        <span class="lab-sec__rule" aria-hidden="true"></span>
      </div>
      <div class="follow-row">
        <GrugTile />
        {followD.map((b) => <NexusBox {...b} size="md" />)}
      </div>
    </div>
  </section>

  <section class="lab-sec">
    <div class="container">
      <div class="lab-sec__head">
        <span class="measure">Built · Building</span>
        <span class="lab-sec__rule" aria-hidden="true"></span>
        <a class="measure lab-all" href="https://github.com/risukisu">all projects ↗</a>
      </div>
      <div class="graph-slot">
        <ContributionGraph />
      </div>
      <div class="lab-grid lab-grid--3">
        {builtD.map((b) => <NexusBox {...b} size="md" />)}
      </div>
    </div>
  </section>

  <section class="lab-sec">
    <div class="container">
      <div class="lab-grid lab-grid--3">
        {more.map((b) => <NexusBox {...b} />)}
      </div>
    </div>
  </section>
</LabShell>

<style>
  .follow-row {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 18px;
    padding-right: 6px;
    align-items: stretch;
  }

  .graph-slot {
    margin-bottom: 18px;
    padding-right: 6px;
  }

  .lab-all {
    color: var(--color-muted);
    text-decoration: none;
  }
  .lab-all:hover {
    color: var(--color-accent);
  }

  @media (max-width: 960px) {
    .follow-row {
      grid-template-columns: 1fr;
    }
  }
</style>
