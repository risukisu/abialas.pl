---
// /dev/foil-cards/ — foil trading-card printings of risu, shared by direct
// link (2026-09-28). Noindexed, out of the sitemap, linked only from /dev/.
//
// 03 · Pixel quest foil is ported from the owner's "risu Foil Cards" design
// canvas (Pixel.dc.html): the same 1000×1000 board and 560×782 card, its
// two pixel SVGs and its two pixel fonts self-hosted under
// public/dev/foil-cards/. The canvas's live values (tilt, glare, foil
// offset) become CSS custom properties on the card, driven by the pointer.
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Foil cards"
  description="Foil trading-card printings of risu."
  noindex={true}
>
  <header class="container fc-head">
    <p class="measure">abialas.pl/dev · risu foil cards</p>
    <h1 class="fc-title">Foil cards</h1>
    <p class="fc-lead">Foil trading-card printings of risu. Move the pointer over a card to tilt it and catch the light.</p>
  </header>

  <section class="container fc-card" id="pixel-quest">
    <p class="measure">03</p>
    <h2 class="fc-h2">Pixel quest foil</h2>

    <div class="fc-stage" data-foil-stage>
      <div class="foil-board" data-foil-board>
        <img class="foil-backdrop" src="/dev/foil-cards/pixel-quest-squirrel.svg" alt="" />
        <div class="foil-vignette"></div>
        <div class="foil-float">
          <div class="foil-card" data-foil-card>
            <img src="/dev/foil-cards/pixel-quest-squirrel.svg" alt="A pixel-art squirrel holding an acorn on a mossy dungeon ledge at dusk, lit by a torch" style="position: absolute; left: 0; top: 0; width: 560px; height: 784px; display: block; image-rendering: pixelated" />
            <div style="position: absolute; left: 0; right: 0; bottom: 0; height: 300px; background: linear-gradient(180deg, rgba(7,5,26,0) 0%, rgba(7,5,26,0.55) 35%, rgba(7,5,26,0.92) 70%)"></div>

            <div style="position: absolute; left: 22px; right: 22px; top: 22px; height: 56px; box-sizing: border-box; display: flex; align-items: center; gap: 12px; padding: 0 10px 0 14px; background: rgba(18,14,43,0.94); border: 4px solid #f4e3c1; box-shadow: 0 0 0 4px #07051a, inset 0 0 0 3px #07051a, inset 0 0 0 5px #5b4a9e">
              <p class="foil-name" style="margin: 0; flex-grow: 1; font-family: 'Press Start 2P', monospace; font-size: 25px; line-height: 1; font-weight: 400; color: #ffcf5c; text-shadow: 3px 3px 0 #07051a">risu</p>
              <div style="display: flex; gap: 6px; align-items: center">
                <span style="width: 28px; height: 28px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 3px solid #07051a; background: #8b86a8; box-shadow: inset -3px -3px 0 rgba(0,0,0,0.3), inset 3px 3px 0 rgba(255,255,255,0.3); font-family: 'Press Start 2P', monospace; font-size: 11px; color: #07051a">3</span>
                <span style="width: 28px; height: 28px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 3px solid #07051a; background: #ffcf5c; box-shadow: inset -3px -3px 0 rgba(0,0,0,0.25), inset 3px 3px 0 rgba(255,255,255,0.45)"><svg width="16" height="16" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true"><rect x="3" y="0" width="2" height="1" fill="#4a2a12"></rect><rect x="1" y="1" width="6" height="2" fill="#6e4220"></rect><rect x="2" y="1" width="2" height="1" fill="#8f5a2e"></rect><rect x="1" y="3" width="6" height="2" fill="#c8812f"></rect><rect x="2" y="5" width="4" height="1" fill="#c8812f"></rect><rect x="3" y="6" width="2" height="1" fill="#8a4d1c"></rect><rect x="2" y="3" width="1" height="1" fill="#eeb35a"></rect></svg></span>
              </div>
            </div>

            <div style="position: absolute; left: 66px; right: 66px; top: 90px; height: 30px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; background: rgba(18,14,43,0.92); border: 3px solid #f4e3c1; box-shadow: 0 0 0 3px #07051a">
              <p style="margin: 0; font-size: 15px; font-weight: 600; color: #f4e3c1; text-shadow: 2px 2px 0 #07051a">Andrzej Białaś, Wanderer of Project r0guelike</p>
            </div>

            <div style="position: absolute; left: 22px; right: 22px; top: 454px; height: 44px; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; padding: 0 12px 0 16px; background: rgba(18,14,43,0.94); border: 4px solid #f4e3c1; box-shadow: 0 0 0 4px #07051a, inset 0 0 0 3px #07051a, inset 0 0 0 5px #5b4a9e">
              <p style="margin: 0; font-size: 18px; font-weight: 700; color: #f4e3c1; text-shadow: 2px 2px 0 #07051a">Unique Familiar — Squirrel Rogue</p>
              <span class="foil-flicker" style="display: flex"><svg width="20" height="20" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-hidden="true"><rect x="3" y="0" width="2" height="1" fill="#b8741c"></rect><rect x="1" y="1" width="6" height="2" fill="#e3a21a"></rect><rect x="1" y="3" width="6" height="2" fill="#ffcf5c"></rect><rect x="2" y="5" width="4" height="1" fill="#ffcf5c"></rect><rect x="3" y="6" width="2" height="1" fill="#e3a21a"></rect><rect x="2" y="3" width="1" height="1" fill="#fff1b5"></rect></svg></span>
            </div>

            <div style="position: absolute; left: 26px; right: 26px; top: 508px; height: 198px; box-sizing: border-box; padding: 12px 16px 22px; display: flex; flex-direction: column; gap: 8px; background: rgba(18,14,43,0.9); border: 4px solid #f4e3c1; box-shadow: 0 0 0 4px #07051a, inset 0 0 0 3px #07051a, inset 0 0 0 5px #5b4a9e; font-size: 16px; line-height: 1.3; color: #f4e3c1">
              <p style="margin: 0"><b style="font-weight: 700; color: #ffcf5c">Respawn</b> — When risu would leave play, shuffle it into your deck instead, then draw a card.</p>
              <p style="margin: 0"><b style="font-weight: 700; color: #ffcf5c">Map Editor</b> — Once per turn, redraw one tile of the dungeon. It can’t become a dead end.</p>
              <div style="height: 3px; margin: 2px 0; background: repeating-linear-gradient(90deg, #5b4a9e 0 6px, rgba(0,0,0,0) 6px 12px)"></div>
              <p style="margin: 0; color: #b9b0e0">“Built a fan site in 2001. Still building. Better tools, same grin.”</p>
            </div>

            <div style="position: absolute; right: 22px; top: 688px; width: 156px; height: 46px; box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 14px; background: #120e2b; border: 4px solid #ffcf5c; box-shadow: 0 0 0 4px #07051a, 0 0 18px rgba(255,207,92,0.45)">
              <div style="display: flex; flex-direction: column; align-items: center; gap: 4px; line-height: 1"><span style="font-family: 'Press Start 2P', monospace; font-size: 7px; color: #b9b0e0">WIT</span><span style="font-family: 'Press Start 2P', monospace; font-size: 16px; color: #ffcf5c">3</span></div>
              <div style="width: 4px; height: 24px; background: #5b4a9e"></div>
              <div style="display: flex; flex-direction: column; align-items: center; gap: 4px; line-height: 1"><span style="font-family: 'Press Start 2P', monospace; font-size: 7px; color: #b9b0e0">GRIT</span><span style="font-family: 'Press Start 2P', monospace; font-size: 16px; color: #ffcf5c">7</span></div>
            </div>

            <div style="position: absolute; left: 26px; right: 26px; top: 746px; display: flex; justify-content: space-between; font-size: 11px; line-height: 1.3; letter-spacing: 0.3px; color: #b9b0e0">
              <div style="display: flex; flex-direction: column; gap: 1px"><span>RM · 042/100 · M</span><span>RSU ▣ EN — art: claude × risu</span></div>
              <div style="display: flex; flex-direction: column; gap: 1px; align-items: flex-end"><span>© 2026 risu · random memories tcg</span><span>fictional game · not for sale</span></div>
            </div>

            <div class="foil-a"></div>
            <div class="foil-b"></div>
            <div class="foil-glitter"></div>
            <div class="foil-glare"></div>
            <div style="position: absolute; inset: 0; pointer-events: none; border-radius: 22px; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12)"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container fc-close">
    <p class="fc-note">Ported from the risu foil cards design canvas, 28 September 2026.</p>
  </div>
</BaseLayout>

<script>
  // Fit the 1000×1000 board to its stage, then let the pointer drive the
  // card's tilt, the glare and the foil offset (the canvas's onMove maths).
  const stage = document.querySelector<HTMLElement>("[data-foil-stage]");
  const board = stage?.querySelector<HTMLElement>("[data-foil-board]");
  const card = board?.querySelector<HTMLElement>("[data-foil-card]");
  if (stage && board && card) {
    const fit = () => board.style.setProperty("--s", String(stage.clientWidth / 1000));
    fit();
    if ("ResizeObserver" in window) new ResizeObserver(fit).observe(stage);
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const clamp = (v: number) => Math.max(-10, Math.min(110, v));
    const set = (rx: number, ry: number, gx: number, gy: number, hover: boolean) => {
      card.style.setProperty("--rx", `${rx.toFixed(2)}deg`);
      card.style.setProperty("--ry", `${ry.toFixed(2)}deg`);
      card.style.setProperty("--gx", `${gx.toFixed(1)}%`);
      card.style.setProperty("--gy", `${gy.toFixed(1)}%`);
      card.style.setProperty("--fx", `${(100 - gx).toFixed(1)}%`);
      card.style.setProperty("--fy", `${(100 - gy).toFixed(1)}%`);
      card.style.setProperty("--glare", hover ? "0.8" : "0.45");
    };
    board.addEventListener("pointermove", (e) => {
      const r = board.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;
      const py = (e.clientY - r.top) / r.height;
      const gx = clamp((px * 1000 - 220) / 5.6);
      const gy = clamp((py * 1000 - 109) / 7.82);
      set(still ? 0 : (0.5 - py) * 18, still ? 0 : (px - 0.5) * 22, gx, gy, true);
    });
    board.addEventListener("pointerleave", () => set(0, 0, 30, 16, false));
  }
</script>

<style is:global>
  /* the card's pixel faces, self-hosted (OFL; latin + latin-ext for Białaś) */
  @font-face {
    font-family: 'Pixelify Sans';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/dev/foil-cards/fonts/pixelify-sans-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Pixelify Sans';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/dev/foil-cards/fonts/pixelify-sans-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Press Start 2P';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/dev/foil-cards/fonts/press-start-2p-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Press Start 2P';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/dev/foil-cards/fonts/press-start-2p-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @keyframes foil-drift {
    0% { background-position: 0% 30%; }
    100% { background-position: 100% 70%; }
  }
  @keyframes foil-floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @keyframes foil-flicker {
    0%, 100% { opacity: 1; }
    40% { opacity: 0.82; }
    60% { opacity: 0.95; }
  }
</style>

<style>
  .fc-head {
    padding-block: clamp(40px, 6vw, 72px) 28px;
  }
  .fc-title {
    margin: 14px 0 16px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    line-height: 1.05;
    color: var(--color-ink);
  }
  .fc-lead {
    max-width: 58ch;
    margin: 0;
    color: var(--color-body);
  }
  .fc-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 32px;
    border-top: 1px solid var(--color-line);
  }
  .fc-h2 {
    margin: 0 0 8px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.9rem;
    color: var(--color-ink);
  }
  .fc-close {
    padding-block: 24px var(--section-padding);
  }
  .fc-note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-muted);
  }

  /* The canvas's 1000×1000 board, scaled to the stage's width by the script
     (--s); without it the board shows at full size, cropped. */
  .fc-stage {
    position: relative;
    width: min(1000px, 100%);
    aspect-ratio: 1;
    overflow: hidden;
    background: #07051a;
    border: 2px solid var(--color-ink);
  }
  .foil-board {
    --s: 1;
    position: absolute;
    left: 0;
    top: 0;
    width: 1000px;
    height: 1000px;
    overflow: hidden;
    background: #07051a;
    transform: scale(var(--s));
    transform-origin: 0 0;
    font-family: "Pixelify Sans", system-ui, sans-serif;
    color: #f4e3c1;
  }
  .foil-backdrop {
    position: absolute;
    left: -100px;
    top: -150px;
    width: 1200px;
    height: 1680px;
    max-width: none;
    filter: blur(5px) brightness(0.55) saturate(1.2);
  }
  .foil-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 50%, rgba(7, 5, 26, 0) 30%, rgba(7, 5, 26, 0.9) 100%);
  }
  .foil-float {
    position: absolute;
    left: 220px;
    top: 109px;
    width: 560px;
    height: 782px;
    animation: foil-floaty 6.5s ease-in-out infinite;
  }
  .foil-card {
    --rx: 0deg;
    --ry: 0deg;
    --gx: 30%;
    --gy: 16%;
    --fx: 70%;
    --fy: 84%;
    --glare: 0.45;
    position: relative;
    width: 560px;
    height: 782px;
    border-radius: 22px;
    overflow: hidden;
    background: #07051a;
    transform: perspective(1400px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.18s ease-out;
    box-shadow: 0 0 0 1px rgba(244, 227, 193, 0.3), 0 0 90px rgba(255, 138, 61, 0.36),
      0 0 30px rgba(255, 207, 92, 0.2), 0 40px 90px rgba(0, 0, 0, 0.7);
  }
  .foil-card img {
    max-width: none;
  }
  .foil-flicker {
    animation: foil-flicker 2.4s steps(3) infinite;
  }
  .foil-a,
  .foil-b,
  .foil-glitter,
  .foil-glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .foil-a {
    mix-blend-mode: color-dodge;
    opacity: 0.26;
    background-image: repeating-linear-gradient(115deg, #ff5d7a 0% 5%, #ffcf5c 5% 10%, #6be36b 10% 15%, #5ad6ff 15% 20%, #9a7dff 20% 25%);
    background-size: 320% 320%;
    animation: foil-drift 9s steps(24) infinite alternate;
  }
  .foil-b {
    mix-blend-mode: overlay;
    opacity: 0.36;
    background-image: linear-gradient(120deg, rgba(0, 0, 0, 0) 18%, #ff5d7a 30% 38%, #ffcf5c 38% 46%, #6be36b 46% 54%, #5ad6ff 54% 62%, #9a7dff 62% 70%, rgba(0, 0, 0, 0) 82%);
    background-size: 260% 260%;
    background-position: var(--fx) var(--fy);
    transition: background-position 0.2s ease-out;
  }
  .foil-glitter {
    mix-blend-mode: color-dodge;
    opacity: 0.3;
    background-image: url("/dev/foil-cards/glitter.svg");
    background-size: 256px 256px;
  }
  .foil-glare {
    mix-blend-mode: overlay;
    opacity: var(--glare);
    background-image: radial-gradient(circle at var(--gx) var(--gy), rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.35) 18%, rgba(255, 255, 255, 0) 42%, rgba(0, 0, 0, 0.35) 90%);
  }

  @media (prefers-reduced-motion: reduce) {
    .foil-float,
    .foil-flicker,
    .foil-a {
      animation: none;
    }
    .foil-card,
    .foil-b {
      transition: none;
    }
  }
</style>
