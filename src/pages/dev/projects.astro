---
/**
 * /dev/projects — MOCKUP (owner, 2026-09-29), parked in the /dev corner until
 * the owner comes back to it. Every builder project as a tile, in the home page's
 * bento dialect; the home Building row is the featured cut of this page.
 *
 * - A filter picker at the top: All, or one category. Without script every
 *   category shows; with it, a click hides the others and the choice lands
 *   in the URL hash (#games), so a filtered view can be linked.
 * - One section per category (measure + spectrum rule, like the home
 *   sections), tiles in a 6-column bento: each project's `span` from
 *   src/data/projects.ts. Projects with their own tile use it; the rest get
 *   the plain ProjectTile.
 *
 * Noindexed and out of the sitemap like the rest of /dev; only the /dev index
 * links here. The home page's "all projects ↗" still points at
 * github.com/risukisu.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import NexusBox from "../../components/nexus/NexusBox.astro";
import GrugTile from "../../components/nexus/GrugTile.astro";
import SkillCraftTile from "../../components/nexus/SkillCraftTile.astro";
import MarketingSkillsTile from "../../components/nexus/MarketingSkillsTile.astro";
import MarketingSkillsRepoTile from "../../components/nexus/MarketingSkillsRepoTile.astro";
import StatuslineTile from "../../components/nexus/StatuslineTile.astro";
import RoguelikeTile from "../../components/nexus/RoguelikeTile.astro";
import ProjectTile from "../../components/nexus/ProjectTile.astro";
import CiAgentTile from "../../components/nexus/CiAgentTile.astro";
import AbialasTile from "../../components/nexus/AbialasTile.astro";
import GrugManifestoTile from "../../components/nexus/GrugManifestoTile.astro";
import VanillaStatsTile from "../../components/nexus/VanillaStatsTile.astro";
import CampfireTile from "../../components/nexus/CampfireTile.astro";
import { groups, type TileKey } from "../../data/projects";
import { follow } from "../../data/nexus";

const TILES: Record<TileKey, { C: any; props?: Record<string, unknown> }> = {
  "marketing-skills": { C: MarketingSkillsTile },
  "marketing-skills-repo": { C: MarketingSkillsRepoTile },
  statusline: { C: StatuslineTile, props: { wide: true } },
  "ci-agent": { C: CiAgentTile },
  abialas: { C: AbialasTile },
  "grug-manifesto": { C: GrugManifestoTile },
  "vanilla-stats": { C: VanillaStatsTile },
  campfire: { C: CampfireTile },
  roguelike: { C: RoguelikeTile },
  skillcraft: { C: SkillCraftTile },
  blog: { C: NexusBox, props: { ...follow[0], size: "md" } },
  grug: { C: GrugTile },
};
---
<BaseLayout
  title="Projects"
  description="Everything Andrzej Białaś is building, in one place."
  noindex={true}
>
  <header class="pj-head">
    <div class="pj-head__grid blueprint" aria-hidden="true"></div>
    <div class="container pj-head__inner">
      <p class="measure">abialas.pl/dev · projects mockup</p>
      <h1 class="pj-title">Projects</h1>
      <p class="pj-lead">
        Everything I'm building, in one place. The home page shows a few of these; here is all of it,
        sorted by what it's for.
      </p>
      <div class="pj-filter" role="group" aria-label="Show projects by category" data-filter>
        <button type="button" class="pj-chip" data-cat="all" aria-pressed="true">All</button>
        {groups.map((g) => (
          <button type="button" class="pj-chip" data-cat={g.id} aria-pressed="false">{g.title}</button>
        ))}
      </div>
    </div>
  </header>

  <div class="container pj-list">
    {groups.map((g) => (
      <section class="pj-sec" id={g.id} data-sec={g.id} aria-labelledby={`h-${g.id}`}>
        <div class="pj-sec__head">
          <h2 class="measure pj-sec__title" id={`h-${g.id}`}>{g.title}</h2>
          <span class="pj-sec__rule" aria-hidden="true"></span>
          {g.note && <span class="pj-sec__note">{g.note}</span>}
        </div>
        <div class="pj-bento">
          {g.projects.map((p) => {
            const t = p.tile ? TILES[p.tile] : undefined;
            const Tile = t?.C;
            return (
              <div class={`pj-cell s${p.span}`} data-project={p.name}>
                {Tile ? <Tile {...t!.props} /> : <ProjectTile project={p} />}
              </div>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  // The filter: one category at a time, or all. The choice goes in the hash.
  const bar = document.querySelector<HTMLElement>("[data-filter]");
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-filter] [data-cat]")];
  const secs = [...document.querySelectorAll<HTMLElement>("[data-sec]")];
  const show = (cat: string, push = false) => {
    const known = cat === "all" || secs.some((s) => s.dataset.sec === cat);
    const c = known ? cat : "all";
    chips.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.cat === c)));
    secs.forEach((s) => (s.hidden = c !== "all" && s.dataset.sec !== c));
    if (push) history.replaceState(null, "", c === "all" ? location.pathname : `#${c}`);
  };
  if (bar) {
    bar.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-cat]");
      if (b) show(b.dataset.cat!, true);
    });
    show(location.hash.slice(1) || "all");
  }
</script>

<style>
  /* ── header: the drafting sheet, like the home masthead ─────────── */
  .pj-head {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 6vw, 72px) 8px;
  }
  .pj-head__grid {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 70% 90% at 30% 20%, #000 30%, transparent 75%);
    pointer-events: none;
  }
  .pj-head__inner {
    position: relative;
  }
  .pj-title {
    margin: 14px 0 18px;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.4rem, 6vw, 3.75rem);
    line-height: 1.05;
    color: var(--color-ink);
  }
  .pj-lead {
    max-width: 60ch;
    margin: 0;
    color: var(--color-body);
  }

  /* ── the filter: stickers you can press ─────────────────────────── */
  .pj-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .pj-chip {
    padding: 7px 14px;
    background: #fff;
    border: 2px solid var(--color-ink);
    box-shadow: 3px 3px 0 var(--color-ink);
    font: 500 0.95rem var(--font-sans);
    color: var(--color-ink);
    cursor: pointer;
    /* only the press moves; the colours swap at once, so the label never
       passes through grey-on-grey */
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .pj-chip:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--color-ink);
  }
  .pj-chip[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-paper);
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--color-ink);
  }
  .pj-chip:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* ── one section per category, like the home sections ───────────── */
  .pj-list {
    padding-bottom: var(--section-padding);
  }
  .pj-sec {
    padding-top: 40px;
  }
  .pj-sec[hidden] {
    display: none;
  }
  .pj-sec__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-bottom: 18px;
  }
  .pj-sec__title {
    margin: 0;
    font-weight: 400;
  }
  .pj-sec__rule {
    flex: 1;
    min-width: 60px;
    height: 3px;
    background: var(--gradient-spectrum);
  }
  .pj-sec__note {
    flex-basis: 100%;
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  /* the bento: 6 columns; each tile spans what its data says */
  .pj-bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 18px;
    align-items: stretch;
    padding-right: 6px; /* hover-shadow room */
  }
  .pj-cell {
    display: grid;
    min-width: 0;
  }
  .pj-cell > :global(*) {
    min-width: 0;
  }
  .s2 { grid-column: span 2; }
  .s3 { grid-column: span 3; }
  .s4 { grid-column: span 4; }
  .s6 { grid-column: span 6; }

  @media (max-width: 1080px) {
    .pj-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .s2,
    .s3 { grid-column: span 1; }
    .s4,
    .s6 { grid-column: span 2; }
  }
  @media (max-width: 720px) {
    .pj-bento {
      grid-template-columns: minmax(0, 1fr);
    }
    .s2,
    .s3,
    .s4,
    .s6 { grid-column: span 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pj-chip,
    .pj-chip:hover,
    .pj-chip[aria-pressed="true"] {
      transform: none;
      transition: none;
    }
  }
</style>
